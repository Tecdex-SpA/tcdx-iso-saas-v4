      standard_code: standardCode,
      operation_id: operationId
    });

    const pendingResult = await client.query(
      `
      SELECT req.*
      FROM standard_lifecycle_stage_requests req
      JOIN tenant_standard_operations tso
        ON tso.tenant_id = req.tenant_id
       AND tso.standard_code = req.standard_code
       AND tso.operation_id = req.operation_id
       AND tso.is_active = TRUE
      JOIN tenant_standards ts
        ON ts.tenant_id = req.tenant_id
       AND ts.standard_code = req.standard_code
       AND ts.is_active = TRUE
      JOIN tenant_operations op
        ON op.id = req.operation_id
       AND op.tenant_id = req.tenant_id
       AND op.is_active = TRUE
      WHERE req.tenant_id = $1
        AND req.request_status = 'por_confirmar'
        ${standardCode ? `AND req.standard_code = $2` : ''}
        ${operationId ? `AND req.operation_id = $${standardCode ? 3 : 2}` : ''}
      ORDER BY req.requested_at DESC
      LIMIT 50
      `,
      [
        tenant_id,
        ...(standardCode ? [standardCode] : []),
        ...(operationId ? [operationId] : [])
      ]
    );

    const feedRows = await getActiveLifecycleFeedRows(client, tenant_id, {
      standard_code: standardCode,
      operation_id: operationId,
      limit: 100,
      asc: false
    });

    return res.json({
      ok: true,
      tenant_id,
      filters: {
        standard_code: standardCode,
        operation_id: operationId
      },
      executive_summary: buildBoardSummary(statusRows),
      ai_summary: buildBoardAiSummary(statusRows, {
        standard_code: standardCode,
        operation_id: operationId
      }),
      lifecycle_cards: statusRows.map((row) => ({
        standard_code: row.standard_code,
        operation_id: row.operation_id,
        operation_name: row.operation_name,
        operation_code: row.operation_code,
        operation_type: row.operation_type,
        calculated_stage_code: row.calculated_stage_code,
        confirmed_stage_code: row.confirmed_stage_code,
        effective_stage_code: row.effective_stage_code,
        pending_stage_code: row.pending_stage_code,
        health_status: row.health_status,
        maturity_score: Number(row.maturity_score || 0),
        controls_enabled: Number(row.enabled_controls_count || 0),
        controls_catalog: Number(row.catalog_controls_count || 0),
        evidence_coverage_pct: Number(row.evidence_coverage_pct || 0),
        avg_health_score: Number(row.avg_health_score || 0),
        open_nonconformities: Number(row.open_nonconformities_count || 0),
        open_findings: Number(row.open_findings_count || 0),
        open_action_plans: Number(row.open_action_plans_count || 0),
        open_audits: Number(row.open_audits_count || 0),
        updated_at: row.updated_at,
        metrics_json: row.metrics_json || {},
        ai_insight: buildCardAiInsight(row)
      })),
      pending_requests: pendingResult.rows,
      recent_events: feedRows
    });
  } catch (err) {
    console.error('ERROR GET LIFECYCLE AI CONTEXT:', err);
    return res.status(500).json({
      error: 'Error obteniendo contexto IA del ciclo de vida',
      detail: err.message
    });
  } finally {
    client.release();
  }
});

router.post('/request-move', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const {
      tenant_id,
      standard_code,
      operation_id,
      to_stage_code,
      request_reason
    } = req.body;

    if (!tenant_id || !standard_code || !operation_id || !to_stage_code) {
      return res.status(400).json({
        error: 'tenant_id, standard_code, operation_id y to_stage_code son obligatorios'
      });
    }

    if (!canRequestLifecycleChange(req, tenant_id)) {
      return res.status(403).json({ error: 'No autorizado para solicitar cambios' });
    }

    await client.query('BEGIN');

    const activePair = await client.query(
      `
      SELECT
        tso.tenant_id,
        tso.standard_code,
        tso.operation_id,
        op.name AS operation_name,
        op.code AS operation_code,
        op.operation_type,
        ts.catalog_mode
      FROM tenant_standard_operations tso
      JOIN tenant_operations op
        ON op.id = tso.operation_id
       AND op.tenant_id = tso.tenant_id
       AND op.is_active = TRUE
      JOIN tenant_standards ts
        ON ts.tenant_id = tso.tenant_id
       AND ts.standard_code = tso.standard_code
       AND ts.is_active = TRUE
      WHERE tso.tenant_id = $1
        AND tso.standard_code = $2
        AND tso.operation_id = $3
        AND tso.is_active = TRUE
      LIMIT 1
      `,
      [tenant_id, standard_code, operation_id]
    );

    if (activePair.rowCount === 0) {
      throw new Error('La norma/operación no está activa o ya no forma parte del alcance contratado.');
    }

    const statusResult = await client.query(
      `
      SELECT *
      FROM standard_lifecycle_status
      WHERE tenant_id = $1
        AND standard_code = $2
        AND operation_id = $3
      LIMIT 1
      `,
      [tenant_id, standard_code, operation_id]
    );

    if (statusResult.rowCount === 0) {
      await rebuildLifecycle(client, tenant_id, {
        standard_code,
        operation_id
      });
    }

    const refreshed = await client.query(
      `
      SELECT *
      FROM standard_lifecycle_status
      WHERE tenant_id = $1
        AND standard_code = $2
        AND operation_id = $3
      LIMIT 1
      `,
      [tenant_id, standard_code, operation_id]
    );

    if (refreshed.rowCount === 0) {
      throw new Error('No fue posible inicializar la tarjeta de ciclo de vida.');
    }

    const status = refreshed.rows[0];
    const fromStage = status.effective_stage_code;

    if (fromStage === to_stage_code) {
      await client.query('ROLLBACK');
      return res.status(400).json({
        error: 'La tarjeta ya está en esa etapa.'
      });
    }

    if (status.pending_request_id) {
      await client.query('ROLLBACK');
      return res.status(409).json({
        error: 'La tarjeta ya tiene un movimiento pendiente de confirmación.'
      });
    }

    const requestInsert = await client.query(
      `
      INSERT INTO standard_lifecycle_stage_requests (
        tenant_id,
        standard_code,
        operation_id,
        from_stage_code,
        to_stage_code,
        request_status,
        request_source,
        request_reason,
        requested_by,
        requested_at
      )
      VALUES ($1,$2,$3,$4,$5,'por_confirmar','manual_drag',$6,$7,NOW())
      RETURNING *
      `,
      [
        tenant_id,
        standard_code,
        operation_id,
        fromStage,
        to_stage_code,
        request_reason || null,
        getUserId(req.user)
      ]
    );

    const requestRow = requestInsert.rows[0];

    const updatedStatus = await client.query(
      `
      UPDATE standard_lifecycle_status
      SET
        pending_stage_code = $4,
        pending_request_id = $5,
        pending_requested_by = $6,
        pending_requested_at = NOW(),
        effective_stage_code = $4,
        updated_at = NOW()
      WHERE tenant_id = $1
        AND standard_code = $2
        AND operation_id = $3
      RETURNING *
      `,
      [
        tenant_id,
        standard_code,
        operation_id,
        to_stage_code,
        requestRow.id,
        getUserId(req.user)
      ]
    );

    const enrichedStatus = {
      ...updatedStatus.rows[0],
      operation_name: activePair.rows[0].operation_name,
      operation_code: activePair.rows[0].operation_code,
      operation_type: activePair.rows[0].operation_type,
      catalog_mode: activePair.rows[0].catalog_mode
    };

    await pushAiFeed(
      client,
      tenant_id,
      standard_code,
      operation_id,
      'lifecycle_stage_request',
      `Se solicitó mover ${standard_code} / ${activePair.rows[0].operation_name} desde ${stageNameFromCode(fromStage)} hacia ${stageNameFromCode(to_stage_code)}. Pendiente de confirmación del auditor.`,
      {
        source: 'lifecycle_stage_request',
        request: requestRow,
        current_status: enrichedStatus,
        ai_insight: buildCardAiInsight(enrichedStatus)
      }
    );

    await client.query('COMMIT');

    return res.json({
      ok: true,
      request: requestRow,
      status: enrichedStatus
    });
  } catch (err) {
    await client.query('ROLLBACK');
    console.error('ERROR REQUEST LIFECYCLE MOVE:', err);
    return res.status(500).json({
      error: 'Error solicitando cambio de etapa',
      detail: err.message
    });
  } finally {
    client.release();
  }
});

router.post('/requests/:request_id/review', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const { request_id } = req.params;
    const { review_action, review_comment } = req.body;

    if (!['confirmar', 'rechazar'].includes(String(review_action || ''))) {
      return res.status(400).json({
        error: 'review_action debe ser confirmar o rechazar'
      });
    }

    await client.query('BEGIN');

    const requestResult = await client.query(
      `
      SELECT *
      FROM standard_lifecycle_stage_requests
      WHERE id = $1
      LIMIT 1
      `,
      [request_id]
    );

    if (requestResult.rowCount === 0) {
      throw new Error('Solicitud no encontrada');
    }

    const requestRow = requestResult.rows[0];

    if (!canReviewLifecycleChange(req, requestRow.tenant_id)) {
      await client.query('ROLLBACK');
      return res.status(403).json({ error: 'No autorizado para revisar solicitudes' });
    }

    if (requestRow.request_status !== 'por_confirmar') {
      await client.query('ROLLBACK');
      return res.status(409).json({
        error: 'La solicitud ya fue revisada.'
      });
    }

    const activePair = await client.query(
      `
      SELECT
        tso.tenant_id,
        tso.standard_code,
        tso.operation_id,
        op.name AS operation_name,
        op.code AS operation_code,
        op.operation_type,
        ts.catalog_mode
      FROM tenant_standard_operations tso
      JOIN tenant_operations op
        ON op.id = tso.operation_id
       AND op.tenant_id = tso.tenant_id
       AND op.is_active = TRUE
      JOIN tenant_standards ts
        ON ts.tenant_id = tso.tenant_id
       AND ts.standard_code = tso.standard_code
       AND ts.is_active = TRUE
      WHERE tso.tenant_id = $1
        AND tso.standard_code = $2
        AND tso.operation_id = $3
        AND tso.is_active = TRUE
      LIMIT 1
      `,
      [requestRow.tenant_id, requestRow.standard_code, requestRow.operation_id]
    );

    const nextRequestStatus = review_action === 'confirmar' ? 'confirmado' : 'rechazado';

    const reviewed = await client.query(
      `
      UPDATE standard_lifecycle_stage_requests
      SET
        request_status = $2,
        reviewed_by = $3,
        reviewed_at = NOW(),
        review_comment = $4,
        updated_at = NOW()
      WHERE id = $1
      RETURNING *
      `,
      [
        request_id,
        nextRequestStatus,
        getUserId(req.user),
        review_comment || null
      ]
    );

    let statusUpdate = null;

    if (review_action === 'confirmar') {
      statusUpdate = await client.query(
        `
        UPDATE standard_lifecycle_status
        SET
          confirmed_stage_code = $4,
          effective_stage_code = $4,
          pending_stage_code = NULL,
          pending_request_id = NULL,
          pending_requested_by = NULL,
          pending_requested_at = NULL,
          updated_at = NOW()
        WHERE tenant_id = $1
          AND standard_code = $2
          AND operation_id = $3
        RETURNING *
        `,
        [
          requestRow.tenant_id,
          requestRow.standard_code,
          requestRow.operation_id,
          requestRow.to_stage_code
        ]
      );
    } else {
      statusUpdate = await client.query(
        `
        UPDATE standard_lifecycle_status
        SET
          effective_stage_code = confirmed_stage_code,
          pending_stage_code = NULL,
          pending_request_id = NULL,
          pending_requested_by = NULL,
          pending_requested_at = NULL,
          updated_at = NOW()
        WHERE tenant_id = $1
          AND standard_code = $2
          AND operation_id = $3
        RETURNING *
        `,
        [
          requestRow.tenant_id,
          requestRow.standard_code,
          requestRow.operation_id
        ]
      );
    }

    const enrichedStatus = statusUpdate.rows[0]
      ? {
          ...statusUpdate.rows[0],
          operation_name: activePair.rows[0]?.operation_name || null,
          operation_code: activePair.rows[0]?.operation_code || null,
          operation_type: activePair.rows[0]?.operation_type || null,
          catalog_mode: activePair.rows[0]?.catalog_mode || null
        }
      : null;

    await pushAiFeed(
      client,
      requestRow.tenant_id,
      requestRow.standard_code,
      requestRow.operation_id,
      'lifecycle_stage_review',
      review_action === 'confirmar'
        ? `El auditor confirmó el cambio de etapa hacia ${stageNameFromCode(requestRow.to_stage_code)}.`
        : `El auditor rechazó el cambio de etapa hacia ${stageNameFromCode(requestRow.to_stage_code)}.`,
      {
        source: 'lifecycle_stage_review',
        review: reviewed.rows[0],
        resulting_status: enrichedStatus,
        ai_insight: enrichedStatus ? buildCardAiInsight(enrichedStatus) : null
      }
    );

    await client.query('COMMIT');

    return res.json({
      ok: true,
      request: reviewed.rows[0],
      status: enrichedStatus
    });
  } catch (err) {
    await client.query('ROLLBACK');
    console.error('ERROR REVIEW LIFECYCLE REQUEST:', err);
    return res.status(500).json({
      error: 'Error revisando solicitud',
      detail: err.message
    });
  } finally {
    client.release();
  }
});

