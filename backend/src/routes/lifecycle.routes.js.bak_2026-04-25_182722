const STAGE_CATALOG = [
  { code: 'diagnostico', name: 'Diagnóstico', sort_order: 10 },
  { code: 'diseno_planificacion', name: 'Diseño / Planificación', sort_order: 20 },
  { code: 'implementacion', name: 'Implementación', sort_order: 30 },
  { code: 'verificacion_auditoria', name: 'Verificación / Auditoría', sort_order: 40 },
  { code: 'certificacion', name: 'Certificación', sort_order: 50 },
  { code: 'mejora_continua', name: 'Mejora Continua', sort_order: 60 },
  { code: 'suspendida_fuera_alcance', name: 'Suspendida / Fuera de alcance', sort_order: 70 }
];

const auditsColumnsCache = {
  loaded: false,
  columns: new Set()
};

function normalizeRole(role) {
  return String(role || '').toLowerCase().trim();
}

function getUserTenantId(user) {
  return (
    user?.tenant_id ||
    user?.tenantId ||
    user?.tenant ||
    user?.company_id ||
    user?.companyId ||
    null
  );
}

function getUserId(user) {
  return user?.user_id || user?.userId || user?.id || null;
}

function isSuperAdmin(req) {
  const role = normalizeRole(req.user?.role || req.user?.user_role || req.user?.userRole);
  return [
    'superadmin',
    'super_admin',
    'platform_admin',
    'admin_global',
    'global_admin',
    'owner'
  ].includes(role);
}

function isAuditor(req) {
  const role = normalizeRole(req.user?.role || req.user?.user_role || req.user?.userRole);
  return role === 'auditor';
}

function canAccessTenant(req, tenantId) {
  if (isSuperAdmin(req)) return true;
  return String(getUserTenantId(req.user) || '') === String(tenantId || '');
}

function canRequestLifecycleChange(req, tenantId) {
  if (!canAccessTenant(req, tenantId)) return false;
  if (isAuditor(req)) return false;
  return true;
}

function canReviewLifecycleChange(req, tenantId) {
  if (isSuperAdmin(req)) return true;
  return canAccessTenant(req, tenantId) && isAuditor(req);
}

function pct(part, total) {
  if (!total || Number(total) <= 0) return 0;
  return Number(((Number(part || 0) / Number(total)) * 100).toFixed(2));
}

function clamp(value, min = 0, max = 100) {
  return Math.max(min, Math.min(max, Number(value || 0)));
}

function stageNameFromCode(code) {
  return STAGE_CATALOG.find((s) => s.code === code)?.name || code || 'Sin etapa';
}

function deriveHealthStatus(avgHealthScore, openNC, openFindings, openPlans) {
  const score = Number(avgHealthScore || 0);
  const burden = Number(openNC || 0) + Number(openFindings || 0) + Number(openPlans || 0);

  if (score >= 80 && burden <= 2) return 'saludable';
  if (score < 50 || burden >= 6) return 'deteriorado';
  return 'atencion';
}

function deriveCalculatedStage(metrics) {
  const enabled = Number(metrics.enabled_controls_count || 0);
  const evidencePct = Number(metrics.evidence_coverage_pct || 0);
  const health = Number(metrics.avg_health_score || 0);
  const openNC = Number(metrics.open_nonconformities_count || 0);
  const openFindings = Number(metrics.open_findings_count || 0);
  const openAudits = Number(metrics.open_audits_count || 0);
  const enabledPct = Number(metrics.controls_enabled_pct || 0);

  if (metrics.is_scope_inactive) return 'suspendida_fuera_alcance';
  if (enabled === 0) return 'diagnostico';
  if (enabledPct < 40 || evidencePct < 15) return 'diseno_planificacion';
  if (evidencePct < 55 || health < 70) return 'implementacion';
  if (openAudits > 0 || openNC > 0 || openFindings > 0) return 'verificacion_auditoria';
  if (health >= 85 && evidencePct >= 70) return 'certificacion';
  if (health >= 90 && evidencePct >= 85 && openNC === 0 && openFindings === 0) return 'mejora_continua';

  return 'implementacion';
}

function deriveMaturityScore(metrics) {
  const enabledPct = Number(metrics.controls_enabled_pct || 0);
  const evidencePct = Number(metrics.evidence_coverage_pct || 0);
  const avgHealth = Number(metrics.avg_health_score || 0);
  const openNC = Number(metrics.open_nonconformities_count || 0);
  const openFindings = Number(metrics.open_findings_count || 0);
  const openPlans = Number(metrics.open_action_plans_count || 0);
  const openAudits = Number(metrics.open_audits_count || 0);

  const controlsComponent = clamp(enabledPct) * 0.25;
  const evidenceComponent = clamp(evidencePct) * 0.25;
  const healthComponent = clamp(avgHealth) * 0.20;

  const actionsPenaltyBase = Math.min(openPlans * 5, 20);
  const issuesPenaltyBase = Math.min((openNC * 8) + (openFindings * 5), 25);
  const auditSignal = openAudits > 0 ? 5 : 10;

  const raw =
    controlsComponent +
    evidenceComponent +
    healthComponent +
    (20 - actionsPenaltyBase) * 0.10 +
    (25 - issuesPenaltyBase) * 0.10 +
    auditSignal;

  return Number(clamp(raw).toFixed(2));
}

function deriveTrend(previousSnapshot, currentScore) {
  if (!previousSnapshot) return 'estable';
  const prev = Number(previousSnapshot.maturity_score || 0);
  const curr = Number(currentScore || 0);
  if (curr >= prev + 5) return 'sube';
  if (curr <= prev - 5) return 'baja';
  return 'estable';
}

function buildExecutiveSummary(status) {
  return {
    stage: stageNameFromCode(status.effective_stage_code),
    health_status: status.health_status,
    maturity_score: Number(status.maturity_score || 0),
    controls_enabled: Number(status.enabled_controls_count || 0),
    controls_catalog: Number(status.catalog_controls_count || 0),
    evidence_coverage_pct: Number(status.evidence_coverage_pct || 0),
    avg_health_score: Number(status.avg_health_score || 0),
    open_nonconformities: Number(status.open_nonconformities_count || 0),
    open_findings: Number(status.open_findings_count || 0),
    open_action_plans: Number(status.open_action_plans_count || 0),
    open_audits: Number(status.open_audits_count || 0),
    pending_confirmation: Boolean(status.pending_stage_code),
    last_activity_at: status.last_activity_at || null
  };
}

function buildLifecycleNarrative(pair, status, previousSnapshot = null) {
  const trend = deriveTrend(previousSnapshot, status.maturity_score);

  return [
    `Norma ${pair.standard_code} en operación ${pair.operation_name}.`,
    `Etapa calculada: ${stageNameFromCode(status.calculated_stage_code)}.`,
    `Etapa confirmada: ${stageNameFromCode(status.confirmed_stage_code || status.calculated_stage_code)}.`,
    `Etapa efectiva: ${stageNameFromCode(status.effective_stage_code)}.`,
    `Salud: ${status.health_status}.`,
    `Madurez: ${status.maturity_score}.`,
    `Tendencia: ${trend}.`,
    `Controles habilitados: ${status.enabled_controls_count}/${status.catalog_controls_count}.`,
    `Cobertura evidencia: ${status.evidence_coverage_pct}%.`,
    `Health promedio: ${status.avg_health_score}.`,
    `No conformidades abiertas: ${status.open_nonconformities_count}.`,
    `Hallazgos abiertos: ${status.open_findings_count}.`,
    `Planes abiertos: ${status.open_action_plans_count}.`,
    `Auditorías abiertas: ${status.open_audits_count}.`
  ].join(' ');
}

function computeAttentionScore(row) {
  const healthPenalty = 100 - Number(row.avg_health_score || 0);
  const evidencePenalty = 100 - Number(row.evidence_coverage_pct || 0);
  const controlsPenalty = 100 - Number(row.controls_enabled_pct || 0);
  const ncWeight = Number(row.open_nonconformities_count || 0) * 12;
  const findingWeight = Number(row.open_findings_count || 0) * 8;
  const planWeight = Number(row.open_action_plans_count || 0) * 5;
  const auditWeight = Number(row.open_audits_count || 0) * 6;
  const pendingWeight = row.pending_stage_code ? 7 : 0;

  return Number(
    (
      healthPenalty * 0.8 +
      evidencePenalty * 0.5 +
      controlsPenalty * 0.3 +
      ncWeight +
      findingWeight +
      planWeight +
      auditWeight +
      pendingWeight
    ).toFixed(2)
  );
}

function buildCardAiInsight(row) {
  const displayStage = row.pending_stage_code || row.effective_stage_code || row.calculated_stage_code;
  const stageName = stageNameFromCode(displayStage);
  const risks = [];
  const next_steps = [];

  if (Number(row.open_nonconformities_count || 0) > 0) {
    risks.push(
      `${row.open_nonconformities_count} no conformidad(es) abierta(s) siguen empujando la norma hacia verificación/auditoría.`
    );
    next_steps.push('Cerrar o contener las no conformidades abiertas con plan y evidencia aprobada.');
  }

  if (Number(row.open_findings_count || 0) > 0) {
    risks.push(
      `${row.open_findings_count} hallazgo(s) abierto(s) siguen impactando la salud del estándar.`
    );
    next_steps.push('Resolver hallazgos pendientes y vincular evidencias de cierre.');
  }

  if (Number(row.evidence_coverage_pct || 0) < 60) {
    risks.push(
      `La cobertura de evidencia está en ${Number(row.evidence_coverage_pct || 0).toFixed(0)}%, por debajo del nivel recomendable.`
    );
    next_steps.push('Subir y aprobar evidencias faltantes en los controles críticos.');
  }

  if (Number(row.controls_enabled_pct || 0) < 70) {
    risks.push(
      `Solo ${Number(row.controls_enabled_pct || 0).toFixed(0)}% de los controles del catálogo están habilitados en esta operación.`
    );
    next_steps.push('Completar habilitación de controles aplicables por operación.');
  }

  if (Number(row.avg_health_score || 0) < 70) {
    risks.push(`El health score promedio está en ${Number(row.avg_health_score || 0).toFixed(0)}.`);
    next_steps.push('Priorizar controles deteriorados o en atención antes de avanzar de etapa.');
  }

  if (row.pending_stage_code) {
    risks.push(
      `Existe un movimiento pendiente de confirmación hacia ${stageNameFromCode(row.pending_stage_code)}.`
    );
    next_steps.push('Solicitar revisión del auditor para confirmar o rechazar el cambio pendiente.');
  }

  if (Number(row.open_audits_count || 0) > 0) {
    risks.push(`${row.open_audits_count} auditoría(s) abierta(s) aún requieren seguimiento.`);
    next_steps.push('Cerrar auditorías abiertas y registrar sus resultados en el ciclo de vida.');
  }

  if (risks.length === 0) {
    risks.push('No se observan alertas críticas inmediatas en esta tarjeta.');
  }

  if (next_steps.length === 0) {
    if (displayStage === 'certificacion') {
      next_steps.push('Sostener evidencia, auditoría y disciplina operativa para consolidar certificación.');
    } else if (displayStage === 'mejora_continua') {
      next_steps.push('Mantener monitoreo, refrescar evidencias y capturar oportunidades de mejora.');
    } else {
      next_steps.push('Mantener el ritmo de avance y validar periódicamente salud, evidencia y auditoría.');
    }
  }

  const headline =
    row.health_status === 'saludable'
      ? `${row.standard_code} / ${row.operation_name} mantiene un estado sólido en ${stageName}.`
      : row.health_status === 'deteriorado'
      ? `${row.standard_code} / ${row.operation_name} requiere intervención prioritaria en ${stageName}.`
      : `${row.standard_code} / ${row.operation_name} se encuentra en vigilancia en ${stageName}.`;

  const narrative = [
    `${row.standard_code} en ${row.operation_name} se encuentra en ${stageName}.`,
    `La salud actual es ${row.health_status} con una madurez de ${Number(row.maturity_score || 0).toFixed(0)}%.`,
    `La cobertura de evidencia alcanza ${Number(row.evidence_coverage_pct || 0).toFixed(0)}% y el health score promedio es ${Number(row.avg_health_score || 0).toFixed(0)}.`,
    `Existen ${Number(row.open_nonconformities_count || 0)} NC, ${Number(row.open_findings_count || 0)} hallazgo(s), ${Number(row.open_action_plans_count || 0)} plan(es) abierto(s) y ${Number(row.open_audits_count || 0)} auditoría(s) abiertas.`
  ].join(' ');

  return {
    headline,
    narrative,
    risks,
    next_steps: Array.from(new Set(next_steps)).slice(0, 5),
    attention_score: computeAttentionScore(row),
    display_stage_code: displayStage,
    display_stage_name: stageName
  };
}

function buildBoardAiSummary(rows, filters = {}) {
  const summary = buildBoardSummary(rows);
  const activeCards = rows.map((row) => ({
    ...row,
    ai_insight: buildCardAiInsight(row)
  }));

  const topRisks = [...activeCards]
    .sort((a, b) => b.ai_insight.attention_score - a.ai_insight.attention_score)
    .slice(0, 3);

  const weakestStage = STAGE_CATALOG.map((stage) => {
    const items = rows.filter(
      (row) => (row.pending_stage_code || row.effective_stage_code) === stage.code
    );
    const avgHealth = items.length
      ? items.reduce((acc, item) => acc + Number(item.avg_health_score || 0), 0) / items.length
      : 0;

    return {
      stage_code: stage.code,
      stage_name: stage.name,
      total: items.length,
      avg_health_score: Number(avgHealth.toFixed(2))
    };
  })
    .filter((item) => item.total > 0)
    .sort((a, b) => a.avg_health_score - b.avg_health_score)[0] || null;

  const contractedStandards = [...new Set(rows.map((row) => row.standard_code))];
  const contractedOperations = [...new Set(rows.map((row) => row.operation_name))];

  const headline =
    rows.length === 0
      ? 'No existen tarjetas activas de ciclo de vida para los filtros seleccionados.'
      : filters.standard_code && filters.operation_id
      ? `La operación filtrada presenta ${summary.total_cards} tarjeta(s) activas de ciclo de vida para ${filters.standard_code}.`
      : filters.standard_code
      ? `La norma ${filters.standard_code} mantiene ${summary.total_cards} tarjeta(s) activas dentro del ciclo de vida.`
      : `El tenant mantiene ${summary.total_cards} tarjeta(s) activas en el tablero multinorma de ciclo de vida.`;

  const narrativeParts = [];

  if (rows.length > 0) {
    narrativeParts.push(
      `Hay ${summary.healthy_cards} tarjeta(s) saludables, ${summary.attention_cards} en atención y ${summary.deteriorated_cards} deterioradas.`
    );
    narrativeParts.push(`La madurez promedio consolidada es ${Number(summary.avg_maturity_score || 0).toFixed(0)}%.`);
    narrativeParts.push(
      `Se registran ${summary.open_nonconformities} no conformidades, ${summary.open_findings} hallazgos, ${summary.open_action_plans} planes abiertos y ${summary.open_audits} auditorías abiertas.`
    );

    if (weakestStage) {
      narrativeParts.push(
        `La etapa más frágil hoy es ${weakestStage.stage_name} con health promedio ${Number(
          weakestStage.avg_health_score || 0
        ).toFixed(0)}.`
      );
    }

    if (summary.pending_cards > 0) {
      narrativeParts.push(`Existen ${summary.pending_cards} movimiento(s) pendiente(s) de validación del auditor.`);
    }
  }

  const next_steps = [];
  if (summary.deteriorated_cards > 0) {
    next_steps.push('Atacar primero las tarjetas deterioradas y cerrar hallazgos/no conformidades abiertas.');
  }
  if (summary.open_nonconformities > 0 || summary.open_findings > 0) {
    next_steps.push('Usar el panel para bajar pendientes de verificación antes de intentar certificación.');
  }
  if (summary.pending_cards > 0) {
    next_steps.push('Resolver de inmediato las solicitudes pendientes del auditor para no congelar el avance.');
  }
  if (summary.avg_maturity_score < 75) {
    next_steps.push('Aumentar cobertura de evidencia y activación de controles en operaciones con menor madurez.');
  }
  if (next_steps.length === 0 && rows.length > 0) {
    next_steps.push('Mantener disciplina de evidencia, auditoría y mejora continua para sostener el avance.');
  }

  return {
    headline,
    narrative: narrativeParts.join(' '),
    contracted_standards: contractedStandards,
    contracted_operations: contractedOperations,
    weakest_stage: weakestStage,
    top_risks: topRisks.map((item) => ({
      standard_code: item.standard_code,
      operation_id: item.operation_id,
      operation_name: item.operation_name,
      health_status: item.health_status,
      display_stage_code: item.pending_stage_code || item.effective_stage_code,
      display_stage_name: stageNameFromCode(item.pending_stage_code || item.effective_stage_code),
      attention_score: item.ai_insight.attention_score,
      headline: item.ai_insight.headline,
      narrative: item.ai_insight.narrative,
      risks: item.ai_insight.risks,
      next_steps: item.ai_insight.next_steps
    })),
    next_steps: Array.from(new Set(next_steps)).slice(0, 5),
    executive_summary: summary
  };
}

async function pushAiFeed(client, tenantId, standardCode, operationId, eventType, contentText, payload) {
  await client.query(
    `
    INSERT INTO standard_lifecycle_ai_feed (
      tenant_id,
      standard_code,
      operation_id,
      event_type,
      content_text,
      payload
    )
    VALUES ($1,$2,$3,$4,$5,$6::jsonb)
    `,
    [
      tenantId,
      standardCode,
      operationId,
      eventType,
      contentText,
      JSON.stringify(payload || {})
    ]
  );
}

async function ensureAuditsColumns(client) {
  if (auditsColumnsCache.loaded) {
    return auditsColumnsCache.columns;
  }

  const result = await client.query(
    `
    SELECT column_name
    FROM information_schema.columns
    WHERE table_schema = 'public'
      AND table_name = 'audits'
    `
  );

  auditsColumnsCache.columns = new Set(result.rows.map((r) => r.column_name));
  auditsColumnsCache.loaded = true;
  return auditsColumnsCache.columns;
}

async function getOperationStandardPairs(client, tenantId, standardCode = null, operationId = null) {
  const params = [tenantId];
  let sql = `
    SELECT
      tso.tenant_id,
      tso.standard_code,
      tso.operation_id,
      op.name AS operation_name,
      op.code AS operation_code,
      op.operation_type,
      op.is_active AS operation_is_active,
      ts.is_active AS standard_is_active,
      ts.catalog_mode
    FROM tenant_standard_operations tso
    JOIN tenant_operations op
      ON op.id = tso.operation_id
     AND op.tenant_id = tso.tenant_id
    JOIN tenant_standards ts
      ON ts.tenant_id = tso.tenant_id
     AND ts.standard_code = tso.standard_code
    WHERE tso.tenant_id = $1
      AND tso.is_active = TRUE
      AND op.is_active = TRUE
      AND ts.is_active = TRUE
  `;

  if (standardCode) {
    params.push(standardCode);
    sql += ` AND tso.standard_code = $${params.length} `;
  }

  if (operationId) {
    params.push(operationId);
    sql += ` AND tso.operation_id = $${params.length} `;
  }

  sql += ` ORDER BY tso.standard_code, op.sort_order, op.name `;

  const result = await client.query(sql, params);
  return result.rows;
}

async function getAuditMetrics(client, tenantId, standardCode) {
  const columns = await ensureAuditsColumns(client);

  let where = `a.tenant_id = $1`;
  const params = [tenantId];

  if (columns.has('iso_code')) {
    params.push(standardCode);
    where += ` AND a.iso_code = $${params.length}`;
  } else if (columns.has('iso')) {
    params.push(standardCode);
    where += ` AND a.iso = $${params.length}`;
  } else if (columns.has('standard_code')) {
    params.push(standardCode);
    where += ` AND a.standard_code = $${params.length}`;
  } else if (columns.has('standard')) {
    params.push(standardCode);
    where += ` AND a.standard = $${params.length}`;
  }

  if (columns.has('status')) {
    where += ` AND LOWER(COALESCE(a.status, '')) NOT IN ('cerrada', 'cerrado', 'finalizada', 'finalizado')`;
  }

  let lastDateExpr = `'1970-01-01'::timestamp`;
  if (columns.has('updated_at')) {
    lastDateExpr = `MAX(COALESCE(a.updated_at, a.created_at))`;
  } else if (columns.has('created_at')) {
    lastDateExpr = `MAX(a.created_at)`;
  } else if (columns.has('date')) {
    lastDateExpr = `MAX(a.date::timestamp)`;
  }

  const sql = `
    SELECT
      COUNT(*)::int AS open_audits_count,
      ${lastDateExpr} AS last_audit_at
    FROM audits a
    WHERE ${where}
  `;

  const result = await client.query(sql, params);
  return result.rows[0] || { open_audits_count: 0, last_audit_at: null };
}

async function getMetricsForPair(client, tenantId, standardCode, operationId) {
  const auditMetrics = await getAuditMetrics(client, tenantId, standardCode);

  const result = await client.query(
    `
    WITH catalog_controls AS (
      SELECT DISTINCT cc.id
      FROM controls_catalog cc
      WHERE cc.is_active = TRUE
        AND (
          cc.iso = $2
          OR EXISTS (
            SELECT 1
            FROM controls_catalog_standards ccs
            WHERE ccs.control_id = cc.id
              AND ccs.standard_code = $2
          )
        )
    ),
    enabled_controls AS (
      SELECT
        tc.id AS tenant_control_id,
        tc.control_id,
        tc.updated_at
      FROM tenant_controls tc
      JOIN controls_catalog cc
        ON cc.id = tc.control_id
      WHERE tc.tenant_id = $1
        AND tc.operation_id = $3
        AND cc.is_active = TRUE
        AND (
          cc.iso = $2
          OR EXISTS (
            SELECT 1
            FROM controls_catalog_standards ccs
            WHERE ccs.control_id = cc.id
              AND ccs.standard_code = $2
          )
        )
    ),
    evidence_per_control AS (
      SELECT
        ec.tenant_control_id,
        COUNT(e.id)::int AS evidence_count,
        MAX(e.created_at) AS last_evidence_at
      FROM enabled_controls ec
      LEFT JOIN evidences e
        ON e.tenant_id = $1
       AND (
            e.tenant_control_id = ec.tenant_control_id
            OR e.control_id = ec.control_id
       )
       AND COALESCE(e.status, '') <> 'deleted'
      GROUP BY ec.tenant_control_id
    ),
    latest_health AS (
      SELECT DISTINCT ON (chs.tenant_control_id)
        chs.tenant_control_id,
        COALESCE(chs.health_score, 0) AS health_score
      FROM control_health_scores chs
      WHERE chs.tenant_id = $1
        AND chs.standard_code = $2
      ORDER BY chs.tenant_control_id, chs.calculated_at DESC NULLS LAST
    ),
    nc_std AS (
      SELECT COUNT(*)::int AS open_nonconformities_count,
             MAX(tnc.detected_at) AS last_nc_at
      FROM tenant_nonconformities tnc
      WHERE tnc.tenant_id = $1
        AND tnc.control_id IN (SELECT control_id FROM enabled_controls)
        AND (
          tnc.resolved_at IS NULL
          OR LOWER(COALESCE(tnc.status, '')) <> 'resuelta'
        )
    ),
    findings_std AS (
      SELECT COUNT(*)::int AS open_findings_count,
             MAX(COALESCE(f.updated_at, f.created_at)) AS last_finding_at
      FROM findings f
      WHERE f.tenant_id = $1
        AND LOWER(COALESCE(f.status, '')) <> 'cerrado'
        AND (
          f.tenant_control_id IN (SELECT tenant_control_id FROM enabled_controls)
          OR f.source_id IN (SELECT tenant_control_id FROM enabled_controls)
        )
    ),
    action_plans_std AS (
      SELECT COUNT(*)::int AS open_action_plans_count,
             MAX(COALESCE(ap.updated_at, ap.created_at)) AS last_action_plan_at
      FROM action_plans ap
      WHERE ap.tenant_id = $1
        AND LOWER(COALESCE(ap.status, '')) NOT IN ('cerrado', 'completado', 'cancelado')
        AND (
          ap.tenant_control_id IN (SELECT tenant_control_id FROM enabled_controls)
          OR ap.source_id IN (SELECT tenant_control_id FROM enabled_controls)
        )
    )
    SELECT
      (SELECT COUNT(*)::int FROM catalog_controls) AS catalog_controls_count,
      (SELECT COUNT(*)::int FROM enabled_controls) AS enabled_controls_count,
      (SELECT COUNT(*)::int FROM evidence_per_control WHERE evidence_count > 0) AS controls_with_evidence_count,
      COALESCE((SELECT ROUND(AVG(lh.health_score)::numeric, 2) FROM latest_health lh WHERE lh.tenant_control_id IN (SELECT tenant_control_id FROM enabled_controls)), 0) AS avg_health_score,
      COALESCE((SELECT open_nonconformities_count FROM nc_std), 0) AS open_nonconformities_count,
      COALESCE((SELECT open_findings_count FROM findings_std), 0) AS open_findings_count,
      COALESCE((SELECT open_action_plans_count FROM action_plans_std), 0) AS open_action_plans_count,
      GREATEST(
        COALESCE((SELECT MAX(last_evidence_at) FROM evidence_per_control), '1970-01-01'::timestamp),
        COALESCE((SELECT last_nc_at FROM nc_std), '1970-01-01'::timestamp),
        COALESCE((SELECT last_finding_at FROM findings_std), '1970-01-01'::timestamp),
        COALESCE((SELECT last_action_plan_at FROM action_plans_std), '1970-01-01'::timestamp),
        COALESCE((SELECT MAX(updated_at) FROM enabled_controls), '1970-01-01'::timestamp)
      ) AS last_activity_without_audit
    `,
    [tenantId, standardCode, operationId]
  );

  const row = result.rows[0] || {};
  const catalogControlsCount = Number(row.catalog_controls_count || 0);
  const enabledControlsCount = Number(row.enabled_controls_count || 0);
  const controlsWithEvidenceCount = Number(row.controls_with_evidence_count || 0);
  const avgHealthScore = Number(row.avg_health_score || 0);
  const openNonconformitiesCount = Number(row.open_nonconformities_count || 0);
  const openFindingsCount = Number(row.open_findings_count || 0);
  const openActionPlansCount = Number(row.open_action_plans_count || 0);
  const openAuditsCount = Number(auditMetrics.open_audits_count || 0);

  const controlsEnabledPct = pct(enabledControlsCount, catalogControlsCount);
  const evidenceCoveragePct = pct(controlsWithEvidenceCount, enabledControlsCount);

  const lastActivityCandidates = [
    row.last_activity_without_audit,
    auditMetrics.last_audit_at
  ].filter(Boolean);

  let lastActivityAt = null;
  if (lastActivityCandidates.length > 0) {
    const maxDate = lastActivityCandidates
      .map((value) => new Date(value))
      .sort((a, b) => b.getTime() - a.getTime())[0];
    lastActivityAt = maxDate.toISOString();
  }

  return {
    catalog_controls_count: catalogControlsCount,
    enabled_controls_count: enabledControlsCount,
    controls_enabled_pct: controlsEnabledPct,
    controls_with_evidence_count: controlsWithEvidenceCount,
    evidence_coverage_pct: evidenceCoveragePct,
    avg_health_score: avgHealthScore,
    open_nonconformities_count: openNonconformitiesCount,
    open_findings_count: openFindingsCount,
    open_action_plans_count: openActionPlansCount,
    open_audits_count: openAuditsCount,
    last_activity_at: lastActivityAt,
    is_scope_inactive: false
  };
}

