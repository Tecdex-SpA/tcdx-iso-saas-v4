// =====================================================
// GET /api/admin-saas/tenants/:tenant_id/standards/catalog
// Catálogo de normas y estado contratado para un tenant.
// =====================================================
router.get('/tenants/:tenant_id/standards/catalog', auth, async (req, res) => {
  try {
    const ctx = await requireAdminSaasView(req, res);
    if (!ctx) return;

    const { tenant_id } = req.params;

    const allowed = await ensureTenantVisibility(ctx, tenant_id);
    if (!allowed) {
      return res.status(403).json({
        ok: false,
        error: 'No autorizado para ver normas de esta empresa',
      });
    }

    const result = await pool.query(
      `
      SELECT
        s.code AS standard_code,
        COALESCE(s.name, s.code) AS standard_name,

        CASE
          WHEN ts.tenant_id IS NOT NULL
           AND COALESCE(
             ts.lifecycle_status,
             CASE WHEN COALESCE(ts.is_active, FALSE) = TRUE THEN 'active' ELSE 'paused' END
           ) IN ('active', 'paused')
          THEN TRUE
          ELSE FALSE
        END AS is_contracted,

        CASE
          WHEN COALESCE(
            ts.lifecycle_status,
            CASE WHEN COALESCE(ts.is_active, FALSE) = TRUE THEN 'active' ELSE 'paused' END
          ) = 'active'
          THEN TRUE
          ELSE FALSE
        END AS is_active,

        COALESCE(
          ts.lifecycle_status,
          CASE
            WHEN ts.tenant_id IS NULL THEN 'not_contracted'
            WHEN COALESCE(ts.is_active, FALSE) = TRUE THEN 'active'
            ELSE 'paused'
          END
        ) AS lifecycle_status,

        ts.contracted_at,
        ts.deactivated_at,
        ts.paused_at,
        ts.permanently_deactivated_at,
        ts.updated_at,

        COALESCE(ctrl.controls_count, 0)::int AS catalog_controls_count,
        COALESCE(tctrl.tenant_controls_count, 0)::int AS tenant_controls_count

      FROM standards s

      LEFT JOIN tenant_standards ts
        ON ts.standard_code = s.code
       AND ts.tenant_id = $1::uuid

      LEFT JOIN (
        SELECT
          iso AS standard_code,
          COUNT(*)::int AS controls_count
        FROM controls_catalog
        GROUP BY iso
      ) ctrl
        ON ctrl.standard_code = s.code

      LEFT JOIN (
        SELECT
          cc.iso AS standard_code,
          COUNT(tc.id)::int AS tenant_controls_count
        FROM tenant_controls tc
        JOIN controls_catalog cc
          ON cc.id = tc.control_id
        WHERE tc.tenant_id = $1::uuid
        GROUP BY cc.iso
      ) tctrl
        ON tctrl.standard_code = s.code

      ORDER BY s.code
      `,
      [tenant_id]
    );

    return res.json({
      ok: true,
      data: result.rows,
    });
  } catch (error) {
    console.error('ERROR GET TENANT STANDARDS CATALOG:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo catálogo de normas contratables',
      detail: error.message,
    });
  }
});

// =====================================================
// PUT /api/admin-saas/tenants/:tenant_id/standards/:standard_code/contract
// Activa, pausa o desactiva una norma para un tenant.
// Reglas:
// - No se puede activar más normas que max_active_standards del contrato.
// - No se puede desactivar directamente una norma activa.
// - Para desactivar definitivamente, primero debe estar pausada.
// =====================================================
router.put('/tenants/:tenant_id/standards/:standard_code/contract', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { tenant_id, standard_code } = req.params;

    const requestedAction = String(req.body?.action || '').trim();
    const isActiveBody =
      req.body?.is_active === undefined ? true : Boolean(req.body.is_active);

    const action = requestedAction || (isActiveBody ? 'activate' : 'pause');
    const notes = req.body?.notes || null;

    const allowedActions = ['activate', 'pause', 'deactivate'];

    if (!allowedActions.includes(action)) {
      return res.status(400).json({
        ok: false,
        error: `Acción inválida. Permitidas: ${allowedActions.join(', ')}`,
      });
    }

    await client.query('BEGIN');

    const tenantResult = await client.query(
      `SELECT id, name FROM tenants WHERE id = $1::uuid LIMIT 1`,
      [tenant_id]
    );

    if (tenantResult.rowCount === 0) {
      await client.query('ROLLBACK');
      return res.status(404).json({ ok: false, error: 'Tenant no encontrado' });
    }

    const standardResult = await client.query(
      `SELECT code, name FROM standards WHERE code = $1::text LIMIT 1`,
      [standard_code]
    );

    if (standardResult.rowCount === 0) {
      await client.query('ROLLBACK');
      return res.status(404).json({ ok: false, error: 'Norma no encontrada en catálogo standards' });
    }

    const currentResult = await client.query(
      `
      SELECT *
      FROM tenant_standards
      WHERE tenant_id = $1::uuid
        AND standard_code = $2::text
      LIMIT 1
      `,
      [tenant_id, standard_code]
    );

    const current = currentResult.rows[0] || null;
    const currentLifecycle = current?.lifecycle_status || (current?.is_active ? 'active' : 'paused');

    const contractResult = await client.query(
      `
      SELECT *
      FROM tenant_contracts
      WHERE tenant_id = $1::uuid
      ORDER BY created_at DESC NULLS LAST
      LIMIT 1
      `,
      [tenant_id]
    );

    const contract = contractResult.rows[0] || null;
    const maxActiveStandards = contract?.max_active_standards;

    if (action === 'activate' && maxActiveStandards !== null && maxActiveStandards !== undefined) {
      const activeCountResult = await client.query(
        `
        SELECT COUNT(*)::int AS active_count
        FROM tenant_standards
        WHERE tenant_id = $1::uuid
          AND standard_code <> $2::text
          AND COALESCE(is_active, TRUE) = TRUE
          AND COALESCE(lifecycle_status, 'active') = 'active'
        `,
        [tenant_id, standard_code]
      );

      const activeCount = Number(activeCountResult.rows[0]?.active_count || 0);

      if (activeCount >= Number(maxActiveStandards)) {
        await client.query('ROLLBACK');

        return res.status(409).json({
          ok: false,
          error: `No puedes activar más normas. El contrato permite máximo ${maxActiveStandards} norma(s) activas.`,
          detail: {
            active_count: activeCount,
            max_active_standards: Number(maxActiveStandards),
          },
        });
      }
    }

    if (action === 'deactivate' && currentLifecycle !== 'paused') {
      await client.query('ROLLBACK');

      return res.status(409).json({
        ok: false,
        error: 'Para desactivar definitivamente una norma, primero debe estar pausada.',
        detail: {
          current_lifecycle_status: currentLifecycle,
        },
      });
    }

    const newLifecycle =
      action === 'activate' ? 'active' :
      action === 'pause' ? 'paused' :
      'deactivated';

    const newIsActive = newLifecycle === 'active';

    const result = await client.query(
      `
      INSERT INTO tenant_standards (
        tenant_id,
        standard_code,
        is_active,
        lifecycle_status,
        contracted_at,
        deactivated_at,
        paused_at,
        permanently_deactivated_at,
        updated_at
      )
      VALUES (
        $1::uuid,
        $2::text,
        $3::boolean,
        $4::text,
        CASE WHEN $4::text = 'active' THEN now() ELSE NULL END,
        CASE WHEN $4::text IN ('paused', 'deactivated') THEN now() ELSE NULL END,
        CASE WHEN $4::text = 'paused' THEN now() ELSE NULL END,
        CASE WHEN $4::text = 'deactivated' THEN now() ELSE NULL END,
        now()
      )
      ON CONFLICT (tenant_id, standard_code)
      DO UPDATE SET
        is_active = EXCLUDED.is_active,
        lifecycle_status = EXCLUDED.lifecycle_status,
        contracted_at = CASE
          WHEN EXCLUDED.lifecycle_status = 'active'
          THEN COALESCE(tenant_standards.contracted_at, now())
          ELSE tenant_standards.contracted_at
        END,
        deactivated_at = CASE
          WHEN EXCLUDED.lifecycle_status IN ('paused', 'deactivated') THEN now()
          ELSE NULL
        END,
        paused_at = CASE
          WHEN EXCLUDED.lifecycle_status = 'paused' THEN now()
          ELSE tenant_standards.paused_at
        END,
        permanently_deactivated_at = CASE
          WHEN EXCLUDED.lifecycle_status = 'deactivated' THEN now()
          ELSE tenant_standards.permanently_deactivated_at
        END,
        updated_at = now()
      RETURNING *
      `,
      [tenant_id, standard_code, newIsActive, newLifecycle]
    );

    const updated = result.rows[0];

    await client.query(
      `
      INSERT INTO tenant_standard_audit (
        tenant_id,
        standard_code,
        action,
        old_is_active,
        new_is_active,
        changed_by_user_id,
        notes,
        metadata
      )
      VALUES (
        $1::uuid,
        $2::text,
        $3::text,
        $4::boolean,
        $5::boolean,
        $6::uuid,
        $7::text,
        $8::jsonb
      )
      `,
      [
        tenant_id,
        standard_code,
        `standard.${action}`,
        current?.is_active ?? null,
        updated.is_active,
        ctx.user.id,
        notes,
        JSON.stringify({
          tenant_name: tenantResult.rows[0].name,
          standard_name: standardResult.rows[0].name,
          old_lifecycle_status: currentLifecycle,
          new_lifecycle_status: newLifecycle,
          max_active_standards: maxActiveStandards ?? null,
          source: 'admin_saas',
        }),
      ]
    );

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: updated,
    });
  } catch (error) {
    try {
      await client.query('ROLLBACK');
    } catch {}

    console.error('ERROR CONTRACT TENANT STANDARD:', error);

    return res.status(500).json({
      ok: false,
      error: 'Error actualizando norma contratada',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});

