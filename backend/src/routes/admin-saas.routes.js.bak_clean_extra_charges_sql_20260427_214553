router.get('/dealer/tenants', auth, async (req, res) => {
  try {
    const ctx = await requireDealerOrPlatform(req, res);
    if (!ctx) return;

    let query = `
      SELECT
        dealer_user_id,
        dealer_email,
        dealer_name,
        tenant_id,
        tenant_name,
        can_view_admin_saas,
        can_manage_modules,
        can_manage_standards,
        can_view_contract,
        can_request_changes,
        can_view_sensitive_evidence,
        status,
        assigned_at,
        revoked_at
