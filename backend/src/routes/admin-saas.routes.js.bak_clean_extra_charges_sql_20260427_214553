// =====================================================
// PUT /api/admin-saas/tenants/:tenant_id/contract
// Crea o actualiza contrato SaaS vigente de la empresa.
// =====================================================
router.put('/tenants/:tenant_id/contract', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { tenant_id } = req.params;

    const planKey = String(req.body?.plan_key || 'demo').trim();
    const contractStatus = String(req.body?.contract_status || 'trial').trim();

    const startedAt = req.body?.started_at || null;
    const endsAt = req.body?.ends_at || null;

    const billingCurrency = String(req.body?.billing_currency || 'CLP').trim();
    const commercialNotes = req.body?.commercial_notes || null;
    const crmReference = req.body?.crm_reference || null;

    const maxActiveStandards =
      req.body?.max_active_standards === undefined || req.body?.max_active_standards === null || req.body?.max_active_standards === ''
        ? null
        : Number(req.body.max_active_standards);

    const maxPremiumModules =
      req.body?.max_premium_modules === undefined || req.body?.max_premium_modules === null || req.body?.max_premium_modules === ''
        ? null
        : Number(req.body.max_premium_modules);

    const externalLookupQuota =
      req.body?.external_lookup_quota === undefined || req.body?.external_lookup_quota === null || req.body?.external_lookup_quota === ''
        ? null
        : Number(req.body.external_lookup_quota);

    if (maxActiveStandards !== null && (!Number.isFinite(maxActiveStandards) || maxActiveStandards < 0)) {
      return res.status(400).json({ ok: false, error: 'max_active_standards debe ser número mayor o igual a 0' });
    }

    if (maxPremiumModules !== null && (!Number.isFinite(maxPremiumModules) || maxPremiumModules < 0)) {
      return res.status(400).json({ ok: false, error: 'max_premium_modules debe ser número mayor o igual a 0' });
    }

    if (externalLookupQuota !== null && (!Number.isFinite(externalLookupQuota) || externalLookupQuota < 0)) {
      return res.status(400).json({ ok: false, error: 'external_lookup_quota debe ser número mayor o igual a 0' });
    }

    const metadata =
      req.body?.metadata && typeof req.body.metadata === 'object'
        ? req.body.metadata
        : {};

    const allowedPlans = ['demo', 'pyme', 'empresa', 'enterprise'];
    const allowedStatuses = ['trial', 'active', 'suspended', 'cancelled'];

    if (!allowedPlans.includes(planKey)) {
      return res.status(400).json({
        ok: false,
        error: `Plan inválido. Permitidos: ${allowedPlans.join(', ')}`,
      });
    }

    if (!allowedStatuses.includes(contractStatus)) {
      return res.status(400).json({
        ok: false,
        error: `Estado inválido. Permitidos: ${allowedStatuses.join(', ')}`,
      });
    }

    await client.query('BEGIN');

    const tenantResult = await client.query(
      `
      SELECT id, name, rut
      FROM tenants
      WHERE id = $1::uuid
      LIMIT 1
      `,
      [tenant_id]
    );

    if (tenantResult.rowCount === 0) {
      await client.query('ROLLBACK');

      return res.status(404).json({
        ok: false,
        error: 'Empresa no encontrada',
      });
    }

    const currentResult = await client.query(
      `
      SELECT *
      FROM tenant_contracts
      WHERE tenant_id = $1::uuid
      ORDER BY created_at DESC NULLS LAST
      LIMIT 1
      `,
      [tenant_id]
    );

    const current = currentResult.rows[0] || null;

    let result;

    if (current) {
      result = await client.query(
        `
        UPDATE tenant_contracts
        SET
          plan_key = $2::text,
          contract_status = $3::text,
          started_at = NULLIF($4::text, '')::date,
          ends_at = NULLIF($5::text, '')::date,
          billing_currency = $6::text,
          commercial_notes = $7::text,
          crm_reference = $8::text,
          max_active_standards = $9::int,
          max_premium_modules = $10::int,
          external_lookup_quota = $11::int,
          metadata = COALESCE(metadata, '{}'::jsonb) || $12::jsonb,
          updated_at = now()
        WHERE id = $1::uuid
        RETURNING *
        `,
        [
          current.id,
          planKey,
          contractStatus,
          startedAt,
          endsAt,
          billingCurrency,
          commercialNotes,
          crmReference,
          maxActiveStandards,
          maxPremiumModules,
          externalLookupQuota,
          JSON.stringify({
            ...metadata,
            updated_by: ctx.user.id,
            updated_from: 'admin_saas',
          }),
        ]
      );
    } else {
      result = await client.query(
        `
        INSERT INTO tenant_contracts (
          tenant_id,
          plan_key,
          contract_status,
          started_at,
          ends_at,
          billing_currency,
          commercial_notes,
          crm_reference,
          max_active_standards,
          max_premium_modules,
          external_lookup_quota,
          metadata,
          created_at,
          updated_at
        )
        VALUES (
          $1::uuid,
          $2::text,
          $3::text,
          NULLIF($4::text, '')::date,
          NULLIF($5::text, '')::date,
          $6::text,
          $7::text,
          $8::text,
          $9::int,
          $10::int,
          $11::int,
          $12::jsonb,
          now(),
          now()
        )
        RETURNING *
        `,
        [
          tenant_id,
          planKey,
          contractStatus,
          startedAt,
          endsAt,
          billingCurrency,
          commercialNotes,
          crmReference,
          maxActiveStandards,
          maxPremiumModules,
          externalLookupQuota,
          JSON.stringify({
            ...metadata,
            created_by: ctx.user.id,
            updated_by: ctx.user.id,
            updated_from: 'admin_saas',
          }),
        ]
      );
    }

    const updated = result.rows[0];

    try {
      await client.query(
        `
        SELECT log_admin_audit_event(
          $1::uuid,
          $2::text,
          $3::uuid,
          $4::text,
          $5::uuid,
          $6::jsonb
        )
        `,
        [
          ctx.user.id,
          current ? 'tenant_contract.updated' : 'tenant_contract.created',
          tenant_id,
          'tenant_contract',
          updated.id,
          JSON.stringify({
            old: current
              ? {
                  plan_key: current.plan_key,
                  contract_status: current.contract_status,
                  started_at: current.started_at,
                  ends_at: current.ends_at,
                  commercial_notes: current.commercial_notes,
                  crm_reference: current.crm_reference,
                }
              : null,
            new: {
              plan_key: updated.plan_key,
              contract_status: updated.contract_status,
              started_at: updated.started_at,
              ends_at: updated.ends_at,
              commercial_notes: updated.commercial_notes,
              crm_reference: updated.crm_reference,
            },
            source: 'admin_saas',
          }),
        ]
      );
    } catch (auditError) {
      console.warn('WARN log_admin_audit_event tenant_contract:', auditError.message);
    }

    await client.query('COMMIT');

    const verify = await pool.query(
      `
      SELECT *
      FROM tenant_contracts
      WHERE id = $1::uuid
      LIMIT 1
      `,
      [updated.id]
    );

    return res.json({
      ok: true,
      data: verify.rows[0] || updated,
    });
  } catch (error) {
    try {
      await client.query('ROLLBACK');
    } catch {}

    console.error('ERROR UPSERT TENANT CONTRACT:', error);

    return res.status(500).json({
      ok: false,
      error: 'Error guardando contrato SaaS',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});




