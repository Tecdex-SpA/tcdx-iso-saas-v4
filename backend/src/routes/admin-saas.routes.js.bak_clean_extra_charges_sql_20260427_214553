// GET /api/admin-saas/tenants/:tenant_id/modules/catalog
// Catálogo de módulos del tenant + límite contractual.
// =====================================================
router.get('/tenants/:tenant_id/modules/catalog', auth, async (req, res) => {
  try {
    const ctx = await requireAdminSaasView(req, res);
    if (!ctx) return;

    const { tenant_id } = req.params;

    const allowed = await ensureTenantVisibility(ctx, tenant_id);
    if (!allowed) {
      return res.status(403).json({
        ok: false,
        error: 'No autorizado para ver módulos de esta empresa',
      });
    }

    const contractResult = await pool.query(
      `
      SELECT
        id,
        plan_key,
        contract_status,
        max_premium_modules
      FROM tenant_contracts
      WHERE tenant_id = $1::uuid
      ORDER BY created_at DESC NULLS LAST
      LIMIT 1
      `,
      [tenant_id]
    );

    const contract = contractResult.rows[0] || null;
    const maxPremiumModules = contract?.max_premium_modules;

    const modulesResult = await pool.query(
      `
      SELECT
        tenant_id,
        tenant_name,
        module_key,
        module_name,
        module_description,
        sort_order,
        is_enabled,
        enabled_at,
        disabled_at,
        notes,
        metadata
      FROM v_tenant_modules
      WHERE tenant_id = $1::uuid
      ORDER BY sort_order, module_key
      `,
      [tenant_id]
    );

    const enabledCount = modulesResult.rows.filter((row) => row.is_enabled === true).length;

    const rows = modulesResult.rows.map((row) => ({
      ...row,
      can_enable:
        row.is_enabled === true ||
        maxPremiumModules === null ||
        maxPremiumModules === undefined ||
        enabledCount < Number(maxPremiumModules),
    }));

    return res.json({
      ok: true,
      data: {
        contract: contract || null,
        max_premium_modules: maxPremiumModules,
        enabled_modules_count: enabledCount,
        modules: rows,
      },
    });
  } catch (error) {
    console.error('ERROR GET TENANT MODULES CATALOG:', error);

    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo módulos del tenant',
      detail: error.message,
    });
  }
});

// =====================================================
// PUT /api/admin-saas/tenants/:tenant_id/modules/:module_key/contract-toggle
// Activa/desactiva módulo respetando max_premium_modules.
// =====================================================
router.put('/tenants/:tenant_id/modules/:module_key/contract-toggle', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { tenant_id, module_key } = req.params;
    const isEnabled = Boolean(req.body?.is_enabled);
    const notes = req.body?.notes || null;
    const metadata = req.body?.metadata && typeof req.body.metadata === 'object'
      ? req.body.metadata
      : {};

    await client.query('BEGIN');

    const moduleResult = await client.query(
      `
      SELECT module_key, display_name
      FROM saas_modules
      WHERE module_key = $1::text
        AND is_active = TRUE
      LIMIT 1
      `,
      [module_key]
    );

    if (moduleResult.rowCount === 0) {
      await client.query('ROLLBACK');
      return res.status(404).json({
        ok: false,
        error: 'Módulo no encontrado o inactivo',
      });
    }

    const contractResult = await client.query(
      `
      SELECT
        id,
        plan_key,
        contract_status,
        max_premium_modules
      FROM tenant_contracts
      WHERE tenant_id = $1::uuid
      ORDER BY created_at DESC NULLS LAST
      LIMIT 1
      `,
      [tenant_id]
    );

    const contract = contractResult.rows[0] || null;
    const maxPremiumModules = contract?.max_premium_modules;

    if (isEnabled && maxPremiumModules !== null && maxPremiumModules !== undefined) {
      const enabledCountResult = await client.query(
        `
        SELECT COUNT(*)::int AS enabled_count
        FROM v_tenant_modules
        WHERE tenant_id = $1::uuid
          AND module_key <> $2::text
          AND is_enabled = TRUE
        `,
        [tenant_id, module_key]
      );

      const enabledCount = Number(enabledCountResult.rows[0]?.enabled_count || 0);

      if (enabledCount >= Number(maxPremiumModules)) {
        await client.query('ROLLBACK');

        return res.status(409).json({
          ok: false,
          code: 'CONTRACT_MODULE_LIMIT_EXCEEDED',
          error: `No se puede habilitar este módulo. El contrato permite máximo ${maxPremiumModules} módulo(s) premium activo(s).`,
          detail: {
            enabled_modules: enabledCount,
            max_premium_modules: Number(maxPremiumModules),
            module_key,
          },
        });
      }
    }

    const result = await client.query(
      `
      INSERT INTO tenant_module_settings (
        tenant_id,
        module_key,
        is_enabled,
        enabled_at,
        disabled_at,
        notes,
        metadata
      )
      VALUES (
        $1::uuid,
        $2::text,
        $3::boolean,
        CASE WHEN $3::boolean = TRUE THEN now() ELSE NULL END,
        CASE WHEN $3::boolean = FALSE THEN now() ELSE NULL END,
        $4::text,
        $5::jsonb
      )
      ON CONFLICT (tenant_id, module_key)
      DO UPDATE SET
        is_enabled = EXCLUDED.is_enabled,
        enabled_at = CASE WHEN EXCLUDED.is_enabled = TRUE THEN now() ELSE tenant_module_settings.enabled_at END,
        disabled_at = CASE WHEN EXCLUDED.is_enabled = FALSE THEN now() ELSE NULL END,
        notes = EXCLUDED.notes,
        metadata = COALESCE(tenant_module_settings.metadata, '{}'::jsonb) || EXCLUDED.metadata
      RETURNING *
      `,
      [
        tenant_id,
        module_key,
        isEnabled,
        notes,
        JSON.stringify({
          ...metadata,
          updated_by: ctx.user.id,
          updated_from: 'admin_saas',
          contract_limit_checked: true,
        }),
      ]
    );

    try {
      await client.query(
        `
        SELECT log_admin_audit_event(
          $1::uuid,
          $2::text,
          $3::uuid,
          $4::text,
          NULL::uuid,
          $5::jsonb
        )
        `,
        [
          ctx.user.id,
          isEnabled ? 'tenant_module.enabled' : 'tenant_module.disabled',
          tenant_id,
          'tenant_module',
          JSON.stringify({
            module_key,
            is_enabled: isEnabled,
            max_premium_modules: maxPremiumModules ?? null,
            source: 'admin_saas',
          }),
        ]
      );
    } catch (auditError) {
      console.warn('WARN log_admin_audit_event tenant_module:', auditError.message);
    }

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: result.rows[0],
    });
  } catch (error) {
    try {
      await client.query('ROLLBACK');
    } catch {}

    console.error('ERROR CONTRACT TOGGLE TENANT MODULE:', error);

    return res.status(500).json({
      ok: false,
      error: 'Error actualizando módulo del tenant',
      detail: error.message,
      code: error.code || null,
    });
  } finally {
    client.release();
  }
});



module.exports = router;
