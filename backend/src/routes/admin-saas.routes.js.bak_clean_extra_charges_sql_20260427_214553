// =====================================================
// PUT /api/admin-saas/tenants/:tenant_id/modules/:module_key
// Activa/desactiva módulo SaaS respetando límite contractual.
// =====================================================
router.put('/tenants/:tenant_id/modules/:module_key', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { tenant_id, module_key } = req.params;
    const isEnabled = Boolean(req.body?.is_enabled);
    const notes = req.body?.notes || null;
    const metadata = req.body?.metadata && typeof req.body.metadata === 'object'
      ? req.body.metadata
      : {};

    await client.query('BEGIN');

    const tenantResult = await client.query(
      `SELECT id, name FROM tenants WHERE id = $1::uuid LIMIT 1`,
      [tenant_id]
    );

    if (tenantResult.rowCount === 0) {
      await client.query('ROLLBACK');
      return res.status(404).json({
        ok: false,
        error: 'Empresa no encontrada',
      });
    }

    const moduleResult = await client.query(
      `
      SELECT module_key, display_name
      FROM saas_modules
      WHERE module_key = $1::text
        AND is_active = TRUE
      LIMIT 1
      `,
      [module_key]
    );

    if (moduleResult.rowCount === 0) {
      await client.query('ROLLBACK');
      return res.status(404).json({
        ok: false,
        error: 'Módulo no encontrado o inactivo',
      });
    }

    if (isEnabled) {
      const contractResult = await client.query(
        `
        SELECT
          id,
          plan_key,
          max_premium_modules
        FROM tenant_contracts
        WHERE tenant_id = $1::uuid
        ORDER BY created_at DESC NULLS LAST
        LIMIT 1
        `,
        [tenant_id]
      );

      const contract = contractResult.rows[0] || null;
      const maxPremiumModules = contract?.max_premium_modules;

      if (maxPremiumModules !== null && maxPremiumModules !== undefined) {
        const enabledCountResult = await client.query(
          `
          SELECT COUNT(*)::int AS enabled_count
          FROM tenant_module_settings
          WHERE tenant_id = $1::uuid
            AND module_key <> $2::text
            AND COALESCE(is_enabled, FALSE) = TRUE
          `,
          [tenant_id, module_key]
        );

        const enabledCount = Number(enabledCountResult.rows[0]?.enabled_count || 0);

        if (enabledCount >= Number(maxPremiumModules)) {
          await client.query('ROLLBACK');

          return res.status(409).json({
            ok: false,
            code: 'CONTRACT_MODULE_LIMIT_EXCEEDED',
            error: `No se puede habilitar este módulo. El contrato permite máximo ${maxPremiumModules} módulo(s) premium activo(s).`,
            detail: {
              enabled_modules: enabledCount,
              max_premium_modules: Number(maxPremiumModules),
              module_key,
            },
          });
        }
      }
    }

    const result = await client.query(
      `
      INSERT INTO tenant_module_settings (
        tenant_id,
        module_key,
        is_enabled,
        enabled_at,
        disabled_at,
        notes,
        metadata
      )
      VALUES (
        $1::uuid,
        $2::text,
        $3::boolean,
        CASE WHEN $3::boolean = TRUE THEN now() ELSE NULL END,
        CASE WHEN $3::boolean = FALSE THEN now() ELSE NULL END,
        $4::text,
        $5::jsonb
      )
      ON CONFLICT (tenant_id, module_key)
      DO UPDATE SET
        is_enabled = EXCLUDED.is_enabled,
        enabled_at = CASE WHEN EXCLUDED.is_enabled = TRUE THEN now() ELSE tenant_module_settings.enabled_at END,
        disabled_at = CASE WHEN EXCLUDED.is_enabled = FALSE THEN now() ELSE NULL END,
        notes = EXCLUDED.notes,
        metadata = COALESCE(tenant_module_settings.metadata, '{}'::jsonb) || EXCLUDED.metadata
      RETURNING *
      `,
      [
        tenant_id,
        module_key,
        isEnabled,
        notes,
        JSON.stringify({
          ...metadata,
          updated_by: ctx.user.id,
          updated_from: 'admin_saas',
        }),
      ]
    );

    try {
      await client.query(
        `
        SELECT log_admin_audit_event(
          $1::uuid,
          $2::text,
          $3::uuid,
          $4::text,
          NULL::uuid,
          $5::jsonb
        )
        `,
        [
          ctx.user.id,
          isEnabled ? 'tenant_module.enabled' : 'tenant_module.disabled',
          tenant_id,
          'tenant_module',
          JSON.stringify({
            module_key,
            is_enabled: isEnabled,
            source: 'admin_saas',
          }),
        ]
      );
    } catch (auditError) {
      console.warn('WARN log_admin_audit_event tenant_module:', auditError.message);
    }

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: result.rows[0],
    });
  } catch (error) {
    try {
      await client.query('ROLLBACK');
    } catch {}

    console.error('ERROR UPDATE TENANT MODULE:', error);

    const msg = String(error.message || '');

    if (msg.includes('No puedes activar más módulos')) {
      return res.status(409).json({
        ok: false,
        code: 'CONTRACT_MODULE_LIMIT_EXCEEDED',
        error: msg,
      });
    }

    return res.status(500).json({
      ok: false,
      error: 'Error actualizando módulo del tenant',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});



// =====================================================
// PUT /api/admin-saas/tenants/:tenant_id/standards/:standard_code
// =====================================================
router.put('/tenants/:tenant_id/standards/:standard_code', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { tenant_id, standard_code } = req.params;
    const {
      is_active,
      initialize_controls = false,
      refresh_health = false,
    } = req.body;

    if (typeof is_active !== 'boolean') {
      return res.status(400).json({
        ok: false,
        error: 'is_active debe ser boolean',
      });
    }

    const standardCode = String(standard_code || '').trim().toUpperCase();

    await client.query('BEGIN');

    const existing = await client.query(
      `
      SELECT tenant_id, standard_code, is_active
      FROM tenant_standards
      WHERE tenant_id = $1::uuid
        AND standard_code = $2::text
      LIMIT 1
      `,
      [tenant_id, standardCode]
    );

    if (existing.rowCount > 0) {
      await client.query(
        `
        UPDATE tenant_standards
        SET is_active = $3::boolean
        WHERE tenant_id = $1::uuid
          AND standard_code = $2::text
        `,
        [tenant_id, standardCode, is_active]
      );
    } else {
      await client.query(
        `
        INSERT INTO tenant_standards (
          tenant_id,
          standard_code,
          is_active
        )
        VALUES ($1::uuid, $2::text, $3::boolean)
        `,
        [tenant_id, standardCode, is_active]
      );
    }

    let initializedControls = 0;
    let cleanup = null;
    let refresh = null;

    if (is_active === true && initialize_controls === true) {
      initializedControls = await initializeTenantControlsForStandard(
        client,
        tenant_id,
        standardCode
      );
    }

    if (is_active === false) {
      cleanup = await cleanupInactiveStandardOperationalData(
        client,
        tenant_id,
        standardCode
      );
    }

    if (refresh_health === true) {
      refresh = await refreshTenantHealth(client, tenant_id);
    }

    const newStandard = await getTenantStandard(tenant_id, standardCode, client);

    await client.query(
      `
      SELECT log_admin_audit_event(
        $1::uuid,
        $2::text,
        $3::uuid,
        $4::text,
        NULL::uuid,
        $5::jsonb
      )
      `,
      [
        ctx.user.id,
        'tenant_standard.updated',
        tenant_id,
        standardCode,
        JSON.stringify({
          is_active,
          initialize_controls,
          refresh_health,
          initialized_controls: initializedControls,
          cleanup,
        }),
      ]
    );

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: newStandard,
      initialized_controls: initializedControls,
      cleanup,
      refresh,
    });
  } catch (error) {
    await client.query('ROLLBACK');
    console.error('ERROR UPDATE TENANT STANDARD:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error actualizando norma del tenant',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});


// =====================================================
// POST /api/admin-saas/tenants/:tenant_id/standards/:standard_code/initialize-controls
// Inicializa controles faltantes para una norma activa.
// No duplica controles existentes.
// =====================================================

// =====================================================
// FIX_OPERATION_ID_INITIALIZE_CONTROLS
// POST /api/admin-saas/tenants/:tenant_id/standards/:standard_code/initialize-controls
// Inicializa controles faltantes usando operation_id obligatorio.
// No duplica controles existentes por tenant/control/operation.
// =====================================================
router.post('/tenants/:tenant_id/standards/:standard_code/initialize-controls', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { tenant_id, standard_code } = req.params;

    await client.query('BEGIN');

    const tenantResult = await client.query(
      `
      SELECT id, name
      FROM tenants
      WHERE id = $1::uuid
      LIMIT 1
      `,
      [tenant_id]
    );

    if (tenantResult.rowCount === 0) {
      await client.query('ROLLBACK');
      return res.status(404).json({
        ok: false,
        error: 'Empresa no encontrada',
      });
    }

    const standardState = await client.query(
      `
      SELECT
        tenant_id,
        standard_code,
        is_active,
        COALESCE(
          lifecycle_status,
          CASE WHEN COALESCE(is_active, FALSE) = TRUE THEN 'active' ELSE 'paused' END
        ) AS lifecycle_status
      FROM tenant_standards
      WHERE tenant_id = $1::uuid
        AND standard_code = $2::text
      LIMIT 1
      `,
      [tenant_id, standard_code]
    );

    const state = standardState.rows[0] || null;

    if (!state || state.lifecycle_status !== 'active' || state.is_active !== true) {
      await client.query('ROLLBACK');
      return res.status(409).json({
        ok: false,
        code: 'STANDARD_NOT_ACTIVE',
        error: 'No se pueden inicializar controles porque la norma no está activa. Primero debes contratar/reactivar la norma.',
        detail: {
          standard_code,
          lifecycle_status: state?.lifecycle_status || 'not_contracted',
          is_active: state?.is_active || false,
        },
      });
    }

    const catalogCountResult = await client.query(
      `
      SELECT COUNT(*)::int AS total
      FROM controls_catalog
      WHERE iso = $1::text
      `,
      [standard_code]
    );

    const catalogCount = Number(catalogCountResult.rows[0]?.total || 0);

    if (catalogCount === 0) {
      await client.query('ROLLBACK');
      return res.status(404).json({
        ok: false,
        error: 'No existen controles en controls_catalog para esta norma',
        detail: { standard_code },
      });
    }

    // 1) Buscar operaciones activas asociadas a esta norma.
    let operationsResult = await client.query(
      `
      SELECT
        o.id AS operation_id,
        o.name AS operation_name,
        o.sort_order
      FROM tenant_standard_operations tso
      JOIN tenant_operations o
        ON o.id = tso.operation_id
      WHERE tso.tenant_id = $1::uuid
        AND tso.standard_code = $2::text
        AND COALESCE(tso.is_active, TRUE) = TRUE
        AND COALESCE(o.is_active, TRUE) = TRUE
      ORDER BY o.sort_order, o.name
      `,
      [tenant_id, standard_code]
    );

    // 2) Si la norma no tiene operación asociada, usar o crear Operación principal.
    if (operationsResult.rowCount === 0) {
      let defaultOperationResult = await client.query(
        `
        SELECT id AS operation_id, name AS operation_name, sort_order
        FROM tenant_operations
        WHERE tenant_id = $1::uuid
          AND COALESCE(is_active, TRUE) = TRUE
        ORDER BY is_default DESC, sort_order ASC, created_at ASC
        LIMIT 1
        `,
        [tenant_id]
      );

      let operation = defaultOperationResult.rows[0] || null;

      if (!operation) {
        const createdOperation = await client.query(
          `
          INSERT INTO tenant_operations (
            tenant_id,
            code,
            name,
            description,
            operation_type,
            is_active,
            is_default,
            sort_order,
            metadata,
            created_at,
            updated_at
          )
          VALUES (
            $1::uuid,
            'principal',
            'Operación principal',
            'Operación principal creada automáticamente para inicializar controles de norma.',
            'principal',
            TRUE,
            TRUE,
            1,
            $2::jsonb,
            now(),
            now()
          )
          RETURNING id AS operation_id, name AS operation_name, sort_order
          `,
          [
            tenant_id,
            JSON.stringify({
              source: 'admin_saas_initialize_controls',
              created_for_standard: standard_code,
            }),
          ]
        );

        operation = createdOperation.rows[0];
      }

      await client.query(
        `
        INSERT INTO tenant_standard_operations (
          tenant_id,
          standard_code,
          operation_id,
          is_active,
          notes,
          created_at,
          updated_at
        )
        SELECT
          $1::uuid,
          $2::text,
          $3::uuid,
          TRUE,
          'Operación vinculada automáticamente al inicializar controles',
          now(),
          now()
        WHERE NOT EXISTS (
          SELECT 1
          FROM tenant_standard_operations
          WHERE tenant_id = $1::uuid
            AND standard_code = $2::text
            AND operation_id = $3::uuid
        )
        `,
        [tenant_id, standard_code, operation.operation_id]
      );

      operationsResult = await client.query(
        `
        SELECT
          o.id AS operation_id,
          o.name AS operation_name,
          o.sort_order
        FROM tenant_standard_operations tso
        JOIN tenant_operations o
          ON o.id = tso.operation_id
        WHERE tso.tenant_id = $1::uuid
          AND tso.standard_code = $2::text
          AND COALESCE(tso.is_active, TRUE) = TRUE
          AND COALESCE(o.is_active, TRUE) = TRUE
        ORDER BY o.sort_order, o.name
        `,
        [tenant_id, standard_code]
      );
    }

    const operationsCount = operationsResult.rowCount;

    if (operationsCount === 0) {
      await client.query('ROLLBACK');
      return res.status(409).json({
        ok: false,
        error: 'No fue posible determinar una operación activa para inicializar controles.',
        detail: { tenant_id, standard_code },
      });
    }

    const existingBeforeResult = await client.query(
      `
      SELECT COUNT(tc.id)::int AS total
      FROM tenant_controls tc
      JOIN controls_catalog cc
        ON cc.id = tc.control_id
      WHERE tc.tenant_id = $1::uuid
        AND cc.iso = $2::text
      `,
      [tenant_id, standard_code]
    );

    const existingBefore = Number(existingBeforeResult.rows[0]?.total || 0);

    const insertResult = await client.query(
      `
      WITH active_operations AS (
        SELECT
          o.id AS operation_id
        FROM tenant_standard_operations tso
        JOIN tenant_operations o
          ON o.id = tso.operation_id
        WHERE tso.tenant_id = $1::uuid
          AND tso.standard_code = $2::text
          AND COALESCE(tso.is_active, TRUE) = TRUE
          AND COALESCE(o.is_active, TRUE) = TRUE
      )
      INSERT INTO tenant_controls (
        tenant_id,
        control_id,
        operation_id,
        status,
        score,
        health_status,
        applicability,
        priority,
        notes,
        metadata,
        created_at,
        updated_at
      )
      SELECT
        $1::uuid AS tenant_id,
        cc.id AS control_id,
        ao.operation_id,
        'pendiente' AS status,
        0 AS score,
        'deteriorado' AS health_status,
        'aplicable' AS applicability,
        'media' AS priority,
        'Control inicializado desde Administración SaaS' AS notes,
        jsonb_build_object(
          'source', 'admin_saas_initialize_controls',
          'standard_code', $2::text
        ) AS metadata,
        now() AS created_at,
        now() AS updated_at
      FROM controls_catalog cc
      CROSS JOIN active_operations ao
      WHERE cc.iso = $2::text
        AND NOT EXISTS (
          SELECT 1
          FROM tenant_controls tc
          WHERE tc.tenant_id = $1::uuid
            AND tc.control_id = cc.id
            AND tc.operation_id = ao.operation_id
        )
      RETURNING id
      `,
      [tenant_id, standard_code]
    );

    const createdCount = insertResult.rowCount || 0;

    const existingAfterResult = await client.query(
      `
      SELECT COUNT(tc.id)::int AS total
      FROM tenant_controls tc
      JOIN controls_catalog cc
        ON cc.id = tc.control_id
      WHERE tc.tenant_id = $1::uuid
        AND cc.iso = $2::text
      `,
      [tenant_id, standard_code]
    );

    const existingAfter = Number(existingAfterResult.rows[0]?.total || 0);

    try {
      await client.query(
        `
        SELECT log_admin_audit_event(
          $1::uuid,
          $2::text,
          $3::uuid,
          $4::text,
          NULL::uuid,
          $5::jsonb
        )
        `,
        [
          ctx.user.id,
          'tenant_standard.controls_initialized',
          tenant_id,
          'tenant_standard',
          JSON.stringify({
            standard_code,
            catalog_controls: catalogCount,
            operations_count: operationsCount,
            existing_before: existingBefore,
            created_controls: createdCount,
            existing_after: existingAfter,
            source: req.body?.source || 'admin_saas',
          }),
        ]
      );
    } catch (auditError) {
      console.warn('WARN log_admin_audit_event initialize-controls:', auditError.message);
    }

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: {
