function normalizeBillingMonth(value) {
  const raw = String(value || '').trim();

  if (/^\d{4}-\d{2}$/.test(raw)) {
    return `${raw}-01`;
  }

  if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) {
    return `${raw.slice(0, 7)}-01`;
  }

  const now = new Date();
  const year = now.getUTCFullYear();
  const month = String(now.getUTCMonth() + 1).padStart(2, '0');

  return `${year}-${month}-01`;
}

async function getPriceMap(client = pool) {
  const result = await client.query(
    `
    SELECT
      id,
      item_type,
      item_key,
      item_name,
      item_description,
      currency,
      unit_price,
      billing_frequency,
      is_active,
      metadata
    FROM saas_price_catalog
    WHERE is_active = TRUE
    ORDER BY item_type, item_key
    `
  );

  const map = {};

  for (const row of result.rows) {
    map[`${row.item_type}:${row.item_key}`] = row;
  }

  return {
    rows: result.rows,
    map,
  };
}

function money(value) {
  const n = Number(value || 0);
  return Number.isFinite(n) ? Math.round(n * 100) / 100 : 0;
}

async function recalculateTenantPrebilling(client, tenantId, billingMonth, actorUserId = null) {
  const contextResult = await client.query(
    `
    SELECT *
    FROM v_saas_prebilling_tenant_context
    WHERE tenant_id = $1::uuid
    LIMIT 1
    `,
    [tenantId]
  );

  const context = contextResult.rows[0];

  if (!context) {
    throw new Error('Tenant no encontrado en contexto de prefacturación');
  }

  const billingMonthKey =
    String(billingMonth || '').length >= 7
      ? String(billingMonth).slice(0, 7)
      : new Date().toISOString().slice(0, 7);

  const extraChargesResult = await client.query(
    `
    SELECT
      COALESCE(SUM(quantity), 0)::int AS extra_count,
      COALESCE(SUM(total_amount), 0)::numeric AS extra_amount
    FROM ai_core.external_lookup_extra_charges
    WHERE tenant_id = $1::uuid
      AND billing_month = $2::text
      AND accepted = TRUE
    `,
    [tenantId, billingMonthKey]
  );

  context.external_lookup_extra_charges_count = Number(
    extraChargesResult.rows[0]?.extra_count || 0
  );

  context.external_lookup_extra_charges_amount = Number(
    extraChargesResult.rows[0]?.extra_amount || 0
  );

  context.billing_month_key = billingMonthKey;

  const { map } = await getPriceMap(client);

  const planKey = context.plan_key || 'demo';
  const planPrice =
    map[`plan_base:${planKey}`] ||
    map['plan_base:demo'] ||
    null;

  const standardPrice = map['standard:standard_active'] || null;
  const modulePrice = map['module:premium_module'] || null;
  const usagePrice =
    map['usage:external_lookup_overage'] ||
    map['ai_external_lookup:extra_query'] ||
    { unit_price: 100, currency: 'CLP' };

  const prebillingResult = await client.query(
    `
    INSERT INTO saas_monthly_prebilling (
      tenant_id,
      billing_month,
      status,
      currency,
      plan_key,
      contract_status,
      notes,
      metadata,
      updated_at
    )
    VALUES (
      $1::uuid,
      $2::date,
      'draft',
      'CLP',
      $3::text,
      $4::text,
      'Prefactura generada automáticamente desde Administración SaaS',
      $5::jsonb,
      now()
    )
    ON CONFLICT (tenant_id, billing_month)
    DO UPDATE SET
      plan_key = EXCLUDED.plan_key,
      contract_status = EXCLUDED.contract_status,
      metadata = saas_monthly_prebilling.metadata || EXCLUDED.metadata,
      updated_at = now()
    RETURNING *
    `,
    [
      tenantId,
      billingMonth,
      planKey,
      context.contract_status || null,
      JSON.stringify({
        source: 'admin_saas_recalculate',
        tenant_name: context.tenant_name,
        active_standards: context.active_standards,
        enabled_modules: context.enabled_modules,
        external_lookup_monthly_limit: context.external_lookup_monthly_limit,
        external_lookup_used_month: context.external_lookup_used_month,
        recalculated_by: actorUserId,
      }),
    ]
  );

  const prebilling = prebillingResult.rows[0];

  await client.query(
    `
    DELETE FROM saas_monthly_prebilling_lines
    WHERE prebilling_id = $1::uuid
      AND is_manual = FALSE
    `,
    [prebilling.id]
  );

  const lines = [];

  if (planPrice) {
    lines.push({
      line_type: 'plan_base',
      line_key: planKey,
      line_name: planPrice.item_name || `Plan ${planKey}`,
      line_description: planPrice.item_description || 'Plan base contratado',
      quantity: 1,
      unit_price: money(planPrice.unit_price),
      is_billable: true,
      is_discount: false,
      metadata: {
        source: 'price_catalog',
        price_catalog_id: planPrice.id,
      },
    });
  }

  if (standardPrice && Number(context.active_standards || 0) > 0) {
    lines.push({
      line_type: 'standard',
      line_key: 'standard_active',
      line_name: 'Normas ISO activas',
      line_description: 'Cargo referencial por normas ISO activas/contratadas del tenant',
      quantity: Number(context.active_standards || 0),
      unit_price: money(standardPrice.unit_price),
      is_billable: true,
      is_discount: false,
      metadata: {
        source: 'tenant_standards',
        price_catalog_id: standardPrice.id,
      },
    });
  }

  if (modulePrice && Number(context.enabled_modules || 0) > 0) {
    lines.push({
      line_type: 'module',
      line_key: 'premium_module',
      line_name: 'Módulos SaaS habilitados',
      line_description: 'Cargo referencial por módulos SaaS habilitados',
      quantity: Number(context.enabled_modules || 0),
      unit_price: money(modulePrice.unit_price),
      is_billable: true,
      is_discount: false,
      metadata: {
        source: 'v_tenant_modules',
        price_catalog_id: modulePrice.id,
      },
    });
  }

  const overage = Math.max(
    Number(context.external_lookup_used_month || 0) -
      Number(context.external_lookup_monthly_limit || 0),
    0
  );

  if (usagePrice && overage > 0 && Number(context.external_lookup_extra_charges_count || 0) === 0) {
    lines.push({
      line_type: 'usage',
      line_key: 'external_lookup_overage',
      line_name: 'Búsquedas externas IA adicionales',
      line_description: 'Uso adicional de respaldo externo IA sobre cuota mensual',
      quantity: overage,
      unit_price: money(usagePrice.unit_price),
      is_billable: true,
      is_discount: false,
      metadata: {
        source: 'external_lookup_usage',
        price_catalog_id: usagePrice.id,
        monthly_limit: context.external_lookup_monthly_limit,
        used_month: context.external_lookup_used_month,
      },
    });
  }

  lines.push({
    line_type: 'ai_external_lookup',
    line_key: 'external_lookup_quota',
    line_name: 'Cuota mensual respaldo externo IA',
    line_description: 'Paquete mensual de 100 consultas. Se cobra completo aunque el cliente use menos consultas.',
    quantity: Math.ceil(Number(context.external_lookup_monthly_limit || 0) / 100),
    unit_price: 4990,
    subtotal_amount:
      Math.ceil(Number(context.external_lookup_monthly_limit || 0) / 100) * 4990,
    is_manual: false,
    is_discount: false,
    is_billable: Number(context.external_lookup_monthly_limit || 0) > 0,
    metadata: {
      source: 'external_lookup_quotas',
      billing_model: 'fixed_package_100',
      package_size: 100,
      package_price_clp: 4990,
      contracted_queries: Number(context.external_lookup_monthly_limit || 0),
      used_month: context.external_lookup_used_month,
      remaining_month: context.external_lookup_remaining_month,
    },
  });

  // external_lookup_extra_charges_prebilling
  // Consultas adicionales aceptadas: $100 por consulta.
  if (Number(context.external_lookup_extra_charges_count || 0) > 0) {
    lines.push({
      line_type: 'usage',
      line_key: 'external_lookup_extra_charge',
      line_name: 'Consultas adicionales respaldo externo IA',
      line_description:
        'Consultas adicionales aceptadas por el usuario al superar la cuota mensual contratada.',
      quantity: Number(context.external_lookup_extra_charges_count || 0),
      unit_price: 100,
      subtotal_amount: Number(context.external_lookup_extra_charges_amount || 0),
      is_manual: false,
      is_discount: false,
      is_billable: true,
      metadata: {
        source: 'external_lookup_extra_charges',
        billing_month: context.billing_month_key,
        unit_price_clp: 100,
        requires_acceptance: true,
      },
    });
  }


  for (const line of lines) {
    const subtotal = money(Number(line.quantity || 0) * Number(line.unit_price || 0));

    await client.query(
      `
      INSERT INTO saas_monthly_prebilling_lines (
        prebilling_id,
        tenant_id,
        billing_month,
        line_type,
        line_key,
        line_name,
        line_description,
        quantity,
        unit_price,
        subtotal_amount,
        is_manual,
        is_discount,
        is_billable,
        metadata
      )
      VALUES (
        $1::uuid,
        $2::uuid,
        $3::date,
        $4::text,
        $5::text,
        $6::text,
        $7::text,
        $8::numeric,
        $9::numeric,
        $10::numeric,
        FALSE,
        $11::boolean,
        $12::boolean,
        $13::jsonb
      )
      `,
      [
        prebilling.id,
        tenantId,
        billingMonth,
        line.line_type,
        line.line_key,
        line.line_name,
        line.line_description,
        line.quantity,
        line.unit_price,
        subtotal,
        line.is_discount,
        line.is_billable,
        JSON.stringify(line.metadata || {}),
      ]
    );
  }

  const totalsResult = await client.query(
    `
    SELECT
      COALESCE(SUM(CASE
        WHEN is_billable = TRUE AND is_discount = FALSE THEN subtotal_amount
        ELSE 0
      END), 0)::numeric AS subtotal_amount,

      ABS(COALESCE(SUM(CASE
        WHEN is_billable = TRUE AND is_discount = TRUE THEN subtotal_amount
        ELSE 0
      END), 0))::numeric AS discount_amount,

      COALESCE(SUM(CASE
        WHEN is_billable = TRUE AND line_type IN ('module', 'usage', 'additional') THEN subtotal_amount
        ELSE 0
      END), 0)::numeric AS additional_amount,

      COALESCE(SUM(CASE
        WHEN is_billable = TRUE THEN subtotal_amount
        ELSE 0
      END), 0)::numeric AS total_amount
    
        ,
        COALESCE(extra_charges.extra_count, 0)::int AS external_lookup_extra_charges_count,
        COALESCE(extra_charges.extra_amount, 0)::numeric AS external_lookup_extra_charges_amount,
        to_char($2::date, 'YYYY-MM') AS billing_month_key
FROM saas_monthly_prebilling_lines
    WHERE prebilling_id = $1::uuid
    `,
    [prebilling.id]
  );

  const totals = totalsResult.rows[0] || {};

  const updatedResult = await client.query(
    `
    UPDATE saas_monthly_prebilling
    SET
      subtotal_amount = $2::numeric,
      discount_amount = $3::numeric,
      additional_amount = $4::numeric,
      tax_amount = 0,
      total_amount = $5::numeric,
      updated_at = now()
    WHERE id = $1::uuid
    RETURNING *
    `,
    [
      prebilling.id,
      money(totals.subtotal_amount),
      money(totals.discount_amount),
      money(totals.additional_amount),
      money(totals.total_amount),
    ]
  );

  const linesResult = await client.query(
    `
    SELECT *
    FROM saas_monthly_prebilling_lines
    WHERE prebilling_id = $1::uuid
    ORDER BY
      CASE line_type
        WHEN 'plan_base' THEN 1
        WHEN 'standard' THEN 2
        WHEN 'module' THEN 3
        WHEN 'usage' THEN 4
        WHEN 'quota_info' THEN 5
        ELSE 10
      END,
      created_at
    `,
    [prebilling.id]
  );

  return {
    prebilling: updatedResult.rows[0],
    lines: linesResult.rows,
    context,
  };
}

