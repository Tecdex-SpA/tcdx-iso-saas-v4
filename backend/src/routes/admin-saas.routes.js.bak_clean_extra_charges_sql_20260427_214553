    `;
    const params = [];

    if (!ctx.isPlatform) {
      query += `
        WHERE dealer_user_id = $1::uuid
          AND status = 'active'
      `;
      params.push(ctx.user.id);
    }

    query += `
      ORDER BY tenant_name
    `;

    const result = await pool.query(query, params);

    return res.json({
      ok: true,
      scope: {
        user_id: ctx.user.id,
        role: ctx.role,
        is_platform: ctx.isPlatform,
        is_dealer: ctx.isDealer,
      },
      data: result.rows,
    });
  } catch (error) {
    console.error('ERROR GET DEALER TENANTS:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo empresas del dealer',
      detail: error.message,
    });
  }
});

// =====================================================
// GET /api/admin-saas/tenants
// Lista empresas para Administración SaaS.
// No depende de columnas antiguas de v_tenant_governance_summary.
// =====================================================
router.get('/tenants', auth, async (req, res) => {
  try {
    const ctx = await requireAdminSaasView(req, res, { allowDealer: true });
    if (!ctx) return;

    const search = String(req.query.search || '').trim();

    const params = [];
    const where = [];

    if (ctx.isDealer && !ctx.isPlatform && !ctx.canViewAdminSaas) {
      params.push(ctx.user.id);
      where.push(`
        EXISTS (
          SELECT 1
          FROM dealer_tenants dt
          WHERE dt.tenant_id = t.id
            AND dt.dealer_user_id = $${params.length}::uuid
            AND dt.status = 'active'
        )
      `);
    }

    if (search) {
      params.push(`%${search}%`);
      where.push(`
        (
          t.name ILIKE $${params.length}
          OR COALESCE(t.rut, '') ILIKE $${params.length}
          OR COALESCE(t.business, '') ILIKE $${params.length}
        )
      `);
    }

    const whereSql = where.length ? `WHERE ${where.join(' AND ')}` : '';

    const query = `
      SELECT
        t.id AS tenant_id,
        t.name AS tenant_name,
        t.rut,
        t.business,
        t.address,
        t.branches,
        t.logo,
        t.logo_url,
        t.created_at,

        COALESCE(std.active_standards, 0)::int AS active_standards,
        COALESCE(std.inactive_standards, 0)::int AS inactive_standards,

        COALESCE(mods.enabled_modules, 0)::int AS enabled_modules,
        COALESCE(mods.disabled_modules, 0)::int AS disabled_modules,

        COALESCE(users_count.active_users_count, 0)::int AS active_users_count,
        COALESCE(dealers_count.dealer_count, 0)::int AS dealer_count,

        contract.plan_key,
        contract.contract_status,
        contract.started_at,
        contract.ends_at,

        NULL::timestamp AS last_admin_event_at
      FROM tenants t

      LEFT JOIN (
        SELECT
          tenant_id,
          COUNT(*)::int AS active_standards,
          0::int AS inactive_standards
        FROM tenant_standards
        GROUP BY tenant_id
      ) std
        ON std.tenant_id = t.id

      LEFT JOIN (
        SELECT
          tenant_id,
          COUNT(*) FILTER (WHERE is_enabled = TRUE)::int AS enabled_modules,
          COUNT(*) FILTER (WHERE is_enabled IS NOT TRUE)::int AS disabled_modules
        FROM v_tenant_modules
        GROUP BY tenant_id
      ) mods
        ON mods.tenant_id = t.id

      LEFT JOIN (
        SELECT
          tenant_id,
          COUNT(*)::int AS active_users_count
        FROM users
        WHERE tenant_id IS NOT NULL
        GROUP BY tenant_id
      ) users_count
        ON users_count.tenant_id = t.id

      LEFT JOIN (
        SELECT
          tenant_id,
          COUNT(*) FILTER (WHERE status = 'active')::int AS dealer_count
        FROM dealer_tenants
        GROUP BY tenant_id
      ) dealers_count
        ON dealers_count.tenant_id = t.id

      LEFT JOIN LATERAL (
        SELECT
          tc.plan_key,
          tc.contract_status,
          tc.started_at,
          tc.ends_at
        FROM tenant_contracts tc
        WHERE tc.tenant_id = t.id
        ORDER BY tc.created_at DESC
        LIMIT 1
      ) contract ON TRUE

      ${whereSql}
      ORDER BY t.created_at DESC NULLS LAST, t.name ASC
    `;

    const result = await pool.query(query, params);

    return res.json({
      ok: true,
      scope: {
        user_id: ctx.user.id,
        role: ctx.role,
        is_platform: ctx.isPlatform,
        is_dealer: ctx.isDealer,
      },
      data: result.rows,
    });
  } catch (error) {
    console.error('ERROR GET TENANTS ADMIN SAAS:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo empresas',
      detail: error.message,
    });
  }
});


// =====================================================
// POST /api/admin-saas/tenants
// Crear empresa desde Administración SaaS.
// Versión blindada: confirma persistencia real luego del COMMIT.
// =====================================================
router.post('/tenants', auth, uploadLogo.single('logo'), async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const {
      name,
      rut,
      address = '',
      business = '',
      branches = '',
    } = req.body || {};

    const cleanName = String(name || '').trim();
    const cleanRut = String(rut || '').trim();

    if (!cleanName || !cleanRut) {
      return res.status(400).json({
        ok: false,
        error: 'Nombre y RUT son obligatorios',
      });
    }

    await client.query('BEGIN');

    const exists = await client.query(
      `
      SELECT id, name, rut
      FROM tenants
      WHERE lower(name) = lower($1::text)
         OR lower(rut) = lower($2::text)
      LIMIT 1
      `,
      [cleanName, cleanRut]
    );

    if (exists.rowCount > 0) {
      await client.query('ROLLBACK');

      return res.status(409).json({
        ok: false,
        error: 'Ya existe una empresa con ese nombre o RUT',
        detail: exists.rows[0],
      });
    }

    const insertResult = await client.query(
      `
      INSERT INTO tenants (
        name,
        rut,
        address,
        business,
        branches,
        logo,
        created_at
      )
      VALUES (
        $1::text,
        $2::text,
        $3::text,
        $4::text,
        $5::text,
        $6::text,
        now()
      )
      RETURNING *
      `,
      [
        cleanName,
        cleanRut,
        String(address || '').trim(),
        String(business || '').trim(),
        String(branches || '').trim(),
        req.file ? req.file.filename : null,
      ]
    );

    const insertedTenant = insertResult.rows[0];

    try {
      await client.query(
        `
        SELECT log_admin_audit_event(
          $1::uuid,
          $2::text,
          $3::uuid,
          $4::text,
          NULL::uuid,
          $5::jsonb
        )
        `,
        [
          ctx.user.id,
          'tenant.created',
          insertedTenant.id,
          'tenant',
          JSON.stringify({
            name: insertedTenant.name,
            rut: insertedTenant.rut,
            source: 'admin_saas',
          }),
        ]
      );
    } catch (auditError) {
      console.warn('WARN log_admin_audit_event tenant.created:', auditError.message);
    }

    await client.query('COMMIT');

    const verifyResult = await pool.query(
      `
      SELECT *
      FROM tenants
      WHERE id = $1::uuid
      LIMIT 1
      `,
      [insertedTenant.id]
    );

    const verifiedTenant = verifyResult.rows[0] || null;

    if (!verifiedTenant) {
      console.error('TENANT CREATE PERSISTENCE MISMATCH:', {
        inserted: insertedTenant,
      });

      return res.status(500).json({
        ok: false,
        error: 'La empresa fue creada por el endpoint, pero no se confirmó persistencia real en BD',
        detail: 'tenant_create_persistence_mismatch',
        inserted_tenant_id: insertedTenant.id,
      });
    }

    return res.json({
      ok: true,
      data: {
        ...verifiedTenant,
        tenant_id: verifiedTenant.id,
        tenant_name: verifiedTenant.name,
      },
    });
  } catch (error) {
    try {
      await client.query('ROLLBACK');
    } catch {}

    console.error('ERROR CREATE TENANT ADMIN SAAS:', error);

    if (error.code === '23505') {
      return res.status(409).json({
        ok: false,
        error: 'Ya existe una empresa con esos datos',
        detail: error.message,
      });
    }

    return res.status(500).json({
      ok: false,
      error: 'Error creando empresa desde Administración SaaS',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});


