// =====================================================
router.get('/tenants/:tenant_id', auth, async (req, res) => {
  try {
    const { tenant_id } = req.params;
    const ctx = await requireAdminSaasView(req, res, { allowDealer: true });
    if (!ctx) return;

    const allowed = await ensureTenantVisibility(ctx, tenant_id);
    if (!allowed) {
      return res.status(403).json({
        ok: false,
        error: 'No autorizado para ver esta empresa',
      });
    }

    const detail = await getTenantDetail(tenant_id);

    if (!detail.tenant) {
      return res.status(404).json({
        ok: false,
        error: 'Empresa no encontrada',
      });
    }

    return res.json({
      ok: true,
      scope: {
        user_id: ctx.user.id,
        role: ctx.role,
        is_platform: ctx.isPlatform,
        is_dealer: ctx.isDealer,
      },
      data: detail,
    });
  } catch (error) {
    console.error('ERROR GET TENANT DETAIL:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo detalle de empresa',
      detail: error.message,
    });
  }
});


// =====================================================
// GET /api/admin-saas/dealers
// Lista usuarios dealer/partner.
// =====================================================
router.get('/dealers', auth, async (req, res) => {
  try {
    const ctx = await requireAdminSaasView(req, res);
    if (!ctx) return;

    const result = await pool.query(
      `
      SELECT
        u.id,
        u.email,
        u.full_name,
        u.role,
        COALESCE(dt.active_tenants, 0)::int AS active_tenants
      FROM users u
      LEFT JOIN (
        SELECT
          dealer_user_id,
          COUNT(*) FILTER (WHERE status = 'active')::int AS active_tenants
        FROM dealer_tenants
        GROUP BY dealer_user_id
      ) dt
        ON dt.dealer_user_id = u.id
      WHERE lower(COALESCE(u.role, '')) = 'dealer'
      ORDER BY u.email
      `
    );

    return res.json({
      ok: true,
      data: result.rows,
    });
  } catch (error) {
    console.error('ERROR GET ADMIN SAAS DEALERS:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo dealers',
      detail: error.message,
    });
  }
});

// =====================================================
// GET /api/admin-saas/audit-log
// Bitácora administrativa. Si la tabla aún no existe, devuelve [].
// =====================================================
router.get('/audit-log', auth, async (req, res) => {
  try {
    const ctx = await requireAdminSaasView(req, res, { allowDealer: true });
    if (!ctx) return;

    const tenantId = req.query.tenant_id || null;
    const limit = Math.min(Number(req.query.limit || 50), 200);

    const exists = await pool.query(
      `SELECT to_regclass('public.admin_audit_log')::text AS table_name`
    );

    if (!exists.rows[0]?.table_name) {
      return res.json({
        ok: true,
        data: [],
      });
    }

    const params = [];
    const conditions = ['1 = 1'];

    if (tenantId) {
      params.push(tenantId);
      conditions.push(`tenant_id = $${params.length}::uuid`);
    }

    params.push(limit);

    const result = await pool.query(
      `
      SELECT *
      FROM admin_audit_log
      WHERE ${conditions.join(' AND ')}
      ORDER BY created_at DESC
      LIMIT $${params.length}
      `,
      params
    );

    return res.json({
      ok: true,
      data: result.rows,
    });
  } catch (error) {
    console.error('ERROR GET ADMIN SAAS AUDIT LOG:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo bitácora administrativa',
      detail: error.message,
    });
  }
});

