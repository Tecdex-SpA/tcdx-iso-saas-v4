const express = require('express');
const router = express.Router();
const pool = require('../config/db');
const auth = require('../middleware/auth');

function getUserId(req) {
  return req.user?.id || req.user?.user_id || req.user?.userId || null;
}

function getRole(req) {
  return String(req.user?.role || '').toLowerCase();
}

function isSuperAdmin(req) {
  return getRole(req) === 'superadmin';
}

function isDealer(req) {
  return getRole(req) === 'dealer';
}

function canUseQuotes(req) {
  return isSuperAdmin(req) || isDealer(req);
}

function money(value) {
  const n = Number(value || 0);
  return Number.isFinite(n) ? Math.round(n) : 0;
}

function makeQuoteNumber() {
  const d = new Date();
  const y = d.getUTCFullYear();
  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
  const rand = Math.random().toString(36).slice(2, 8).toUpperCase();
  return `COT-${y}${m}-${rand}`;
}

async function getPriceMap(client = pool) {
  const result = await client.query(`
    SELECT *
    FROM saas_price_catalog
    WHERE is_active = TRUE
    ORDER BY item_type, item_key
  `);

  const map = {};

  for (const row of result.rows) {
    map[`${row.item_type}:${row.item_key}`] = row;
  }

  return { rows: result.rows, map };
}

async function calculateQuote(payload, client = pool) {
  const { map } = await getPriceMap(client);

  const planKey = String(payload.plan_key || 'pyme').trim();
  const standardsCount = Math.max(Number(payload.active_standards_count || 0), 0);
  const modulesCount = Math.max(Number(payload.premium_modules_count || 0), 0);
  const externalLookupQuota = Math.max(Number(payload.external_lookup_quota || 0), 0);
  const discountAmount = Math.max(Number(payload.discount_amount || 0), 0);

  const planPrice = map[`plan_base:${planKey}`] || map['plan_base:pyme'];
  const standardPrice = map['standard:standard_active'];
  const modulePrice = map['module:premium_module'];

  const lines = [];

  if (planPrice) {
    lines.push({
      line_type: 'plan_base',
      line_key: planKey,
      line_name: planPrice.item_name || `Plan ${planKey}`,
      line_description: planPrice.item_description || 'Plan base SaaS',
      quantity: 1,
      unit_price: money(planPrice.unit_price),
      subtotal_amount: money(planPrice.unit_price),
      is_billable: true,
      metadata: { price_catalog_id: planPrice.id },
    });
  }

  if (standardPrice && standardsCount > 0) {
    lines.push({
      line_type: 'standard',
      line_key: 'standard_active',
      line_name: 'Normas ISO activas',
      line_description: 'Cargo mensual referencial por normas ISO contratadas',
      quantity: standardsCount,
      unit_price: money(standardPrice.unit_price),
      subtotal_amount: money(standardsCount * Number(standardPrice.unit_price || 0)),
      is_billable: true,
      metadata: { price_catalog_id: standardPrice.id },
    });
  }

  if (modulePrice && modulesCount > 0) {
    lines.push({
      line_type: 'module',
      line_key: 'premium_module',
      line_name: 'Módulos premium',
      line_description: 'Cargo mensual referencial por módulos adicionales',
      quantity: modulesCount,
      unit_price: money(modulePrice.unit_price),
      subtotal_amount: money(modulesCount * Number(modulePrice.unit_price || 0)),
      is_billable: true,
      metadata: { price_catalog_id: modulePrice.id },
    });
  }

  lines.push({
    line_type: 'quota_info',
    line_key: 'external_lookup_quota',
    line_name: 'Cuota IA / respaldo externo incluida',
    line_description: 'Línea informativa. La cuota incluida no se cobra como adicional.',
    quantity: externalLookupQuota,
    unit_price: 0,
    subtotal_amount: 0,
    is_billable: false,
    metadata: { quota: externalLookupQuota },
  });

  const subtotal = money(
    lines.reduce((acc, line) => acc + (line.is_billable ? Number(line.subtotal_amount || 0) : 0), 0)
  );

  const total = Math.max(subtotal - discountAmount, 0);

  return {
    currency: 'CLP',
    plan_key: planKey,
    active_standards_count: standardsCount,
    premium_modules_count: modulesCount,
    external_lookup_quota: externalLookupQuota,
    subtotal_amount: subtotal,
    discount_amount: money(discountAmount),
    tax_amount: 0,
    total_monthly_amount: money(total),
    lines,
  };
}

// =====================================================
// GET /api/quotes/prices
// =====================================================
router.get('/prices', auth, async (req, res) => {
  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const { rows } = await getPriceMap();

    return res.json({
      ok: true,
      data: rows,
    });
  } catch (error) {
    console.error('ERROR GET QUOTE PRICES:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo precios para cotizador',
      detail: error.message,
    });
  }
});

// =====================================================
// POST /api/quotes/calculate
// =====================================================
router.post('/calculate', auth, async (req, res) => {
  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const calculated = await calculateQuote(req.body || {});

    return res.json({
      ok: true,
      data: calculated,
    });
  } catch (error) {
    console.error('ERROR CALCULATE QUOTE:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error calculando cotización',
      detail: error.message,
    });
  }
});

// =====================================================
// GET /api/quotes
// Superadmin ve todas. Dealer ve solo las propias.
// =====================================================
router.get('/', auth, async (req, res) => {
  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const params = [];
    const where = [];

    if (isDealer(req) && !isSuperAdmin(req)) {
      params.push(getUserId(req));
      where.push(`q.dealer_user_id = $${params.length}::uuid`);
    }

    const search = String(req.query.search || '').trim();

    if (search) {
      params.push(`%${search}%`);
      where.push(`
        (
          q.quote_number ILIKE $${params.length}
          OR q.prospect_name ILIKE $${params.length}
          OR COALESCE(q.prospect_rut, '') ILIKE $${params.length}
          OR COALESCE(q.crm_reference, '') ILIKE $${params.length}
        )
      `);
    }

    const whereSql = where.length ? `WHERE ${where.join(' AND ')}` : '';

    const result = await pool.query(
      `
      SELECT
        q.*,
        creator.email AS created_by_email,
        dealer.email AS dealer_email,
        t.name AS tenant_name
      FROM saas_quotes q
      LEFT JOIN users creator ON creator.id = q.created_by_user_id
      LEFT JOIN users dealer ON dealer.id = q.dealer_user_id
      LEFT JOIN tenants t ON t.id = q.tenant_id
      ${whereSql}
      ORDER BY q.created_at DESC
      LIMIT 100
      `,
      params
    );

    return res.json({
      ok: true,
      data: result.rows,
    });
  } catch (error) {
    console.error('ERROR LIST QUOTES:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error listando cotizaciones',
      detail: error.message,
    });
  }
});

// =====================================================
// GET /api/quotes/:id
// =====================================================
router.get('/:id', auth, async (req, res) => {
  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const quoteResult = await pool.query(
      `
      SELECT *
      FROM saas_quotes
      WHERE id = $1::uuid
      LIMIT 1
      `,
      [req.params.id]
    );

    const quote = quoteResult.rows[0];

    if (!quote) {
      return res.status(404).json({
        ok: false,
        error: 'Cotización no encontrada',
      });
    }

    if (isDealer(req) && !isSuperAdmin(req) && String(quote.dealer_user_id) !== String(getUserId(req))) {
      return res.status(403).json({
        ok: false,
        error: 'No autorizado para ver esta cotización',
      });
    }

    const linesResult = await pool.query(
      `
      SELECT *
      FROM saas_quote_lines
      WHERE quote_id = $1::uuid
      ORDER BY created_at
      `,
      [quote.id]
    );

    return res.json({
      ok: true,
      data: {
        quote,
        lines: linesResult.rows,
      },
    });
  } catch (error) {
    console.error('ERROR GET QUOTE:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo cotización',
      detail: error.message,
    });
  }
});

// =====================================================
// POST /api/quotes
// Guarda cotización.
// =====================================================
router.post('/', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const body = req.body || {};
    const prospectName = String(body.prospect_name || '').trim();

    if (!prospectName) {
      return res.status(400).json({
        ok: false,
        error: 'Nombre del prospecto/empresa es obligatorio',
      });
    }

    const calculated = await calculateQuote(body, client);

    const quoteNumber = makeQuoteNumber();
    const userId = getUserId(req);
    const dealerUserId = isDealer(req) ? userId : body.dealer_user_id || null;

    const validityDays = Math.max(Number(body.validity_days || 15), 1);

    await client.query('BEGIN');

    const quoteResult = await client.query(
      `
      INSERT INTO saas_quotes (
        quote_number,
        tenant_id,
        prospect_name,
        prospect_rut,
        prospect_email,
        prospect_phone,
        created_by_user_id,
        dealer_user_id,
        status,
        currency,
        plan_key,
        active_standards_count,
        premium_modules_count,
        external_lookup_quota,
        subtotal_amount,
        discount_amount,
        tax_amount,
        total_monthly_amount,
        validity_days,
        valid_until,
        notes,
        crm_reference,
        metadata,
        created_at,
        updated_at
      )
      VALUES (
        $1::text,
        NULLIF($2::text, '')::uuid,
        $3::text,
        $4::text,
        $5::text,
        $6::text,
        $7::uuid,
        NULLIF($8::text, '')::uuid,
        'draft',
        $9::text,
        $10::text,
        $11::int,
        $12::int,
        $13::int,
        $14::numeric,
        $15::numeric,
        $16::numeric,
        $17::numeric,
        $18::int,
        now()::date + ($18::int || ' days')::interval,
        $19::text,
        $20::text,
        $21::jsonb,
        now(),
        now()
      )
      RETURNING *
      `,
      [
        quoteNumber,
        body.tenant_id || '',
        prospectName,
        body.prospect_rut || null,
        body.prospect_email || null,
        body.prospect_phone || null,
        userId,
        dealerUserId || '',
        calculated.currency,
        calculated.plan_key,
        calculated.active_standards_count,
        calculated.premium_modules_count,
        calculated.external_lookup_quota,
        calculated.subtotal_amount,
        calculated.discount_amount,
        calculated.tax_amount,
        calculated.total_monthly_amount,
        validityDays,
        body.notes || null,
        body.crm_reference || null,
        JSON.stringify({
          source: 'cotizador',
          created_by_role: getRole(req),
        }),
      ]
    );

    const quote = quoteResult.rows[0];

    for (const line of calculated.lines) {
      await client.query(
        `
        INSERT INTO saas_quote_lines (
          quote_id,
          line_type,
          line_key,
          line_name,
          line_description,
          quantity,
          unit_price,
          subtotal_amount,
          is_billable,
          metadata
        )
        VALUES (
          $1::uuid,
          $2::text,
          $3::text,
          $4::text,
          $5::text,
          $6::numeric,
          $7::numeric,
          $8::numeric,
          $9::boolean,
          $10::jsonb
        )
        `,
        [
          quote.id,
          line.line_type,
          line.line_key,
          line.line_name,
          line.line_description,
          line.quantity,
          line.unit_price,
          line.subtotal_amount,
          line.is_billable,
          JSON.stringify(line.metadata || {}),
        ]
      );
    }

    try {
      await client.query(
        `
        SELECT log_admin_audit_event(
          $1::uuid,
          $2::text,
          NULL::uuid,
          $3::text,
          $4::uuid,
          $5::jsonb
        )
        `,
        [
          userId,
          'saas_quote.created',
          'saas_quote',
          quote.id,
          JSON.stringify({
            quote_number: quote.quote_number,
            prospect_name: quote.prospect_name,
            total_monthly_amount: quote.total_monthly_amount,
          }),
        ]
      );
    } catch (auditError) {
      console.warn('WARN log_admin_audit_event quote:', auditError.message);
    }

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: quote,
    });
  } catch (error) {
    try {
      await client.query('ROLLBACK');
    } catch {}

    console.error('ERROR CREATE QUOTE:', error);

    return res.status(500).json({
      ok: false,
      error: 'Error creando cotización',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});

// =====================================================
// PUT /api/quotes/:id/status
// =====================================================
router.put('/:id/status', auth, async (req, res) => {
  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const status = String(req.body?.status || '').trim();
    const allowed = ['draft', 'sent', 'accepted', 'rejected', 'expired'];

    if (!allowed.includes(status)) {
      return res.status(400).json({
        ok: false,
        error: `Estado inválido. Permitidos: ${allowed.join(', ')}`,
      });
    }

    const quoteResult = await pool.query(
      `SELECT * FROM saas_quotes WHERE id = $1::uuid LIMIT 1`,
      [req.params.id]
    );

    const quote = quoteResult.rows[0];

    if (!quote) {
      return res.status(404).json({
        ok: false,
        error: 'Cotización no encontrada',
      });
    }

    if (isDealer(req) && !isSuperAdmin(req) && String(quote.dealer_user_id) !== String(getUserId(req))) {
      return res.status(403).json({
        ok: false,
        error: 'No autorizado para modificar esta cotización',
      });
    }

    const result = await pool.query(
      `
      UPDATE saas_quotes
      SET
        status = $2::text,
        updated_at = now()
      WHERE id = $1::uuid
      RETURNING *
      `,
      [req.params.id, status]
    );

    return res.json({
      ok: true,
      data: result.rows[0],
    });
  } catch (error) {
    console.error('ERROR UPDATE QUOTE STATUS:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error actualizando estado de cotización',
      detail: error.message,
    });
  }
});

module.exports = router;
