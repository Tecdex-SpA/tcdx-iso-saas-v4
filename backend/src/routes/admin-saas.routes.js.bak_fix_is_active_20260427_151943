// =====================================================
// PUT /api/admin-saas/tenants/:tenant_id/modules/:module_key
// =====================================================
router.put('/tenants/:tenant_id/modules/:module_key', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { tenant_id, module_key } = req.params;
    const { is_enabled, notes = null, metadata = {} } = req.body;

    if (typeof is_enabled !== 'boolean') {
      return res.status(400).json({
        ok: false,
        error: 'is_enabled debe ser boolean',
      });
    }

    await client.query('BEGIN');

    const existingModule = await getTenantModule(tenant_id, module_key, client);

    if (!existingModule) {
      await client.query('ROLLBACK');
      return res.status(404).json({
        ok: false,
        error: 'Módulo no encontrado para la empresa',
      });
    }

    await client.query(
      `
      INSERT INTO tenant_modules (
        tenant_id,
        module_key,
        is_enabled,
        enabled_at,
        disabled_at,
        notes,
        metadata
      )
      VALUES (
        $1::uuid,
        $2::text,
        $3::boolean,
        CASE WHEN $3 THEN NOW() ELSE NULL END,
        CASE WHEN NOT $3 THEN NOW() ELSE NULL END,
        $4::text,
        $5::jsonb
      )
      ON CONFLICT (tenant_id, module_key)
      DO UPDATE SET
        is_enabled = EXCLUDED.is_enabled,
        enabled_at = CASE
          WHEN EXCLUDED.is_enabled THEN COALESCE(tenant_modules.enabled_at, NOW())
          ELSE tenant_modules.enabled_at
        END,
        disabled_at = CASE
          WHEN EXCLUDED.is_enabled THEN NULL
          ELSE NOW()
        END,
        notes = EXCLUDED.notes,
        metadata = EXCLUDED.metadata,
        updated_at = NOW()
      `,
      [tenant_id, module_key, is_enabled, notes, metadata]
    );

    const updatedModule = await getTenantModule(tenant_id, module_key, client);

    await client.query(
      `
      SELECT log_admin_audit_event(
        $1::uuid,
        $2::text,
        $3::uuid,
        $4::text,
        NULL::uuid,
        $5::jsonb
      )
      `,
      [
        ctx.user.id,
        'tenant_module.updated',
        tenant_id,
        module_key,
        JSON.stringify({
          is_enabled,
          notes,
          metadata,
        }),
      ]
    );

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: updatedModule,
    });
  } catch (error) {
    await client.query('ROLLBACK');
    console.error('ERROR UPDATE TENANT MODULE:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error actualizando módulo del tenant',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});

// =====================================================
// PUT /api/admin-saas/tenants/:tenant_id/standards/:standard_code
// =====================================================
router.put('/tenants/:tenant_id/standards/:standard_code', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { tenant_id, standard_code } = req.params;
    const {
      is_active,
      initialize_controls = false,
      refresh_health = false,
    } = req.body;

    if (typeof is_active !== 'boolean') {
      return res.status(400).json({
        ok: false,
        error: 'is_active debe ser boolean',
      });
    }

    const standardCode = String(standard_code || '').trim().toUpperCase();

    await client.query('BEGIN');

    const existing = await client.query(
      `
      SELECT tenant_id, standard_code, is_active
      FROM tenant_standards
      WHERE tenant_id = $1::uuid
        AND standard_code = $2::text
      LIMIT 1
      `,
      [tenant_id, standardCode]
    );

    if (existing.rowCount > 0) {
      await client.query(
        `
        UPDATE tenant_standards
        SET is_active = $3::boolean
        WHERE tenant_id = $1::uuid
          AND standard_code = $2::text
        `,
        [tenant_id, standardCode, is_active]
      );
    } else {
      await client.query(
        `
        INSERT INTO tenant_standards (
          tenant_id,
          standard_code,
          is_active
        )
        VALUES ($1::uuid, $2::text, $3::boolean)
        `,
        [tenant_id, standardCode, is_active]
      );
    }

    let initializedControls = 0;
    let cleanup = null;
    let refresh = null;

    if (is_active === true && initialize_controls === true) {
      initializedControls = await initializeTenantControlsForStandard(
        client,
        tenant_id,
        standardCode
      );
    }

    if (is_active === false) {
      cleanup = await cleanupInactiveStandardOperationalData(
        client,
        tenant_id,
        standardCode
      );
    }

    if (refresh_health === true) {
      refresh = await refreshTenantHealth(client, tenant_id);
    }

    const newStandard = await getTenantStandard(tenant_id, standardCode, client);

    await client.query(
      `
      SELECT log_admin_audit_event(
        $1::uuid,
        $2::text,
        $3::uuid,
        $4::text,
        NULL::uuid,
        $5::jsonb
      )
      `,
      [
        ctx.user.id,
        'tenant_standard.updated',
        tenant_id,
        standardCode,
        JSON.stringify({
          is_active,
          initialize_controls,
          refresh_health,
          initialized_controls: initializedControls,
          cleanup,
        }),
      ]
    );

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: newStandard,
      initialized_controls: initializedControls,
      cleanup,
      refresh,
    });
  } catch (error) {
    await client.query('ROLLBACK');
    console.error('ERROR UPDATE TENANT STANDARD:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error actualizando norma del tenant',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});

