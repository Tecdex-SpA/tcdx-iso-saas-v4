const express = require('express');
const router = express.Router();
const pool = require('../config/db');
const auth = require('../middleware/auth');

function getUserId(user) {
  return user?.user_id || user?.userId || user?.id || null;
}

function getUserEmail(user) {
  return user?.email || null;
}

function normalizeRole(role) {
  return String(role || '').toLowerCase();
}

function isPlatformRole(role) {
  return ['superadmin', 'platform_admin'].includes(normalizeRole(role));
}

async function getCurrentDbUser(req) {
  const userId = getUserId(req.user);
  const email = getUserEmail(req.user);

  if (userId) {
    const result = await pool.query(
      `
      SELECT
        id,
        email,
        full_name,
        role,
        tenant_id
      FROM users
      WHERE id = $1
      LIMIT 1
      `,
      [userId]
    );

    if (result.rowCount > 0) return result.rows[0];
  }

  if (email) {
    const result = await pool.query(
      `
      SELECT
        id,
        email,
        full_name,
        role,
        tenant_id
      FROM users
      WHERE email = $1
      LIMIT 1
      `,
      [email]
    );

    if (result.rowCount > 0) return result.rows[0];
  }

  return null;
}

async function userHasPermission(userId, permissionKey) {
  if (!userId || !permissionKey) return false;

  const result = await pool.query(
    `SELECT user_has_permission($1::uuid, $2::text) AS allowed`,
    [userId, permissionKey]
  );

  return result.rows[0]?.allowed === true;
}

async function getAdminContext(req) {
  const user = await getCurrentDbUser(req);

  if (!user) {
    return {
      user: null,
      role: '',
      isPlatform: false,
      isDealer: false,
      canViewAdminSaas: false,
      canManageAdminSaas: false,
    };
  }

  const role = normalizeRole(user.role);
  const isPlatform = isPlatformRole(role);
  const isDealer = role === 'dealer';

  const [canViewAdminSaas, canManageAdminSaas] = await Promise.all([
    userHasPermission(user.id, 'admin_saas.view'),
    userHasPermission(user.id, 'admin_saas.manage'),
  ]);

  return {
    user,
    role,
    isPlatform,
    isDealer,
    canViewAdminSaas,
    canManageAdminSaas,
  };
}

async function requireAdminSaasView(req, res, options = {}) {
  const ctx = await getAdminContext(req);
  const allowDealer = options.allowDealer === true;

  if (!ctx.user) {
    res.status(401).json({
      ok: false,
      error: 'Usuario no encontrado',
    });
    return null;
  }

  if (ctx.isPlatform || ctx.canViewAdminSaas) {
    return ctx;
  }

  if (allowDealer && ctx.isDealer) {
    return ctx;
  }

  res.status(403).json({
    ok: false,
    error: 'No autorizado para ver Administración SaaS',
  });

  return null;
}

async function requireAdminSaasManage(req, res) {
  const ctx = await getAdminContext(req);

  if (!ctx.user) {
    res.status(401).json({
      ok: false,
      error: 'Usuario no encontrado',
    });
    return null;
  }

  if (ctx.isPlatform || ctx.canManageAdminSaas) {
    return ctx;
  }

  res.status(403).json({
    ok: false,
    error: 'No autorizado para administrar SaaS',
  });

  return null;
}

async function requireDealerOrPlatform(req, res) {
  const ctx = await getAdminContext(req);

  if (!ctx.user) {
    res.status(401).json({
      ok: false,
      error: 'Usuario no encontrado',
    });
    return null;
  }

  if (ctx.isPlatform || ctx.isDealer) {
    return ctx;
  }

  res.status(403).json({
    ok: false,
    error: 'No autorizado para acceder al portal Dealer',
  });

  return null;
}

async function ensureTenantVisibility(ctx, tenantId) {
  if (!ctx?.user || !tenantId) return false;

  if (ctx.isPlatform || ctx.canViewAdminSaas) return true;

  if (ctx.isDealer) {
    const result = await pool.query(
      `
      SELECT 1
      FROM dealer_tenants
      WHERE dealer_user_id = $1
        AND tenant_id = $2
        AND status = 'active'
      LIMIT 1
      `,
      [ctx.user.id, tenantId]
    );

    return result.rowCount > 0;
  }

  return false;
}

async function getTenantModule(tenantId, moduleKey, client = pool) {
  const result = await client.query(
    `
    SELECT
      tenant_id,
      tenant_name,
      module_key,
      module_name,
      module_description,
      sort_order,
      is_enabled,
      enabled_at,
      disabled_at,
      notes,
      metadata
    FROM v_tenant_modules
    WHERE tenant_id = $1::uuid
      AND module_key = $2::text
    LIMIT 1
    `,
    [tenantId, moduleKey]
  );

  return result.rows[0] || null;
}

async function getTenantStandard(tenantId, standardCode, client = pool) {
  const result = await client.query(
    `
    SELECT
      ts.tenant_id,
      t.name AS tenant_name,
      ts.standard_code AS code,
      COALESCE(s.name, ts.standard_code) AS name,
      ts.is_active,
      COUNT(tc.id)::int AS tenant_controls
    FROM tenant_standards ts
    JOIN tenants t
      ON t.id = ts.tenant_id
    LEFT JOIN standards s
      ON s.code = ts.standard_code
    LEFT JOIN controls_catalog cc
      ON cc.iso = ts.standard_code
     AND cc.is_active = TRUE
    LEFT JOIN tenant_controls tc
      ON tc.tenant_id = ts.tenant_id
     AND tc.control_id = cc.id
    WHERE ts.tenant_id = $1::uuid
      AND ts.standard_code = $2::text
    GROUP BY
      ts.tenant_id,
      t.name,
      ts.standard_code,
      s.name,
      ts.is_active
    LIMIT 1
    `,
    [tenantId, standardCode]
  );

  return result.rows[0] || null;
}

async function getTenantDetail(tenantId) {
  const [
    tenantResult,
    summaryResult,
    contractResult,
    standardsResult,
    modulesResult,
    usersResult,
    dealersResult,
  ] = await Promise.all([
    pool.query(
      `
      SELECT *
      FROM tenants
      WHERE id = $1::uuid
      LIMIT 1
      `,
      [tenantId]
    ),

    pool.query(
      `
      SELECT *
      FROM v_tenant_governance_summary
      WHERE tenant_id = $1::uuid
      LIMIT 1
      `,
      [tenantId]
    ),

    pool.query(
      `
      SELECT
        id,
        tenant_id,
        plan_key,
        contract_status,
        started_at,
        ends_at,
        billing_notes,
        commercial_owner_user_id,
        metadata,
        created_at,
        updated_at
      FROM tenant_contracts
      WHERE tenant_id = $1::uuid
      ORDER BY created_at DESC
      LIMIT 1
      `,
      [tenantId]
    ),

    pool.query(
      `
      SELECT
        ts.tenant_id,
        ts.standard_code AS code,
        COALESCE(s.name, ts.standard_code) AS name,
        ts.is_active,
        COUNT(tc.id)::int AS tenant_controls
      FROM tenant_standards ts
      LEFT JOIN standards s
        ON s.code = ts.standard_code
      LEFT JOIN controls_catalog cc
        ON cc.iso = ts.standard_code
       AND cc.is_active = TRUE
      LEFT JOIN tenant_controls tc
        ON tc.tenant_id = ts.tenant_id
       AND tc.control_id = cc.id
      WHERE ts.tenant_id = $1::uuid
      GROUP BY
        ts.tenant_id,
        ts.standard_code,
        s.name,
        ts.is_active
      ORDER BY ts.standard_code
      `,
      [tenantId]
    ),

    pool.query(
      `
      SELECT
        tenant_id,
        tenant_name,
        module_key,
        module_name,
        module_description,
        sort_order,
        is_enabled,
        enabled_at,
        disabled_at,
        notes,
        metadata
      FROM v_tenant_modules
      WHERE tenant_id = $1::uuid
      ORDER BY sort_order, module_key
      `,
      [tenantId]
    ),

    pool.query(
      `
      SELECT
        id,
        email,
        full_name,
        role,
        tenant_id,
        is_active,
        created_at
      FROM users
      WHERE tenant_id = $1::uuid
      ORDER BY created_at DESC, email
      `,
      [tenantId]
    ),

    pool.query(
      `
      SELECT
        dealer_user_id,
        dealer_email,
        dealer_name,
        tenant_id,
        tenant_name,
        can_view_admin_saas,
        can_manage_modules,
        can_manage_standards,
        can_view_contract,
        can_request_changes,
        can_view_sensitive_evidence,
        status,
        assigned_at,
        revoked_at
      FROM v_dealer_tenants
      WHERE tenant_id = $1::uuid
      ORDER BY dealer_name
      `,
      [tenantId]
    ),
  ]);

  return {
    tenant: tenantResult.rows[0] || null,
    summary: summaryResult.rows[0] || null,
    contract: contractResult.rows[0] || null,
    standards: standardsResult.rows,
    modules: modulesResult.rows,
    users: usersResult.rows,
    dealers: dealersResult.rows,
  };
}

async function initializeTenantControlsForStandard(client, tenantId, standardCode) {
  const result = await client.query(
    `
    INSERT INTO tenant_controls (
      tenant_id,
      control_id
    )
    SELECT
      $1::uuid AS tenant_id,
      cc.id AS control_id
    FROM controls_catalog cc
    WHERE cc.iso = $2::text
      AND cc.is_active = TRUE
      AND NOT EXISTS (
        SELECT 1
        FROM tenant_controls tc
        WHERE tc.tenant_id = $1::uuid
          AND tc.control_id = cc.id
      )
    RETURNING id
    `,
    [tenantId, standardCode]
  );

  return result.rowCount;
}

async function cleanupInactiveStandardOperationalData(client, tenantId, standardCode) {
  const dimensionDelete = await client.query(
    `
    DELETE FROM kpi_snapshot_dimensions ksd
    USING kpi_snapshots ks
    WHERE ksd.snapshot_id = ks.id
      AND ks.tenant_id = $1::uuid
      AND ks.standard_code = $2::text
    `,
    [tenantId, standardCode]
  );

  const snapshotDelete = await client.query(
    `
    DELETE FROM kpi_snapshots
    WHERE tenant_id = $1::uuid
      AND standard_code = $2::text
    `,
    [tenantId, standardCode]
  );

  const healthDelete = await client.query(
    `
    DELETE FROM control_health_scores
    WHERE tenant_id = $1::uuid
      AND standard_code = $2::text
    `,
    [tenantId, standardCode]
  );

  return {
    deleted_snapshot_dimensions: dimensionDelete.rowCount,
    deleted_snapshots: snapshotDelete.rowCount,
    deleted_health_scores: healthDelete.rowCount,
  };
}

async function refreshTenantHealth(client, tenantId) {
  const result = await client.query(
    `
    SELECT refresh_tenant_control_health($1::uuid) AS ok
    `,
    [tenantId]
  );

  return result.rows[0] || { ok: false };
}

// =====================================================
// GET /api/admin-saas/overview
// =====================================================
router.get('/overview', auth, async (req, res) => {
  try {
    const ctx = await requireAdminSaasView(req, res, { allowDealer: true });
    if (!ctx) return;

    const [summaryResult, contractsResult, modulesResult, standardsResult] =
      await Promise.all([
        pool.query(
          `
          SELECT *
          FROM v_admin_saas_summary
          LIMIT 1
          `
        ),
        pool.query(
          `
          SELECT *
          FROM v_tenant_contract_overview
          ORDER BY tenant_name
          `
        ),
        pool.query(
          `
          SELECT *
          FROM v_tenant_modules
          ORDER BY tenant_name, sort_order, module_key
          `
        ),
        pool.query(
          `
          SELECT
            ts.tenant_id,
            t.name AS tenant_name,
            ts.standard_code AS code,
            COALESCE(s.name, ts.standard_code) AS name,
            ts.is_active,
            COUNT(DISTINCT tc.id)::int AS tenant_controls,
            COUNT(DISTINCT chs.id)::int AS health_records
          FROM tenant_standards ts
          JOIN tenants t
            ON t.id = ts.tenant_id
          LEFT JOIN standards s
            ON s.code = ts.standard_code
          LEFT JOIN controls_catalog cc
            ON cc.iso = ts.standard_code
           AND cc.is_active = TRUE
          LEFT JOIN tenant_controls tc
            ON tc.tenant_id = ts.tenant_id
           AND tc.control_id = cc.id
          LEFT JOIN control_health_scores chs
            ON chs.tenant_id = ts.tenant_id
           AND chs.standard_code = ts.standard_code
          GROUP BY
            ts.tenant_id,
            t.name,
            ts.standard_code,
            s.name,
            ts.is_active
          ORDER BY t.name, ts.standard_code
          `
        ),
      ]);

    return res.json({
      ok: true,
      scope: {
        user_id: ctx.user.id,
        role: ctx.role,
        is_platform: ctx.isPlatform,
        is_dealer: ctx.isDealer,
      },
      summary: summaryResult.rows[0] || null,
      contracts: contractsResult.rows,
      modules: modulesResult.rows,
      standards: standardsResult.rows,
    });
  } catch (error) {
    console.error('ERROR GET ADMIN SAAS OVERVIEW:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo overview de Administración SaaS',
      detail: error.message,
    });
  }
});

