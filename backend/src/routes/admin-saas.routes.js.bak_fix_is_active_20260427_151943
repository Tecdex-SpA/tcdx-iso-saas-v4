router.get('/dealer/tenants', auth, async (req, res) => {
  try {
    const ctx = await requireDealerOrPlatform(req, res);
    if (!ctx) return;

    let query = `
      SELECT
        dealer_user_id,
        dealer_email,
        dealer_name,
        tenant_id,
        tenant_name,
        can_view_admin_saas,
        can_manage_modules,
        can_manage_standards,
