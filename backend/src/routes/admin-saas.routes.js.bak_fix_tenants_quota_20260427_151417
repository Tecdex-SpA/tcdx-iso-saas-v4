router.get('/dealer/tenants', auth, async (req, res) => {
  try {
    const ctx = await requireDealerOrPlatform(req, res);
    if (!ctx) return;

    let query = `
      SELECT
        dealer_user_id,
        dealer_email,
        dealer_name,
        tenant_id,
        tenant_name,
        can_view_admin_saas,
        can_manage_modules,
        can_manage_standards,
        can_view_contract,
        can_request_changes,
        can_view_sensitive_evidence,
        status,
        assigned_at,
        revoked_at
      FROM v_dealer_tenants
    `;
    const params = [];

    if (!ctx.isPlatform) {
      query += `
        WHERE dealer_user_id = $1::uuid
          AND status = 'active'
      `;
      params.push(ctx.user.id);
    }

    query += `
      ORDER BY tenant_name
    `;

    const result = await pool.query(query, params);

    return res.json({
      ok: true,
      scope: {
        user_id: ctx.user.id,
        role: ctx.role,
        is_platform: ctx.isPlatform,
        is_dealer: ctx.isDealer,
      },
      data: result.rows,
    });
  } catch (error) {
    console.error('ERROR GET DEALER TENANTS:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo empresas del dealer',
      detail: error.message,
    });
  }
});

