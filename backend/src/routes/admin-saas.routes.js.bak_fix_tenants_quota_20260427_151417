});

// =====================================================
// GET /api/admin-saas/tenants/:tenant_id
// =====================================================
router.get('/tenants/:tenant_id', auth, async (req, res) => {
  try {
    const { tenant_id } = req.params;
    const ctx = await requireAdminSaasView(req, res, { allowDealer: true });
    if (!ctx) return;

    const allowed = await ensureTenantVisibility(ctx, tenant_id);
    if (!allowed) {
      return res.status(403).json({
        ok: false,
        error: 'No autorizado para ver esta empresa',
      });
    }

    const detail = await getTenantDetail(tenant_id);

    if (!detail.tenant) {
      return res.status(404).json({
        ok: false,
        error: 'Empresa no encontrada',
      });
    }

    return res.json({
      ok: true,
      scope: {
        user_id: ctx.user.id,
        role: ctx.role,
        is_platform: ctx.isPlatform,
        is_dealer: ctx.isDealer,
      },
      data: detail,
    });
  } catch (error) {
    console.error('ERROR GET TENANT DETAIL:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo detalle de empresa',
      detail: error.message,
    });
  }
});

