// =====================================================
// GET /api/quotes
// Superadmin ve todas. Dealer ve solo las propias.
// =====================================================
router.get('/', auth, async (req, res) => {
  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const params = [];
    const where = [];

    if (isDealer(req) && !isSuperAdmin(req)) {
      params.push(getUserId(req));
      where.push(`q.dealer_user_id = $${params.length}::uuid`);
    }

    const search = String(req.query.search || '').trim();

    if (search) {
      params.push(`%${search}%`);
      where.push(`
        (
          q.quote_number ILIKE $${params.length}
          OR q.prospect_name ILIKE $${params.length}
          OR COALESCE(q.prospect_rut, '') ILIKE $${params.length}
          OR COALESCE(q.crm_reference, '') ILIKE $${params.length}
        )
      `);
    }

    const whereSql = where.length ? `WHERE ${where.join(' AND ')}` : '';

    const result = await pool.query(
      `
      SELECT
        q.*,
        creator.email AS created_by_email,
        dealer.email AS dealer_email,
        t.name AS tenant_name
      FROM saas_quotes q
      LEFT JOIN users creator ON creator.id = q.created_by_user_id
      LEFT JOIN users dealer ON dealer.id = q.dealer_user_id
      LEFT JOIN tenants t ON t.id = q.tenant_id
      ${whereSql}
      ORDER BY q.created_at DESC
      LIMIT 100
      `,
      params
    );

    return res.json({
      ok: true,
      data: result.rows,
    });
  } catch (error) {
    console.error('ERROR LIST QUOTES:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error listando cotizaciones',
      detail: error.message,
    });
  }
});

// =====================================================
// GET /api/quotes/:id
// =====================================================
router.get('/:id', auth, async (req, res) => {
  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const quoteResult = await pool.query(
      `
      SELECT *
      FROM saas_quotes
      WHERE id = $1::uuid
      LIMIT 1
      `,
      [req.params.id]
    );

    const quote = quoteResult.rows[0];

    if (!quote) {
      return res.status(404).json({
        ok: false,
        error: 'Cotización no encontrada',
      });
    }

    if (isDealer(req) && !isSuperAdmin(req) && String(quote.dealer_user_id) !== String(getUserId(req))) {
      return res.status(403).json({
        ok: false,
        error: 'No autorizado para ver esta cotización',
      });
    }

    const linesResult = await pool.query(
      `
      SELECT *
      FROM saas_quote_lines
      WHERE quote_id = $1::uuid
      ORDER BY created_at
      `,
      [quote.id]
    );

    return res.json({
      ok: true,
      data: {
        quote,
        lines: linesResult.rows,
      },
    });
  } catch (error) {
    console.error('ERROR GET QUOTE:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo cotización',
      detail: error.message,
    });
  }
});

// =====================================================
// POST /api/quotes
// Guarda cotización.
// =====================================================
router.post('/', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const body = req.body || {};
    const prospectName = String(body.prospect_name || '').trim();

    if (!prospectName) {
      return res.status(400).json({
        ok: false,
        error: 'Nombre del prospecto/empresa es obligatorio',
      });
    }

    const calculated = await calculateQuote(body, client);

    const quoteNumber = makeQuoteNumber();
    const userId = getUserId(req);
    const dealerUserId = isDealer(req) ? userId : body.dealer_user_id || null;

    const validityDays = Math.max(Number(body.validity_days || 15), 1);

    await client.query('BEGIN');

    const quoteResult = await client.query(
      `
      INSERT INTO saas_quotes (
        quote_number,
        tenant_id,
        prospect_name,
        prospect_rut,
        prospect_email,
        prospect_phone,
        created_by_user_id,
        dealer_user_id,
        status,
        currency,
        plan_key,
        active_standards_count,
        premium_modules_count,
        external_lookup_quota,
        subtotal_amount,
        discount_amount,
        tax_amount,
        total_monthly_amount,
        validity_days,
        valid_until,
        notes,
        crm_reference,
        metadata,
        created_at,
        updated_at
      )
      VALUES (
        $1::text,
        NULLIF($2::text, '')::uuid,
        $3::text,
        $4::text,
        $5::text,
        $6::text,
        $7::uuid,
        NULLIF($8::text, '')::uuid,
        'draft',
        $9::text,
        $10::text,
        $11::int,
        $12::int,
        $13::int,
        $14::numeric,
        $15::numeric,
        $16::numeric,
        $17::numeric,
        $18::int,
        now()::date + ($18::int || ' days')::interval,
        $19::text,
        $20::text,
        $21::jsonb,
        now(),
        now()
      )
      RETURNING *
      `,
      [
        quoteNumber,
        body.tenant_id || '',
        prospectName,
        body.prospect_rut || null,
        body.prospect_email || null,
        body.prospect_phone || null,
        userId,
        dealerUserId || '',
        calculated.currency,
        calculated.plan_key,
        calculated.active_standards_count,
        calculated.premium_modules_count,
        calculated.external_lookup_quota,
        calculated.subtotal_amount,
        calculated.discount_amount,
        calculated.tax_amount,
        calculated.total_monthly_amount,
        validityDays,
        body.notes || null,
        body.crm_reference || null,
        JSON.stringify({
          source: 'cotizador',
          created_by_role: getRole(req),
        }),
      ]
    );

    const quote = quoteResult.rows[0];

    for (const line of calculated.lines) {
      await client.query(
        `
        INSERT INTO saas_quote_lines (
          quote_id,
          line_type,
          line_key,
          line_name,
          line_description,
          quantity,
          unit_price,
          subtotal_amount,
          is_billable,
          metadata
        )
        VALUES (
          $1::uuid,
          $2::text,
          $3::text,
          $4::text,
          $5::text,
          $6::numeric,
          $7::numeric,
          $8::numeric,
          $9::boolean,
          $10::jsonb
        )
        `,
        [
          quote.id,
          line.line_type,
          line.line_key,
          line.line_name,
          line.line_description,
          line.quantity,
          line.unit_price,
          line.subtotal_amount,
          line.is_billable,
          JSON.stringify(line.metadata || {}),
        ]
      );
    }

    try {
      await client.query(
        `
        SELECT log_admin_audit_event(
          $1::uuid,
          $2::text,
          NULL::uuid,
          $3::text,
          $4::uuid,
          $5::jsonb
        )
        `,
        [
          userId,
          'saas_quote.created',
          'saas_quote',
          quote.id,
          JSON.stringify({
            quote_number: quote.quote_number,
            prospect_name: quote.prospect_name,
            total_monthly_amount: quote.total_monthly_amount,
          }),
        ]
      );
    } catch (auditError) {
      console.warn('WARN log_admin_audit_event quote:', auditError.message);
    }

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: quote,
    });
  } catch (error) {
    try {
      await client.query('ROLLBACK');
    } catch {}

    console.error('ERROR CREATE QUOTE:', error);

    return res.status(500).json({
      ok: false,
      error: 'Error creando cotización',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});

// =====================================================
// PUT /api/quotes/:id/status
// =====================================================
router.put('/:id/status', auth, async (req, res) => {
  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const status = String(req.body?.status || '').trim();
    const allowed = ['draft', 'sent', 'accepted', 'rejected', 'expired'];

    if (!allowed.includes(status)) {
      return res.status(400).json({
        ok: false,
        error: `Estado inválido. Permitidos: ${allowed.join(', ')}`,
      });
    }

    const quoteResult = await pool.query(
      `SELECT * FROM saas_quotes WHERE id = $1::uuid LIMIT 1`,
      [req.params.id]
    );

    const quote = quoteResult.rows[0];

    if (!quote) {
      return res.status(404).json({
        ok: false,
        error: 'Cotización no encontrada',
      });
    }

    if (isDealer(req) && !isSuperAdmin(req) && String(quote.dealer_user_id) !== String(getUserId(req))) {
      return res.status(403).json({
        ok: false,
        error: 'No autorizado para modificar esta cotización',
      });
    }

    const result = await pool.query(
      `
      UPDATE saas_quotes
      SET
        status = $2::text,
        updated_at = now()
      WHERE id = $1::uuid
      RETURNING *
      `,
      [req.params.id, status]
    );

    return res.json({
      ok: true,
      data: result.rows[0],
    });
  } catch (error) {
    console.error('ERROR UPDATE QUOTE STATUS:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error actualizando estado de cotización',
      detail: error.message,
    });
  }
});


// =====================================================
// POST /api/quotes/:id/convert-to-tenant
// Convierte una cotización aceptada en tenant + contrato SaaS.
// Solo superadmin.
// Modos:
// - create_new: crea tenant nuevo; falla si nombre/RUT ya existen.
// - use_existing: usa tenant_id enviado o tenant_id ya asociado a la cotización.
// - auto: usa tenant existente si está asociado; si no, intenta crear.
// =====================================================
router.post('/:id/convert-to-tenant', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    if (!isSuperAdmin(req)) {
      return res.status(403).json({
        ok: false,
        error: 'Solo superadmin puede convertir cotizaciones en empresas/contratos',
      });
    }

    const quoteId = req.params.id;
    const userId = getUserId(req);

    const conversionMode = String(req.body?.conversion_mode || 'auto').trim();
    const explicitTenantId = req.body?.tenant_id || null;

    const allowedModes = ['auto', 'create_new', 'use_existing'];

    if (!allowedModes.includes(conversionMode)) {
      return res.status(400).json({
        ok: false,
        error: `conversion_mode inválido. Permitidos: ${allowedModes.join(', ')}`,
      });
    }

    await client.query('BEGIN');

    const quoteResult = await client.query(
      `
      SELECT *
      FROM saas_quotes
      WHERE id = $1::uuid
      LIMIT 1
      `,
      [quoteId]
    );

    const quote = quoteResult.rows[0];

    if (!quote) {
      await client.query('ROLLBACK');
      return res.status(404).json({
        ok: false,
        error: 'Cotización no encontrada',
      });
    }

    if (quote.status === 'accepted' && quote.tenant_id) {
      await client.query('ROLLBACK');
      return res.status(409).json({
        ok: false,
        error: 'Esta cotización ya fue aceptada y asociada a una empresa',
        detail: {
          tenant_id: quote.tenant_id,
          quote_number: quote.quote_number,
        },
      });
    }

    let tenant = null;

    if (conversionMode === 'use_existing') {
      const targetTenantId = explicitTenantId || quote.tenant_id;

      if (!targetTenantId) {
        await client.query('ROLLBACK');
        return res.status(400).json({
          ok: false,
          error: 'Para usar empresa existente debes enviar tenant_id o la cotización debe tener tenant_id asociado',
        });
      }

      const tenantResult = await client.query(
        `
        SELECT *
        FROM tenants
        WHERE id = $1::uuid
        LIMIT 1
        `,
        [targetTenantId]
      );

      tenant = tenantResult.rows[0] || null;

      if (!tenant) {
        await client.query('ROLLBACK');
        return res.status(404).json({
          ok: false,
          error: 'Empresa existente no encontrada',
        });
      }
    }

    if (!tenant && conversionMode === 'auto' && quote.tenant_id) {
      const tenantResult = await client.query(
        `
        SELECT *
        FROM tenants
        WHERE id = $1::uuid
        LIMIT 1
        `,
        [quote.tenant_id]
      );

      tenant = tenantResult.rows[0] || null;
    }

    if (!tenant) {
      const cleanName = String(quote.prospect_name || '').trim();
      const cleanRut = String(quote.prospect_rut || '').trim();

      if (!cleanName) {
        await client.query('ROLLBACK');
        return res.status(400).json({
          ok: false,
          error: 'La cotización no tiene nombre de prospecto para crear empresa',
        });
      }

      const existingTenantResult = await client.query(
        `
        SELECT *
        FROM tenants
        WHERE lower(name) = lower($1::text)
           OR (
             $2::text <> ''
             AND lower(COALESCE(rut, '')) = lower($2::text)
           )
        LIMIT 1
        `,
        [cleanName, cleanRut]
      );

      const existingTenant = existingTenantResult.rows[0] || null;

      if (existingTenant && conversionMode === 'create_new') {
        await client.query('ROLLBACK');
        return res.status(409).json({
          ok: false,
          error: 'Ya existe una empresa con el mismo nombre o RUT. Usa conversión a empresa existente.',
          detail: {
            existing_tenant_id: existingTenant.id,
            existing_tenant_name: existingTenant.name,
            existing_tenant_rut: existingTenant.rut,
          },
        });
      }

      if (existingTenant && conversionMode === 'auto') {
        tenant = existingTenant;
      }

      if (!tenant) {
        const insertTenantResult = await client.query(
          `
          INSERT INTO tenants (
            name,
            rut,
            address,
            business,
            branches,
            created_at
          )
          VALUES (
            $1::text,
            $2::text,
            '',
            'Cliente SaaS creado desde cotización',
            'Casa matriz',
            now()
          )
          RETURNING *
          `,
          [
            cleanName,
            cleanRut || null,
          ]
        );

        tenant = insertTenantResult.rows[0];
      }
    }

    const now = new Date();
    const yyyy = now.getUTCFullYear();
    const mm = String(now.getUTCMonth() + 1).padStart(2, '0');
    const dd = String(now.getUTCDate()).padStart(2, '0');
    const startedAt = req.body?.started_at || `${yyyy}-${mm}-${dd}`;

    const contractResult = await client.query(
      `
      INSERT INTO tenant_contracts (
        tenant_id,
        plan_key,
        contract_status,
        started_at,
        ends_at,
        billing_currency,
        commercial_notes,
        crm_reference,
        metadata,
        created_at,
        updated_at
      )
      VALUES (
        $1::uuid,
        $2::text,
        'active',
        NULLIF($3::text, '')::date,
        NULLIF($4::text, '')::date,
        COALESCE($5::text, 'CLP'),
        $6::text,
        $7::text,
        $8::jsonb,
        now(),
        now()
      )
      RETURNING *
      `,
      [
        tenant.id,
        quote.plan_key || 'pyme',
        startedAt,
        req.body?.ends_at || null,
        quote.currency || 'CLP',
        quote.notes || 'Contrato creado desde cotización aceptada',
        quote.crm_reference || null,
        JSON.stringify({
          source: 'quote_conversion',
          conversion_mode: conversionMode,
          quote_id: quote.id,
          quote_number: quote.quote_number,
          converted_by: userId,
          active_standards_count: quote.active_standards_count,
          premium_modules_count: quote.premium_modules_count,
          external_lookup_quota: quote.external_lookup_quota,
          total_monthly_amount: quote.total_monthly_amount,
        }),
      ]
    );

    const contract = contractResult.rows[0];

    await client.query(
      `
      UPDATE saas_quotes
      SET
        tenant_id = $2::uuid,
        status = 'accepted',
        metadata = COALESCE(metadata, '{}'::jsonb) || $3::jsonb,
        updated_at = now()
      WHERE id = $1::uuid
      `,
      [
        quote.id,
        tenant.id,
        JSON.stringify({
          converted_to_tenant: true,
          conversion_mode: conversionMode,
          converted_tenant_id: tenant.id,
          converted_contract_id: contract.id,
          converted_at: new Date().toISOString(),
          converted_by: userId,
        }),
      ]
    );

    try {
      await client.query(
        `
        SELECT log_admin_audit_event(
          $1::uuid,
          $2::text,
          $3::uuid,
          $4::text,
          $5::uuid,
          $6::jsonb
        )
        `,
        [
          userId,
          'saas_quote.converted_to_tenant',
          tenant.id,
          'saas_quote',
          quote.id,
          JSON.stringify({
            quote_number: quote.quote_number,
            tenant_id: tenant.id,
            tenant_name: tenant.name,
            contract_id: contract.id,
            plan_key: contract.plan_key,
            conversion_mode: conversionMode,
            source: 'cotizador',
          }),
        ]
      );
    } catch (auditError) {
      console.warn('WARN log_admin_audit_event quote conversion:', auditError.message);
    }

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: {
        tenant,
        contract,
        quote_id: quote.id,
        quote_number: quote.quote_number,
        conversion_mode: conversionMode,
      },
    });
  } catch (error) {
    try {
      await client.query('ROLLBACK');
    } catch {}

    console.error('ERROR CONVERT QUOTE TO TENANT:', error);

    return res.status(500).json({
      ok: false,
      error: 'Error convirtiendo cotización en empresa/contrato',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});


module.exports = router;
