// POST /api/quotes/calculate
// =====================================================
router.post('/calculate', auth, async (req, res) => {
  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const calculated = await calculateQuote(req.body || {});

    return res.json({
      ok: true,
      data: calculated,
