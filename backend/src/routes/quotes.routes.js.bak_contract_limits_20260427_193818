const express = require('express');
const router = express.Router();
const pool = require('../config/db');
const auth = require('../middleware/auth');

function getUserId(req) {
  return req.user?.id || req.user?.user_id || req.user?.userId || null;
}

function getRole(req) {
  return String(req.user?.role || '').toLowerCase();
}

function isSuperAdmin(req) {
  return getRole(req) === 'superadmin';
}

function isDealer(req) {
  return getRole(req) === 'dealer';
}

function canUseQuotes(req) {
  return isSuperAdmin(req) || isDealer(req);
}

function money(value) {
  const n = Number(value || 0);
  return Number.isFinite(n) ? Math.round(n) : 0;
}

function makeQuoteNumber() {
  const d = new Date();
  const y = d.getUTCFullYear();
  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
  const rand = Math.random().toString(36).slice(2, 8).toUpperCase();
  return `COT-${y}${m}-${rand}`;
}

async function getPriceMap(client = pool) {
  const result = await client.query(`
    SELECT *
    FROM saas_price_catalog
    WHERE is_active = TRUE
    ORDER BY item_type, item_key
  `);

  const map = {};

  for (const row of result.rows) {
    map[`${row.item_type}:${row.item_key}`] = row;
  }

  return { rows: result.rows, map };
}

async function calculateQuote(payload, client = pool) {
  const { map } = await getPriceMap(client);

  const planKey = String(payload.plan_key || 'pyme').trim();
  const standardsCount = Math.max(Number(payload.active_standards_count || 0), 0);
  const modulesCount = Math.max(Number(payload.premium_modules_count || 0), 0);
  const externalLookupQuota = Math.max(Number(payload.external_lookup_quota || 0), 0);
  const discountAmount = Math.max(Number(payload.discount_amount || 0), 0);

  const planPrice = map[`plan_base:${planKey}`] || map['plan_base:pyme'];
  const standardPrice = map['standard:standard_active'];
  const modulePrice = map['module:premium_module'];

  const lines = [];

  if (planPrice) {
    lines.push({
      line_type: 'plan_base',
      line_key: planKey,
      line_name: planPrice.item_name || `Plan ${planKey}`,
      line_description: planPrice.item_description || 'Plan base SaaS',
      quantity: 1,
      unit_price: money(planPrice.unit_price),
      subtotal_amount: money(planPrice.unit_price),
      is_billable: true,
      metadata: { price_catalog_id: planPrice.id },
    });
  }

  if (standardPrice && standardsCount > 0) {
    lines.push({
      line_type: 'standard',
      line_key: 'standard_active',
      line_name: 'Normas ISO activas',
      line_description: 'Cargo mensual referencial por normas ISO contratadas',
      quantity: standardsCount,
      unit_price: money(standardPrice.unit_price),
      subtotal_amount: money(standardsCount * Number(standardPrice.unit_price || 0)),
      is_billable: true,
      metadata: { price_catalog_id: standardPrice.id },
    });
  }

  if (modulePrice && modulesCount > 0) {
    lines.push({
      line_type: 'module',
      line_key: 'premium_module',
      line_name: 'Módulos premium',
      line_description: 'Cargo mensual referencial por módulos adicionales',
      quantity: modulesCount,
      unit_price: money(modulePrice.unit_price),
      subtotal_amount: money(modulesCount * Number(modulePrice.unit_price || 0)),
      is_billable: true,
      metadata: { price_catalog_id: modulePrice.id },
    });
  }

  lines.push({
    line_type: 'quota_info',
    line_key: 'external_lookup_quota',
    line_name: 'Cuota IA / respaldo externo incluida',
    line_description: 'Línea informativa. La cuota incluida no se cobra como adicional.',
    quantity: externalLookupQuota,
    unit_price: 0,
    subtotal_amount: 0,
    is_billable: false,
    metadata: { quota: externalLookupQuota },
  });

  const subtotal = money(
    lines.reduce((acc, line) => acc + (line.is_billable ? Number(line.subtotal_amount || 0) : 0), 0)
  );

  const total = Math.max(subtotal - discountAmount, 0);

  return {
    currency: 'CLP',
    plan_key: planKey,
    active_standards_count: standardsCount,
    premium_modules_count: modulesCount,
    external_lookup_quota: externalLookupQuota,
    subtotal_amount: subtotal,
    discount_amount: money(discountAmount),
    tax_amount: 0,
    total_monthly_amount: money(total),
    lines,
  };
}

// =====================================================
// GET /api/quotes/prices
// =====================================================
router.get('/prices', auth, async (req, res) => {
  try {
    if (!canUseQuotes(req)) {
      return res.status(403).json({ ok: false, error: 'No autorizado' });
    }

    const { rows } = await getPriceMap();

    return res.json({
      ok: true,
      data: rows,
    });
  } catch (error) {
    console.error('ERROR GET QUOTE PRICES:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo precios para cotizador',
      detail: error.message,
    });
  }
});

