// =====================================================
// GET /api/admin-saas/external-lookup/quotas
// Administración de cuotas mensuales de búsqueda externa.
// =====================================================
router.get('/external-lookup/quotas', auth, async (req, res) => {
  try {
    const ctx = await requireAdminSaasView(req, res);
    if (!ctx) return;

    const result = await pool.query(
      `
      WITH default_quota AS (
        SELECT monthly_limit
        FROM ai_core.external_lookup_quotas
        WHERE is_default = TRUE
          AND is_active = TRUE
        LIMIT 1
      ),
      current_usage AS (
        SELECT
          tenant_id,
          used_count,
          last_lookup_at
        FROM ai_core.v_external_lookup_usage_monthly
        WHERE usage_month = date_trunc('month', now())::date
      )
      SELECT
        t.id AS tenant_id,
        t.name AS tenant_name,
        t.rut,
        COALESCE(q.monthly_limit, (SELECT monthly_limit FROM default_quota), 100)::int AS monthly_limit,
        COALESCE(q.is_active, TRUE) AS quota_active,
        q.notes,
        q.metadata,
        COALESCE(u.used_count, 0)::int AS used_count,
        GREATEST(
          COALESCE(q.monthly_limit, (SELECT monthly_limit FROM default_quota), 100)
          - COALESCE(u.used_count, 0),
          0
        )::int AS remaining,
        u.last_lookup_at
      FROM tenants t
      LEFT JOIN ai_core.external_lookup_quotas q
        ON q.tenant_id = t.id
      LEFT JOIN current_usage u
        ON u.tenant_id = t.id
      ORDER BY t.name
      `
    );

    return res.json({
      ok: true,
      data: result.rows,
    });
  } catch (error) {
    console.error('ERROR GET EXTERNAL LOOKUP QUOTAS:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo cuotas de búsqueda externa',
      detail: error.message,
    });
  }
});

// =====================================================
// PUT /api/admin-saas/tenants/:tenant_id/external-lookup/quota
// Actualiza cuota mensual de búsqueda externa por tenant.
// Versión blindada: confirma persistencia real luego del COMMIT.
// =====================================================
router.put('/tenants/:tenant_id/external-lookup/quota', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { tenant_id } = req.params;
    const monthlyLimit = Number(req.body?.monthly_limit);
    const quotaActive =
      req.body?.quota_active === undefined ? true : Boolean(req.body.quota_active);
    const notes = req.body?.notes || null;
    const metadata = req.body?.metadata && typeof req.body.metadata === 'object'
      ? req.body.metadata
      : {};

    if (!Number.isFinite(monthlyLimit) || monthlyLimit < 0 || monthlyLimit > 100000) {
      return res.status(400).json({
        ok: false,
        error: 'monthly_limit debe ser un número entre 0 y 100000',
      });
    }

    const cleanLimit = Math.floor(monthlyLimit);

    await client.query('BEGIN');

    const tenantExists = await client.query(
      `SELECT id, name FROM tenants WHERE id = $1::uuid LIMIT 1`,
      [tenant_id]
    );

    if (tenantExists.rowCount === 0) {
      await client.query('ROLLBACK');
      return res.status(404).json({
        ok: false,
        error: 'Tenant no encontrado',
      });
    }

    const oldQuotaResult = await client.query(
      `
      SELECT *
      FROM ai_core.external_lookup_quotas
      WHERE tenant_id = $1::uuid
      LIMIT 1
      `,
      [tenant_id]
    );

    const oldQuota = oldQuotaResult.rows[0] || null;

    const writeResult = await client.query(
      `
      INSERT INTO ai_core.external_lookup_quotas (
        tenant_id,
        monthly_limit,
        is_default,
        is_active,
        notes,
        metadata,
        updated_at
      )
      VALUES (
        $1::uuid,
        $2::int,
        FALSE,
        $3::boolean,
        $4::text,
        $5::jsonb,
        now()
      )
      ON CONFLICT (tenant_id) WHERE tenant_id IS NOT NULL
      DO UPDATE SET
        monthly_limit = EXCLUDED.monthly_limit,
        is_active = EXCLUDED.is_active,
        notes = EXCLUDED.notes,
        metadata = EXCLUDED.metadata,
        updated_at = now()
      RETURNING *
      `,
      [
        tenant_id,
        cleanLimit,
        quotaActive,
        notes,
        JSON.stringify({
          ...metadata,
          updated_by: ctx.user.id,
          updated_from: 'admin_saas',
        }),
      ]
    );

    await client.query('COMMIT');

    const verifyResult = await pool.query(
      `
      SELECT *
      FROM ai_core.external_lookup_quotas
      WHERE tenant_id = $1::uuid
      LIMIT 1
      `,
      [tenant_id]
    );

    const verified = verifyResult.rows[0] || null;

    if (!verified || Number(verified.monthly_limit) !== cleanLimit) {
      console.error('QUOTA PERSISTENCE MISMATCH:', {
        tenant_id,
        expected: cleanLimit,
        write_returned: writeResult.rows[0],
        verified,
      });

      return res.status(500).json({
        ok: false,
        error: 'La cuota fue actualizada por el endpoint, pero no se confirmó persistencia real en BD',
        detail: 'quota_persistence_mismatch',
        expected_monthly_limit: cleanLimit,
        verified_monthly_limit: verified?.monthly_limit ?? null,
      });
    }

    return res.json({
      ok: true,
      data: verified,
      audit: {
        old_monthly_limit: oldQuota?.monthly_limit ?? null,
        new_monthly_limit: verified.monthly_limit,
        old_is_active: oldQuota?.is_active ?? null,
        new_is_active: verified.is_active,
      },
    });
  } catch (error) {
    try {
      await client.query('ROLLBACK');
    } catch {}

    console.error('ERROR UPDATE EXTERNAL LOOKUP QUOTA:', error);

    return res.status(500).json({
      ok: false,
      error: 'Error actualizando cuota de búsqueda externa',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});

