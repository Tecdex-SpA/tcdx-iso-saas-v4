// =====================================================
// GET /api/admin-saas/tenants/:tenant_id/prebilling/current
// Obtiene prefactura mensual del tenant.
// =====================================================
router.get('/tenants/:tenant_id/prebilling/current', auth, async (req, res) => {
  try {
    const ctx = await requireAdminSaasView(req, res);
    if (!ctx) return;

    const { tenant_id } = req.params;
    const billingMonth = normalizeBillingMonth(req.query.month);

    const allowed = await ensureTenantVisibility(ctx, tenant_id);
    if (!allowed) {
      return res.status(403).json({
        ok: false,
        error: 'No autorizado para ver prefacturación de esta empresa',
      });
    }

    const prebillingResult = await pool.query(
      `
      SELECT *
      FROM saas_monthly_prebilling
      WHERE tenant_id = $1::uuid
        AND billing_month = $2::date
      LIMIT 1
      `,
      [tenant_id, billingMonth]
    );

    const contextResult = await pool.query(
      `
      SELECT *
      FROM v_saas_prebilling_tenant_context
      WHERE tenant_id = $1::uuid
      LIMIT 1
      `,
      [tenant_id]
    );

    const prebilling = prebillingResult.rows[0] || null;

    let lines = [];

    if (prebilling) {
      const linesResult = await pool.query(
        `
        SELECT *
        FROM saas_monthly_prebilling_lines
        WHERE prebilling_id = $1::uuid
        ORDER BY created_at
        `,
        [prebilling.id]
      );

      lines = linesResult.rows;
    }

    return res.json({
      ok: true,
      data: {
        billing_month: billingMonth,
        prebilling,
        lines,
        context: contextResult.rows[0] || null,
      },
    });
  } catch (error) {
    console.error('ERROR GET CURRENT PREBILLING:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo prefacturación mensual',
      detail: error.message,
    });
  }
});

// =====================================================
// POST /api/admin-saas/tenants/:tenant_id/prebilling/recalculate
// Recalcula prefactura mensual del tenant.
// =====================================================
router.post('/tenants/:tenant_id/prebilling/recalculate', auth, async (req, res) => {
  const client = await pool.connect();

  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { tenant_id } = req.params;
    const billingMonth = normalizeBillingMonth(req.body?.month || req.query.month);

    await client.query('BEGIN');

    const result = await recalculateTenantPrebilling(
      client,
      tenant_id,
      billingMonth,
      ctx.user.id
    );

    await client.query('COMMIT');

    return res.json({
      ok: true,
      data: {
        billing_month: billingMonth,
        ...result,
      },
    });
  } catch (error) {
    try {
      await client.query('ROLLBACK');
    } catch {}

    console.error('ERROR RECALCULATE PREBILLING:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error recalculando prefacturación mensual',
      detail: error.message,
    });
  } finally {
    client.release();
  }
});

// =====================================================
// PUT /api/admin-saas/prebilling/:prebilling_id/status
// Cambia estado de prefactura.
// =====================================================
router.put('/prebilling/:prebilling_id/status', auth, async (req, res) => {
  try {
    const ctx = await requireAdminSaasManage(req, res);
    if (!ctx) return;

    const { prebilling_id } = req.params;
    const status = String(req.body?.status || '').trim();

    const allowedStatuses = ['draft', 'reviewed', 'crm_ready', 'exported', 'cancelled'];

    if (!allowedStatuses.includes(status)) {
      return res.status(400).json({
        ok: false,
        error: `Estado inválido. Estados permitidos: ${allowedStatuses.join(', ')}`,
      });
    }

    const result = await pool.query(
      `
      UPDATE saas_monthly_prebilling
      SET
        status = $2::text,
        reviewed_by_user_id = CASE
          WHEN $2::text IN ('reviewed', 'crm_ready') THEN $3::uuid
          ELSE reviewed_by_user_id
        END,
        reviewed_at = CASE
          WHEN $2::text IN ('reviewed', 'crm_ready') THEN now()
          ELSE reviewed_at
        END,
        updated_at = now()
      WHERE id = $1::uuid
      RETURNING *
      `,
      [prebilling_id, status, ctx.user.id]
    );

    if (result.rowCount === 0) {
      return res.status(404).json({
        ok: false,
        error: 'Prefactura no encontrada',
      });
    }

    return res.json({
      ok: true,
      data: result.rows[0],
    });
  } catch (error) {
    console.error('ERROR UPDATE PREBILLING STATUS:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error actualizando estado de prefactura',
      detail: error.message,
    });
  }
});



