router.get('/overview', auth, async (req, res) => {
  try {
    const ctx = await requireAdminSaasView(req, res, { allowDealer: true });
    if (!ctx) return;

    const [summaryResult, contractsResult, modulesResult, standardsResult] =
      await Promise.all([
        pool.query(
          `
          SELECT *
          FROM v_admin_saas_summary
          LIMIT 1
          `
        ),
        pool.query(
          `
          SELECT *
          FROM v_tenant_contract_overview
          ORDER BY tenant_name
          `
        ),
        pool.query(
          `
          SELECT *
          FROM v_tenant_modules
          ORDER BY tenant_name, sort_order, module_key
          `
        ),
        pool.query(
          `
          SELECT
            ts.tenant_id,
            t.name AS tenant_name,
            ts.standard_code AS code,
            COALESCE(s.name, ts.standard_code) AS name,
            TRUE AS is_active,
            COUNT(DISTINCT tc.id)::int AS tenant_controls,
            COUNT(DISTINCT chs.id)::int AS health_records
          FROM tenant_standards ts
          JOIN tenants t
            ON t.id = ts.tenant_id
          LEFT JOIN standards s
            ON s.code = ts.standard_code
          LEFT JOIN controls_catalog cc
            ON cc.iso = ts.standard_code
           
          LEFT JOIN tenant_controls tc
            ON tc.tenant_id = ts.tenant_id
           AND tc.control_id = cc.id
          LEFT JOIN control_health_scores chs
            ON chs.tenant_id = ts.tenant_id
           AND chs.standard_code = ts.standard_code
          GROUP BY
            ts.tenant_id,
            t.name,
            ts.standard_code,
            s.name,
            ts.standard_code
          ORDER BY t.name, ts.standard_code
          `
        ),
      ]);

    return res.json({
      ok: true,
      scope: {
        user_id: ctx.user.id,
        role: ctx.role,
        is_platform: ctx.isPlatform,
        is_dealer: ctx.isDealer,
      },
      summary: summaryResult.rows[0] || null,
      contracts: contractsResult.rows,
      modules: modulesResult.rows,
      standards: standardsResult.rows,
    });
  } catch (error) {
    console.error('ERROR GET ADMIN SAAS OVERVIEW:', error);
    return res.status(500).json({
      ok: false,
      error: 'Error obteniendo overview de Administración SaaS',
      detail: error.message,
    });
  }
});

