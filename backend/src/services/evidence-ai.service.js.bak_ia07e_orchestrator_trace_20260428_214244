async function callOwnAi(payload) {
  if (typeof fetch !== 'function') {
    throw new Error('fetch no disponible en esta versión de Node');
  }

  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), OWN_AI_TIMEOUT_MS);

  try {
    const headers = {
      'Content-Type': 'application/json'
    };

    if (OWN_AI_SHARED_SECRET) {
      headers['x-internal-token'] = OWN_AI_SHARED_SECRET;
    }

    const response = await fetch(
      `${OWN_AI_BASE_URL}${OWN_AI_EVIDENCE_PROCESS_ENDPOINT}`,
      {
        method: 'POST',
        headers,
        body: safeJsonStringify(payload),
        signal: controller.signal
      }
    );

    const contentType = String(response.headers.get('content-type') || '').toLowerCase();
    const body = contentType.includes('application/json')
      ? deepSanitize(await response.json())
      : { raw_text: stripNullBytes(await response.text()) };

    if (!response.ok) {
      throw new Error(
        stripNullBytes(
          body?.error ||
          body?.detail ||
          `IA ${response.status} ${response.statusText}`
        )
      );
    }

    return deepSanitize(body);
  } catch (err) {
    if (err?.name === 'AbortError') {
      throw new Error('Timeout consultando la IA propia');
    }
    throw new Error(stripNullBytes(err?.message || 'Error consultando la IA propia'));
  } finally {
    clearTimeout(timeout);
  }
}

async function persistCurrentExtraction(client, context, extraction) {
  const data = deepSanitize(safeObject(extraction));
  const rawText = normalizeText(data.raw_text);
  const structuredJson = deepSanitize(safeObject(data.structured_json));
  const extractionNotes = nullableText(data.extraction_notes);

  await client.query(
    `
    UPDATE evidence_document_extracts
    SET is_current = FALSE
    WHERE evidence_id = $1
      AND is_current = TRUE
    `,
    [context.id]
  );

  const insert = await client.query(
    `
    INSERT INTO evidence_document_extracts (
      tenant_id,
      evidence_id,
      is_current,
      extraction_status,
      extraction_engine,
      file_type,
      mime_type,
      raw_text,
      structured_json,
      text_char_count,
      ocr_used,
      detected_language,
      page_count,
      sheet_count,
      image_count,
      extraction_notes,
      started_at,
      extracted_at
    )
    VALUES (
      $1,$2,TRUE,$3,$4,$5,$6,$7,$8::jsonb,$9,$10,$11,$12,$13,$14,$15,NOW(),NOW()
    )
    RETURNING *
    `,
    [
      context.tenant_id,
      context.id,
      nullableText(data.extraction_status) || 'completed',
      nullableText(data.extraction_engine) || 'own_ai_140',
      nullableText(data.file_type) || (context.file_name ? context.file_name.split('.').pop() : null),
      nullableText(data.mime_type) || context.file_mime_type || null,
      rawText || null,
      safeJsonStringify(structuredJson),
      rawText.length,
      Boolean(data.ocr_used),
      nullableText(data.detected_language),
      data.page_count || null,
      data.sheet_count || null,
      data.image_count || null,
      extractionNotes
    ]
  );

  await client.query(
    `
    UPDATE evidences
    SET
      document_extraction_status = $2,
      last_extracted_at = NOW(),
      ai_last_error = NULL,
      file_mime_type = COALESCE($3, file_mime_type)
    WHERE id = $1
    `,
    [
      context.id,
      nullableText(data.extraction_status) || 'completed',
      nullableText(data.mime_type) || context.file_mime_type || null
    ]
  );

  return insert.rows[0];
}


function extractEvidenceAiTraceFromAssessmentData(data, context = {}) {
  const orchestration = safeObject(
    data.ai_orchestration_json ||
      data.enhanced_orchestration ||
      data.orchestration ||
      {}
  );

  const enhancedAnswer = safeObject(
    data.ai_enhanced_answer_json ||
      data.enhanced_answer ||
      data.answer ||
      {}
  );

  const traceId =
    data.ai_trace_id ||
    data.trace_id ||
    orchestration?.trace?.id ||
    enhancedAnswer?.trace_id ||
    null;

  const sourceLevel =
    data.ai_source_level ||
    enhancedAnswer?.source_level ||
    orchestration?.source_level ||
    null;

  const sourceLabel =
    data.ai_source_label ||
    enhancedAnswer?.source_label ||
    orchestration?.source_label ||
    null;

  const confidence =
    data.ai_confidence ||
    enhancedAnswer?.confidence ||
    orchestration?.confidence ||
    null;

  const confidenceScore =
    data.ai_confidence_score ||
    enhancedAnswer?.confidence_score ||
    orchestration?.confidence_score ||
    null;

  return {
    traceId: traceId || null,
    sourceLevel: sourceLevel || null,
    sourceLabel: sourceLabel || null,
    confidence: confidence ? String(confidence) : null,
    confidenceScore:
      confidenceScore === null || confidenceScore === undefined || confidenceScore === ''
        ? null
        : Number(confidenceScore),
    orchestrationJson: orchestration || {},
    enhancedAnswerJson: enhancedAnswer || {}
  };
}


