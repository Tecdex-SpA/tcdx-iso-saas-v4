      ai.validity_result AS current_validity_result,
      ai.contribution_level AS current_contribution_level,
      ai.pertinence_score AS current_pertinence_score,
      ai.sufficiency_score AS current_sufficiency_score,
      ai.freshness_score AS current_freshness_score,
