function resolveLocalUploadPath(context) {
  if (!context.file_path) return null;
  return path.resolve(process.cwd(), 'uploads', context.file_path);
}

function loadInlineFilePayload(context) {
  const uploadPath = resolveLocalUploadPath(context);
  if (!uploadPath) {
    return {
      has_inline_file: false,
      local_path: null,
      inline_bytes: 0,
      inline_reason: 'no_file_path'
    };
  }

  try {
    if (!fs.existsSync(uploadPath)) {
      return {
        has_inline_file: false,
        local_path: uploadPath,
        inline_bytes: 0,
        inline_reason: 'file_not_found'
      };
    }

    const stat = fs.statSync(uploadPath);
    if (!stat.isFile()) {
      return {
        has_inline_file: false,
        local_path: uploadPath,
        inline_bytes: 0,
        inline_reason: 'not_a_file'
      };
    }

    if (stat.size > OWN_AI_INLINE_FILE_MAX_BYTES) {
      return {
        has_inline_file: false,
        local_path: uploadPath,
        inline_bytes: stat.size,
        inline_reason: 'file_too_large'
      };
    }

    const content = fs.readFileSync(uploadPath);
    return {
      has_inline_file: true,
      local_path: uploadPath,
      inline_bytes: stat.size,
      inline_reason: null,
      file_content_base64: content.toString('base64'),
      file_content_encoding: 'base64'
    };
  } catch (err) {
    return {
      has_inline_file: false,
      local_path: uploadPath,
      inline_bytes: 0,
      inline_reason: stripNullBytes(err.message || 'inline_read_failed')
    };
  }
}

