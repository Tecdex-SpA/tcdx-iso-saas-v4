function stripNullBytes(value) {
  return String(value || '').replace(/\u0000/g, '');
}

function deepSanitize(value) {
  if (value === null || value === undefined) return value;

  if (typeof value === 'string') {
    return stripNullBytes(value);
  }

  if (Array.isArray(value)) {
    return value.map((item) => deepSanitize(item));
  }

  if (typeof value === 'object') {
    const output = {};
    for (const [key, val] of Object.entries(value)) {
      output[key] = deepSanitize(val);
    }
    return output;
  }

  return value;
}

function safeJsonStringify(value) {
  return JSON.stringify(deepSanitize(value));
}

function safeObject(value) {
  if (!value) return {};
  if (typeof value === 'object' && !Array.isArray(value)) {
    return deepSanitize(value);
  }
  try {
    const parsed = JSON.parse(stripNullBytes(value));
    return typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)
      ? deepSanitize(parsed)
      : {};
  } catch {
    return {};
  }
}

function safeArray(value) {
  return Array.isArray(value) ? deepSanitize(value) : [];
}

function normalizeText(value) {
  return stripNullBytes(value).trim();
}

function nullableText(value) {
  const cleaned = stripNullBytes(value).trim();
  return cleaned || null;
}

function buildHash(value) {
  return crypto.createHash('sha256').update(stripNullBytes(value)).digest('hex');
}

function splitTextIntoChunks(text, chunkSize = 1200) {
  const normalized = normalizeText(text);
  if (!normalized) return [];

  const chunks = [];
  let index = 0;
  let cursor = 0;

  while (cursor < normalized.length) {
    const slice = normalized.slice(cursor, cursor + chunkSize);
    chunks.push({
      chunk_index: index,
      chunk_type: 'text',
      content: slice
    });
    index += 1;
    cursor += chunkSize;
  }

  return chunks;
}

async function enqueueEvidenceAiJob(
  client,
  tenantId,
  evidenceId,
  jobType,
  payload = {},
  priority = 50,
  createdBy = null
) {
  const result = await client.query(
    `
    SELECT enqueue_evidence_ai_job(
      $1::uuid,
      $2::uuid,
      $3::text,
      $4::jsonb,
      $5::smallint,
      NOW()::timestamp,
      $6::uuid
    ) AS job_id
    `,
    [
      tenantId,
      evidenceId,
      jobType,
      safeJsonStringify(payload || {}),
      Number(priority || 50),
      createdBy || null
    ]
  );

  return result.rows[0]?.job_id || null;
}

