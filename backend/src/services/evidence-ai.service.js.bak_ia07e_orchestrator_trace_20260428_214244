      expires_at: context.expires_at,
      reviewed_at: context.reviewed_at,
      rejection_reason: context.rejection_reason,
      metadata,
      has_inline_file: inlineFile.has_inline_file,
      inline_bytes: inlineFile.inline_bytes,
      inline_reason: inlineFile.inline_reason,
      file_content_base64: inlineFile.file_content_base64 || null,
      file_content_encoding: inlineFile.file_content_encoding || null
    },
    control: {
      catalog_control_id: context.control_id,
      tenant_control_id: context.resolved_tenant_control_id || context.tenant_control_id,
      standard_code: context.iso,
      clause: context.clause,
      category: context.category,
      description: context.control_description,
