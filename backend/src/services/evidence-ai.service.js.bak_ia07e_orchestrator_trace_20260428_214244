      ai_model_name = $3,
      ai_model_version = $4
    WHERE id = $1
    `,
    [
      context.id,
      row.analysis_status,
      row.model_name,
      row.model_version
    ]
  );

  return row;
}

async function replaceKnowledgeChunks(client, context, chunks, assessmentRow) {
  const normalizedChunks = safeArray(chunks).length > 0
    ? safeArray(chunks).map((item, idx) => ({
        chunk_index: Number(item.chunk_index ?? idx),
        chunk_type: normalizeText(item.chunk_type || 'text'),
        content: normalizeText(item.content),
        metadata_json: deepSanitize(safeObject(item.metadata_json || item.metadata))
      })).filter((item) => item.content)
    : splitTextIntoChunks(context.current_extract_raw_text || context.description || '').map((content, idx) => ({
        chunk_index: idx,
        chunk_type: 'text',
        content,
        metadata_json: {}
      }));

  await client.query(
    `
    DELETE FROM evidence_knowledge_chunks
    WHERE evidence_id = $1
    `,
    [context.id]
  );

  for (const chunk of normalizedChunks) {
    const effectiveValidity =
      assessmentRow?.validity_result || context.current_validity_result || '';

    const isApprovedSignal =
      String(context.status || '').toLowerCase() === 'aprobada' &&
      ['valida', 'parcial'].includes(String(effectiveValidity));

    const isNegativeSignal =
      String(context.status || '').toLowerCase() === 'rechazada' ||
      ['debil', 'no_valida'].includes(String(effectiveValidity));

    const cleanContent = normalizeText(chunk.content);

    await client.query(
      `
      INSERT INTO evidence_knowledge_chunks (
        tenant_id,
        evidence_id,
        assessment_id,
        extract_id,
        chunk_index,
        chunk_type,
        content,
        content_hash,
        token_estimate,
        embedding_status,
        metadata_json,
        is_approved_signal,
        is_negative_signal,
        standard_code,
        clause,
        control_id,
        tenant_control_id,
        operation_id
      )
      VALUES (
        $1,$2,$3,$4,$5,$6,$7,$8,$9,'pending',$10::jsonb,$11,$12,$13,$14,$15,$16,$17
      )
      `,
      [
        context.tenant_id,
        context.id,
        assessmentRow?.id || context.current_assessment_id || null,
        context.current_extract_id || null,
        chunk.chunk_index,
        nullableText(chunk.chunk_type) || 'text',
        cleanContent,
        buildHash(cleanContent),
        Math.ceil(cleanContent.length / 4),
        safeJsonStringify(chunk.metadata_json || {}),
        isApprovedSignal,
        isNegativeSignal,
        context.iso || null,
        context.clause || null,
        context.control_id || null,
        context.resolved_tenant_control_id || context.tenant_control_id || null,
        context.operation_id || null
      ]
    );
  }

  return normalizedChunks.length;
}

async function pushLifecycleEvidenceEvent(client, context, assessmentRow, jobType) {
  if (!context.tenant_id || !context.iso || !context.operation_id) return;

  const payload = deepSanitize({
    source: 'evidence-ai.service',
    job_type: jobType,
    evidence_id: context.id,
    evidence_status: context.status,
    validated: Boolean(context.validated),
    standard_code: context.iso,
    clause: context.clause,
    operation_id: context.operation_id,
    operation_name: context.operation_name,
    headline: assessmentRow?.headline || context.current_ai_headline || null,
    narrative: assessmentRow?.narrative || context.current_ai_narrative || null,
    validity_result: assessmentRow?.validity_result || context.current_validity_result || null,
    contribution_level: assessmentRow?.contribution_level || context.current_contribution_level || null,
    compliance_impact_score: Number(
      assessmentRow?.compliance_impact_score || context.current_compliance_impact_score || 0
    )
  });

  await client.query(
    `
    INSERT INTO standard_lifecycle_ai_feed (
      tenant_id,
      standard_code,
      operation_id,
      event_type,
      content_text,
      payload
    )
    VALUES ($1,$2,$3,$4,$5,$6::jsonb)
    `,
    [
      context.tenant_id,
      context.iso,
      context.operation_id,
      'evidence_ai_processed',
      stripNullBytes(
        `Evidence ${context.id} processed (${jobType}) for ${context.iso} / ${context.operation_name || 'sin operación'}.`
      ),
      safeJsonStringify(payload)
    ]
  );
}

async function markJobCompleted(client, jobId, result = {}) {
  await client.query(
    `
    UPDATE evidence_ai_jobs
    SET
      status = 'completed',
      result = $2::jsonb,
      completed_at = NOW(),
      updated_at = NOW()
    WHERE id = $1
    `,
    [jobId, safeJsonStringify(result || {})]
  );
}

async function markJobFailed(client, job, err) {
  const nextRetry = Number(job.retry_count || 0) + 1;
  const willRetry = nextRetry < Number(job.max_retries || 5);
  const retryMinutes = Math.min(30, Math.max(2, nextRetry * 2));

  await client.query(
    `
    UPDATE evidence_ai_jobs
    SET
      status = $2,
      retry_count = $3,
      error_message = $4,
      run_after = CASE
        WHEN $2 = 'retry' THEN NOW() + ($5 || ' minutes')::interval
        ELSE run_after
      END,
      completed_at = CASE WHEN $2 = 'failed' THEN NOW() ELSE completed_at END,
      updated_at = NOW()
    WHERE id = $1
    `,
    [
      job.id,
      willRetry ? 'retry' : 'failed',
      nextRetry,
      stripNullBytes(err?.message || 'unknown error'),
      String(retryMinutes)
    ]
  );

  if (job.job_type === 'extract_document') {
    await client.query(
      `
      UPDATE evidences
      SET
        document_extraction_status = 'failed',
        ai_last_error = $2
      WHERE id = $1
      `,
      [job.evidence_id, stripNullBytes(err?.message || 'unknown error')]
    );
  } else {
    await client.query(
      `
      UPDATE evidences
      SET
        ai_analysis_status = 'failed',
        ai_last_error = $2
      WHERE id = $1
      `,
      [job.evidence_id, stripNullBytes(err?.message || 'unknown error')]
    );
  }
}

async function claimNextJob(client, workerName) {
  const result = await client.query(
    `
    WITH next_job AS (
      SELECT id
      FROM evidence_ai_jobs
      WHERE status IN ('pending', 'retry')
        AND run_after <= NOW()
      ORDER BY priority DESC, run_after ASC, created_at ASC
      LIMIT 1
      FOR UPDATE SKIP LOCKED
    )
    UPDATE evidence_ai_jobs j
    SET
      status = 'processing',
      locked_at = NOW(),
      locked_by = $1,
      updated_at = NOW()
    FROM next_job
    WHERE j.id = next_job.id
    RETURNING j.*
    `,
    [workerName]
  );

  return result.rowCount > 0 ? result.rows[0] : null;
}

async function processSingleEvidenceAiJob(workerName = 'evidence-ai-worker') {
  const client = await pool.connect();
  let job = null;

  try {
    await client.query('BEGIN');

    job = await claimNextJob(client, workerName);

    if (!job) {
      await client.query('COMMIT');
      return null;
    }

    let context = await resolveEvidenceContext(client, job.evidence_id);

    if (!context) {
      throw new Error(`No existe evidencia ${job.evidence_id}`);
    }

    let extractionRow = null;
    let assessmentRow = null;
    let chunkCount = 0;

    if (job.job_type === 'extract_document') {
      const payload = await buildEvidencePayload(context, job.job_type, safeObject(job.payload));
      const aiResponse = await callOwnAi(payload);

      extractionRow = await persistCurrentExtraction(
        client,
        context,
        safeObject(aiResponse.extraction)
      );

      await enqueueEvidenceAiJob(
        client,
        context.tenant_id,
        context.id,
        'analyze_evidence',
        { source_job_id: job.id, source: 'extract_document' },
        90,
        job.created_by || null
      );

      await markJobCompleted(client, job.id, {
        extraction_id: extractionRow?.id || null,
        assessment_id: null,
        chunk_count: 0,
        own_ai_response_meta: {
          ok: true,
          source: 'own_ai_140'
        }
      });
    } else if (job.job_type === 'analyze_evidence') {
      const payload = await buildEvidencePayload(context, job.job_type, safeObject(job.payload));
      const aiResponse = await callOwnAi(payload);

      if (!context.current_extract_id && safeObject(aiResponse.extraction).extraction_status) {
        extractionRow = await persistCurrentExtraction(
          client,
          context,
          safeObject(aiResponse.extraction)
        );
        context = await resolveEvidenceContext(client, context.id);
      }

      assessmentRow = await persistCurrentAssessment(
        client,
        context,
        safeObject(aiResponse.assessment)
      );

      context = await resolveEvidenceContext(client, context.id);

      await pushLifecycleEvidenceEvent(
        client,
        context,
        assessmentRow,
        job.job_type
      );

      await enqueueEvidenceAiJob(
        client,
        context.tenant_id,
        context.id,
        'build_chunks',
        { source_job_id: job.id, source: 'analyze_evidence' },
        70,
        job.created_by || null
      );

      await markJobCompleted(client, job.id, {
        extraction_id: context.current_extract_id || extractionRow?.id || null,
        assessment_id: assessmentRow?.id || null,
        chunk_count: 0,
        own_ai_response_meta: {
          ok: true,
          source: 'own_ai_140'
        }
      });
    } else if (job.job_type === 'build_chunks') {
      chunkCount = await replaceKnowledgeChunks(
        client,
        context,
        [],
        { id: context.current_assessment_id, validity_result: context.current_validity_result }
      );

      await enqueueEvidenceAiJob(
        client,
        context.tenant_id,
        context.id,
        'push_learning',
        { source_job_id: job.id, source: 'build_chunks' },
        60,
        job.created_by || null
      );

      await markJobCompleted(client, job.id, {
        extraction_id: context.current_extract_id || null,
        assessment_id: context.current_assessment_id || null,
        chunk_count: chunkCount,
        own_ai_response_meta: {
          ok: true,
          source: 'local_chunk_builder'
        }
      });
    } else if (job.job_type === 'push_learning') {
      const countResult = await client.query(
        `
        SELECT COUNT(*)::int AS total
        FROM evidence_knowledge_chunks
        WHERE evidence_id = $1
        `,
        [context.id]
      );

      chunkCount = Number(countResult.rows[0]?.total || 0);

      await markJobCompleted(client, job.id, {
        extraction_id: context.current_extract_id || null,
        assessment_id: context.current_assessment_id || null,
        chunk_count: chunkCount,
        own_ai_response_meta: {
          ok: true,
          source: 'learning_ready'
        }
      });
    } else {
      throw new Error(`job_type no soportado: ${job.job_type}`);
    }

    await client.query('COMMIT');

    return {
      job_id: job.id,
      evidence_id: job.evidence_id,
      job_type: job.job_type,
      extraction_id: extractionRow?.id || null,
      assessment_id: assessmentRow?.id || null,
      chunk_count: chunkCount
    };
  } catch (err) {
    await client.query('ROLLBACK');

    try {
      if (job?.id) {
        const recoveryClient = await pool.connect();
        try {
          await markJobFailed(recoveryClient, job, err);
        } finally {
          recoveryClient.release();
        }
      }
    } catch (recoveryErr) {
      console.error('ERROR RECOVERING FAILED EVIDENCE AI JOB:', stripNullBytes(recoveryErr.message));
    }

    throw err;
  } finally {
    client.release();
  }
}

async function processEvidenceAiJobs(limit = 1, workerName = 'evidence-ai-worker') {
  const processed = [];

  for (let i = 0; i < Number(limit || 1); i += 1) {
    const jobResult = await processSingleEvidenceAiJob(workerName);
    if (!jobResult) break;
    processed.push(jobResult);
  }

  return processed;
}

module.exports = {
  enqueueEvidenceAiJob,
  cancelActiveJobsForEvidence,
  processSingleEvidenceAiJob,
  processEvidenceAiJobs
};
