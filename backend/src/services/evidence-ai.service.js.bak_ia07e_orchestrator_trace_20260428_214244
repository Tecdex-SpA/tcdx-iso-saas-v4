      ext.raw_text AS current_extract_raw_text,
      ext.structured_json AS current_extract_structured_json,
      ext.text_char_count AS current_extract_text_char_count,
      ext.ocr_used AS current_extract_ocr_used,
      ext.detected_language AS current_extract_detected_language,
      ext.page_count AS current_extract_page_count,
      ext.sheet_count AS current_extract_sheet_count,
      ext.image_count AS current_extract_image_count,
      ai.id AS current_assessment_id,
