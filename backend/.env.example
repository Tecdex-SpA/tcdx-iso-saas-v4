NODE_ENV=production

DB_HOST=db.tcdx.int
DB_PORT=5432
DB_USER=tecdex_user
DB_PASSWORD=
DB_NAME=tecdex_saas
DATABASE_URL=

JWT_SECRET=
CORS_ORIGINS=https://181.212.166.187:8443,http://www.tcdx.int:8080,http://192.168.2.33:8080
