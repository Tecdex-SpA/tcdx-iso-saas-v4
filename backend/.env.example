JSON_BODY_LIMIT=2mb
SECURITY_RATE_LIMIT_WINDOW_MS=60000
SECURITY_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_MAX=60
