# Puppeteer bajo systemd no debe usar Chromium Snap (/snap/bin/chromium).
# Instalar Chrome/Chromium no-snap y configurar una ruta compatible:
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
REPORT_PDF_BROWSER_TIMEOUT_MS=120000
REPORT_PDF_PAGE_TIMEOUT_MS=120000

JSON_BODY_LIMIT=2mb
SECURITY_RATE_LIMIT_WINDOW_MS=60000
SECURITY_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_MAX=60
