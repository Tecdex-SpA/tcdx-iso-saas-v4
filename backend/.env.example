# Backend Node.js / Express.
# Ejemplo solamente. No incluir secretos reales.

# Obligatorio.
NODE_ENV=production
PORT=3000

# DB_* es el contrato oficial actual del backend; DATABASE_URL no es consumida
# por backend/src/config/db.js.
DB_HOST=db.internal
DB_PORT=5432
DB_NAME=tecdex_saas
DB_USER=tecdex_app
DB_PASSWORD=replace_with_strong_database_password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Reservada para contrato operativo; el pool actual solo consume DB_POOL_MAX.
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
# Opcionales, recomendadas en pilot/production.
DB_STATEMENT_TIMEOUT_MS=60000
DB_QUERY_TIMEOUT_MS=60000
DB_APPLICATION_NAME=TCDX ISO SAAS backend

# JWT: obligatorias en pilot/production.
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=tecdex-backend
JWT_AUDIENCE=tecdex-saas
JWT_EXPIRES_IN=8h

# Comunicacion entre servicios.
FRONTEND_URL=https://app.example.invalid
FRONTEND_INTERNAL_URL=http://frontend.internal:8080
AI_ENGINE_URL=http://ai-engine.internal:8001
API_PUBLIC_URL=https://api.example.invalid
AI_INTERNAL_TOKEN=replace_with_at_least_24_random_characters

# CORS y limites.
CORS_ORIGINS=https://app.example.invalid
JSON_BODY_LIMIT=2mb
EVIDENCE_UPLOAD_MAX_BYTES=26214400
EVIDENCE_LIBRARY_UPLOAD_MAX_FILE_BYTES=26214400
UPLOADS_DIR=/srv/tecdex/backend/uploads
LOG_LEVEL=info

# Timeouts internos.
AI_ENGINE_TIMEOUT_MS=120000
AI_ENGINE_REQUEST_TIMEOUT_MS=420000
BACKEND_REQUEST_TIMEOUT_MS=660000
BACKEND_HEADERS_TIMEOUT_MS=670000

# Reportes.
REPORT_ASYNC_INTERNAL_BASE_URL=http://127.0.0.1:3000
REPORT_PUBLIC_BASE_URL=https://api.example.invalid
REPORT_TCDX_LOGO_URL=https://app.example.invalid/logo.png
TCDX_LOGO_URL=https://app.example.invalid/logo.png
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
PDF_RENDER_ENGINE=puppeteer
PDF_RENDER_TIMEOUT_MS=300000
PDF_RENDER_FORMAT=A4
PDF_RENDER_PRINT_BACKGROUND=true

# Seguridad/rate limits.
SECURITY_RATE_LIMIT_WINDOW_MS=60000
SECURITY_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_MAX=60
