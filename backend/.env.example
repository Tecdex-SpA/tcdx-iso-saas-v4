# Backend — Node.js / Express
# Copiar a .env solo en la VM/entorno correspondiente. No commitear .env real.

PORT=3000
NODE_ENV=production

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=

JWT_SECRET=
CORS_ORIGINS=
FRONTEND_URL=
FRONTEND_INTERNAL_URL=
