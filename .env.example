# TCDX ISO SaaS — ejemplo de variables globales
# No usar valores secretos reales en este archivo.
# Copiar a .env correspondiente en cada VM/servicio y completar credenciales.

NODE_ENV=production

# VMware / ESXi inicial
API_URL=http://bk.tcdx.int:3000
FRONTEND_URL=https://181.212.166.187:8443
FRONTEND_INTERNAL_URL=http://192.168.2.33:8080
AI_ENGINE_URL=http://ai.tcdx.int:8001
BACKEND_API_URL=http://bk.tcdx.int:3000
DB_HOST=db.tcdx.int
DB_NAME=tecdex_saas
DB_USER=tecdex_user

# Despliegues legacy deben usar overrides explícitos fuera de Git.

# URLs públicas futuras / cloud
# API_URL=https://api.tcdx.cl
# FRONTEND_URL=https://compliance.tcdx.cl
# FRONTEND_INTERNAL_URL=http://127.0.0.1:8080
# AI_ENGINE_URL=http://<ai-engine-private-host>:8001

# Conectores documentales tenant-scoped
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
