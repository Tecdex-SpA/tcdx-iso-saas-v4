# TCDX ISO SaaS - contrato global de despliegue.
# Ejemplo solamente. No incluir secretos reales.

# Obligatorio para scripts/env-check.sh: lab | demo | pilot | production
TCDX_ENV_PROFILE=demo
# Obligatorio: all | backend | frontend | ai-engine
TCDX_ENV_LAYER=all

# URLs globales de despliegue. Obligatorias en pilot/production.
API_PUBLIC_URL=https://api.example.invalid
FRONTEND_URL=https://app.example.invalid
AI_ENGINE_URL=http://ai-engine.internal:8001
BACKEND_API_URL=http://backend.internal:3000

# Integraciones documentales opcionales. Los secretos se configuran fuera de Git.
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_secret
GOOGLE_REDIRECT_URI=https://api.example.invalid/api/document-integrations/google/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email

ZOHO_CLIENT_ID=replace_with_zoho_client_id
ZOHO_CLIENT_SECRET=replace_with_secret
ZOHO_REDIRECT_URI=https://api.example.invalid/api/document-integrations/zoho/callback
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com

DOCUMENT_INTEGRATION_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
AGENT_TOKEN_SIGNING_SECRET=replace_with_at_least_32_random_characters
LOCAL_DOCUMENT_ROOT=/srv/tecdex/documents
