# Frontend Next.js.
# Ejemplo solamente. No incluir secretos reales.

NODE_ENV=production
PORT=8080

# Nombre oficial consumido por frontend/src.
NEXT_PUBLIC_API_URL=https://api.example.invalid
NEXT_PUBLIC_APP_URL=https://app.example.invalid

# Opcionales.
NEXT_PUBLIC_DEFAULT_TENANT_ID=
# Documentada para despliegues; no tiene consumidor runtime actual.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
NEXT_PUBLIC_TCDX_LOGO_URL=/logo.png
NEXT_PUBLIC_TECDX_POWERED_LOGO_URL=/tecdex.png

# Aliases deprecados: no usar en configuraciones nuevas.
# NEXT_PUBLIC_API_BASE_URL reemplazado por NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_BACKEND_URL reemplazado por NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_LOGO_URL reemplazado por NEXT_PUBLIC_TCDX_LOGO_URL.
