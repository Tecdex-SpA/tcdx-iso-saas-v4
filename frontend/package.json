{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3001}",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3001}",
    "check": "next build --webpack",
    "lint": "eslint",
    "test": "node scripts/check-phase1-ui-contract.mjs",
    "lint:audit-preparation": "eslint src/components/auditorias/AuditPreparationPanel.tsx",
    "test:e2e:phase0": "playwright test --config=playwright.config.ts",
    "test:e2e:phase1": "playwright test --config=playwright.phase1.config.ts",
    "test:e2e:phase1:list": "playwright test --config=playwright.phase1.config.ts --list --reporter=line"
  },
  "dependencies": {
    "next": "^16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.10",
    "sharp": "0.35.3"
  }
}
