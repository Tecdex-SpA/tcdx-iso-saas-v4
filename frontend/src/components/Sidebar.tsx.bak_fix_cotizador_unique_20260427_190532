          <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" />
            <line x1="15" y1="9" x2="9" y2="15" />
            <line x1="9" y1="9" x2="15" y2="15" />
          </svg>
        ),
      },
      {
        href: '/auditorias',
        label: 'Auditorías',
        show: hasModule('audits'),
        icon: (
          <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
            <path d="M14 2H6a2 2 0 0 0-2 2v16" />
            <path d="M14 2v6h6" />
            <circle cx="11" cy="13" r="3" />
          </svg>
        ),
      },
      {
        href: '/evidencias',
        label: 'Evidencias',
        show: hasModule('evidences'),
        icon: (
          <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
            <path d="M3 7h5l2 3h11v10H3z" />
          </svg>
        ),
      },
      {
        href: '/hallazgos',
        label: 'Hallazgos',
        show: true,
        icon: (
          <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
            <path d="M4 22V4" />
            <path d="M4 4h12l-2 3 2 3H4" />
          </svg>
        ),
      },
      {
        href: '/ia-compliance',
        label: 'IA Compliance',
        show: !isAuditor && hasModule('ai'),
        icon: (
          <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
            <rect x="8" y="8" width="8" height="8" rx="2" />
            <path d="M12 8V5" />
            <path d="M12 19v-3" />
            <path d="M8 12H5" />
            <path d="M19 12h-3" />
          </svg>
        ),
      },
    ];

    return items.filter((item) => item.show);
  }, [hasModule, isAuditor, showSoA, modulesLoaded]); // eslint-disable-line react-hooks/exhaustive-deps

  const platformItems = [

    {
      href: '/admin-saas',
      label: 'Empresas / Admin SaaS',
      icon: (
        <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
          <path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16" />
          <path d="M16 8h2a2 2 0 0 1 2 2v11" />
          <path d="M3 21h18" />
          <path d="M8 7h2" />
          <path d="M8 11h2" />
          <path d="M8 15h2" />
          <path d="M16 13h1" />
          <path d="M16 17h1" />
          <circle cx="19" cy="5" r="2" />
        </svg>
      ),
    },
    {
      href: '/cotizador',
      label: 'Cotizador',
      icon: (
        <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
          <path d="M6 2h9l5 5v15H6z" />
          <path d="M15 2v5h5" />
          <path d="M9 11h6" />
          <path d="M9 15h6" />
          <path d="M9 19h3" />
          <circle cx="5" cy="6" r="2" />
          <path d="M3.5 7.5L2 9" />
        </svg>
      ),
    },
    {
      href: '/usuarios',
      label: 'Usuarios',
      icon: (
        <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
        </svg>
      ),
    },
    {
      href: '/health',
      label: 'Salud ISO',
      icon: (
        <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" />
          <path d="M3.5 12h4l1.5-3 3 6 2-4h6.5" />
        </svg>
      ),
    },
    {
      href: '/cotizador',
      label: 'Cotizador',
      icon: (
        <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
          <path d="M6 2h9l5 5v15H6z" />
          <path d="M15 2v5h5" />
          <path d="M9 11h6" />
          <path d="M9 15h6" />
          <path d="M9 19h3" />
          <circle cx="5" cy="6" r="2" />
          <path d="M3.5 7.5L2 9" />
        </svg>
      ),
    },
    {
      href: '/exportes',
      label: 'Reportes',
      icon: (
        <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
          <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
          <path d="M14 3v6h6" />
          <path d="M8 13h8" />
          <path d="M8 17h8" />
          <path d="M8 9h3" />
        </svg>
      ),
    },
  ];

  const dealerItems = [
    {
      href: '/dealer',
      label: 'Portal Dealer',
      icon: (
        <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
          <path d="M3 21h18" />
          <path d="M5 21V7l7-4 7 4v14" />
          <path d="M9 21v-7h6v7" />
          <circle cx="18" cy="5" r="2" />
        </svg>
      ),
    },
    {
      href: '/exportes',
      label: 'Reportes',
      icon: (
        <svg className={iconClass} fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24">
          <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
          <path d="M14 3v6h6" />
          <path d="M8 13h8" />
          <path d="M8 17h8" />
          <path d="M8 9h3" />
        </svg>
      ),
    },
  ];

  const sectionLabel = (label: string) => {
    if (collapsed) return null;

    return (
      <div className="px-3 pt-3 pb-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-white/40">
        {label}
      </div>
    );
  };

  return (
    <aside
      className={[
        'relative flex h-screen flex-col border-r border-white/10 bg-[linear-gradient(180deg,#243447_0%,#1f2f40_58%,#1b2733_100%)] text-white shadow-2xl transition-all duration-300',
