        {!isPlatformAdmin && !isDealer && (
          <>
            {sectionLabel('General')}
            <div className="space-y-2">
              {generalItems.map((item) => (
                <NavItem
                  key={item.href}
                  href={item.href}
                  label={item.label}
                  collapsed={collapsed}
                  active={isActive(item.href)}
                  icon={item.icon}
