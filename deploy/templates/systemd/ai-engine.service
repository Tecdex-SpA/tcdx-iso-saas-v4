[Unit]
Description=TCDX AI Engine FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tecdex
Group=tecdex
WorkingDirectory=/home/tecdex/ai-engine
EnvironmentFile=-/home/tecdex/ai-engine/.env
Environment=AI_ENGINE_HOST=0.0.0.0
Environment=AI_ENGINE_PORT=8000
ExecStart=/home/tecdex/ai-engine/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
