+  {
+    name: 'MD03',
+    rows: { findings: [{ id: uuid('md03'), tenantControlId: legacyA }], actionPlans: [{ id: uuid('md03:ap'), tenantControlId: tcB1 }] },
+    decisions: [decision('findings', uuid('md03'), tcA1), decision('findings', uuid('md03'), tcA1)],
+    expectFailure: true,
