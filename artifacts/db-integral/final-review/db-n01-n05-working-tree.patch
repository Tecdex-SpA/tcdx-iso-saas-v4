+CREATE TABLE IF NOT EXISTS legal_obligations (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  regulation_id uuid NOT NULL REFERENCES regulations(id) ON DELETE CASCADE,
