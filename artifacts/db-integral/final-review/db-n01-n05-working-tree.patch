+function main() {
+  let pg;
+  try {
+    pg = createPostgres();
+    const version = psqlExec(pg, 'SHOW server_version;').stdout.trim();
+    const results = scenarios.map((scenario) => runScenario(pg, scenario));
+    const rerun = runRerunScenario(pg);
+    results.push(rerun);
