+    rows: { evidences: [{ id: uuid('e02'), controlId: legacyB }], actionPlans: [{ id: uuid('e02:ap'), tenantControlId: tcB1 }] },
+    verifySql: `SELECT tenant_control_id FROM evidences WHERE id = ${sqlLiteral(uuid('e02'))};`,
