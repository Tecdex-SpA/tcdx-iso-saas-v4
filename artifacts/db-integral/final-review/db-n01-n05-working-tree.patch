+    measurement_id: measurement.measurement.id,
+    timezone: 'UTC',
+  }, requestId);
+  const published = await indicators.publishSnapshot(scope, snapshot.snapshot.snapshot_id, requestId);
+  return { metricCode, measurement, snapshot, published };
