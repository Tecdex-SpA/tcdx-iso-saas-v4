+    );
+    assertSql(
+      pg,
+      'H09',
+      `SELECT dbn02_normalize_health_component_state('calculated', true, '2026-07-01'::timestamptz, interval '30 days', '2026-09-02'::timestamptz);`,
+      'STALE',
+    );
+    assertSql(
+      pg,
