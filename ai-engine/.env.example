# AI Engine FastAPI.
# Ejemplo solamente. No incluir secretos reales.

# APP_PORT es el nombre oficial consumido por app/core/config.py.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8001
APP_NAME=AI Compliance Engine

BACKEND_API_URL=http://backend.internal:3000
FRONTEND_URL=http://localhost:3001
AI_INTERNAL_TOKEN=replace_with_at_least_24_random_characters

# DB_* es el contrato oficial actual del AI Engine.
DB_HOST=db.internal
DB_PORT=5432
DB_NAME=tecdex_saas
DB_USER=tecdex_ai
DB_PASSWORD=replace_with_strong_database_password

# LLM_PROVIDER es el nombre oficial. Valores soportados incluyen ollama y openai.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
OPENAI_API_KEY=replace_only_when_llm_provider_is_openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Busqueda web opcional. BRAVE_SEARCH_API_KEY es el nombre oficial.
BRAVE_SEARCH_API_KEY=replace_only_when_web_search_is_enabled
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
ENABLE_WEB_CONTEXT=false

LOG_LEVEL=info
AI_ENGINE_PUBLIC_DOCS=false
AI_ENGINE_LLM_TIMEOUT_MS=420000
AI_ENGINE_DEEP_LLM_TIMEOUT_MS=600000
OLLAMA_TIMEOUT_MS=420000

# Aliases deprecados: no usar en configuraciones nuevas.
# AI_ENGINE_PORT reemplazado por APP_PORT.
# BRAVE_API_KEY reemplazado por BRAVE_SEARCH_API_KEY.
# AI_PROVIDER y MODEL_PROVIDER reemplazados por LLM_PROVIDER.
