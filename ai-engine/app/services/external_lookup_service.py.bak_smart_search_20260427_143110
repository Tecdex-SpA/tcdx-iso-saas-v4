    result_summary: str,
    response_used: bool,
    quality_score: Optional[float],
    metadata: Dict[str, Any],
) -> Optional[str]:
    sql = """
      INSERT INTO ai_core.external_lookup_logs (
        tenant_id,
        standard_code,
        domain_code,
        problem_type_code,
        scenario_code,
        query_text,
        lookup_reason,
        sources_requested,
        sources_used,
        result_summary,
        response_used,
